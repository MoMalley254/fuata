<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #29. Widget metadata. minWidth/minHeight are the pre-Android-12
     sizing model; targetCellWidth/Height are the modern one. Both are
     set so the widget sizes predictably from API 26 up. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/fuata_widget"
    android:previewLayout="@layout/fuata_widget"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />