<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #25 (US-16, ADR-009): nothing is copied off the phone by Android.
     Applies to Android 12+ (targetSdk 31+). Older versions are covered by
     android:allowBackup="false" in the manifest. The person's own
     Back up & restore file (#24) is the only way data moves. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>