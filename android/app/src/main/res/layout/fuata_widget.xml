<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #29. RemoteViews only understands a small, fixed set of views,
     so this is deliberately LinearLayout + TextView + ProgressBar: no
     Material components, nothing that needs a custom helper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            tools:text="🟢" />

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp"
            tools:text="left today" />

        <!-- Issue #153 follow-up 6.2. Rich widgets: a labelled pill.
             Visible height 32dp, tap target 44dp+ via the vertical padding
             (the header row is tight, so the extra sits inside the view).
             Compact widgets: icon only, below. The provider shows one. -->
        <TextView
            android:id="@+id/widget_paste_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-8dp"
            android:layout_marginBottom="-8dp"
            android:background="@drawable/widget_paste_pill"
            android:contentDescription="Paste a payment message into Fuata"
            android:drawableStart="@drawable/ic_widget_paste_on_accent"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="Paste message"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 48dp tap target; the outlined circle is inset so it still looks
             32dp. Negative vertical margins keep the header row's height. -->
        <ImageView
            android:id="@+id/widget_paste"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="-12dp"
            android:background="@drawable/widget_paste_button"
            android:contentDescription="Paste a payment message into Fuata"
            android:padding="14dp"
            android:src="@drawable/ic_widget_paste" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="16sp"
            tools:text="KSh" />

        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="1,500" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressTint="@color/widget_accent" />

    <TextView
        android:id="@+id/widget_split_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        tools:text="Cash 760 · Mobile 3,450" />
</LinearLayout>