<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #153: outlined circle behind the compact paste icon. Inset so the
     drawn circle is 32dp inside the 48dp tap target. Stroke uses the accent,
     not the grey caption colour, so it no longer reads as decoration. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp"
    android:insetTop="8dp"
    android:insetRight="8dp"
    android:insetBottom="8dp">
    <shape android:shape="oval">
        <stroke
            android:width="1.5dp"
            android:color="@color/widget_accent" />
    </shape>
</inset>
