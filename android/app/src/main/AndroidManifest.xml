<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Issue #16: Android 13+ needs explicit permission to post the
         ongoing banner. Requested at first post (see BannerPlatform's
         _requestPermissionOnce), never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Issue #25 (US-16, ADR-009): Fuata never touches the network. The
         release build must not hold INTERNET, so strip it (and the
         connectivity-state permissions) if any plugin's manifest ever
         merges it in. Debug and profile builds add INTERNET back from
         their own manifests, which outrank this file, so hot reload
         still works. Verified on the built APK by
         scripts/verify-privacy.sh. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove"/>

    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Issue #28: minSdk is 26, so API 26-27 need the legacy permission.
     USE_BIOMETRIC (above) only covers API 28+. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27"/>

    <!-- Issue #31: reschedules the summary notifications after a reboot.
     Without this, the scheduled alarm is lost and the person only
     gets the notification again once they next open Fuata. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Issue #25: no Android auto-backup to Google Drive and no
         device-to-device transfer of the database. allowBackup covers
         Android 11 and below; dataExtractionRules covers 12+, where it
         takes over from allowBackup for transfers. The only way data
         leaves the phone is the person's own Back up & restore file. -->
    <application
        android:label="fuata"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Issue #21 share target: appear in other apps' "Share" sheets
                 for plain text, with no permission required (US-09).
                 MainActivity forwards the text to Dart over the
                 fuata/share_intake channel. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Issue #22: notification listener. Only apps on the person's
             allow-list are ever read (US-10); everything else is dropped
             in NotificationListener.kt before any text is touched.
             Requires the user to grant special access in
             Settings > Notification access; the Auto-catch screen opens
             that page directly. -->
        <service
            android:name=".NotificationListener"
            android:label="Fuata"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Issue #29: the home-screen widget. A plain AppWidgetProvider
     receiver; it reads only the cached snapshot HomeWidgetChannel
     writes (see WidgetDataStore.kt) and never touches drift. -->
        <receiver
            android:name=".FuataWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fuata_widget_info" />
        </receiver>

        <!-- Issue #31: flutter_local_notifications' boot receiver. It
     re-arms every scheduled notification after the phone reboots.
     The plugin's own manifest may already merge one of these in;
     the merger unions the intent filters, so a duplicate is
     harmless. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Issue #22: lets the Auto-catch picker list launchable apps on
             Android 11+ without QUERY_ALL_PACKAGES. Fuata never sees
             non-launchable apps and never asks for the broad permission. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>