<file path="lib/domain/models/template.dart">
/// design.md TEMPLATE / ADR-007: the user pastes a sample message and
/// labels spans of it (amount, code, date, person, balance, fee); the app
/// turns that into a regex with one named group per labeled field. This
/// file is the template model plus the generator; matching a message
/// against a list of templates is `Parser` (logic/parser.dart).
library;

/// The kinds of field a user can label a span as (US-08). `ignore` isn't
/// listed in requirements.md's label set but is kept internal-only, not
/// exposed here, since v0.1's rule builder only offers the six above.
enum TemplateFieldType {
  amount,
  code,
  date,
  person,
  balance,
  fee,
  custom,
  wildcard,
}

/// `direction` on a Template: which way the transaction goes. `either`
/// lets the message decide at parse time (ui-design-brief.md 7.7 step 4)
/// — see `Parser._resolveType`.
enum TemplateDirection { spent, got, either }

/// One labeled span over `sampleText`, as produced by the rule builder UI
/// (#20). `end` is exclusive. The factory that consumes these assumes
/// they're already non-overlapping — the rule builder enforces that by
/// construction (tap-to-label chips can't cover the same character twice).
class LabeledSpan {
  final int start;
  final int end;
  final TemplateFieldType type;

  /// #56 Human-readable name for a [TemplateFieldType.custom] label.
  /// Required when [type] is custom; null for built-in fields.
  final String? customName;

  const LabeledSpan({
    required this.start,
    required this.end,
    required this.type,
    this.customName,
  });
}

/// design.md TEMPLATE. `pattern` is a regex source string with one named
/// group per labeled field (`(?<amount>...)`, and `(?<amount2>...)` etc.
/// if a field type repeats, e.g. amount + fee are both money but distinct
/// groups); `fieldMap` maps each group name back to its [TemplateFieldType]
/// — this is tables.dart's `fieldMapJson` column, decoded.
class CaptureTemplate {
  final String id;
  final String unitId;
  final String? captureSourceId;
  final String name;
  final TemplateDirection direction;
  final String pattern;
  final Map<String, TemplateFieldType> fieldMap;
  final String sampleText;
  final int version;
  final bool enabled;

  ///#56
  final Map<String, String> customFieldNames; // group name -> display name

  const CaptureTemplate({
    required this.id,
    required this.unitId,
    required this.name,
    required this.direction,
    required this.pattern,
    required this.fieldMap,
    required this.sampleText,
    this.captureSourceId,
    this.version = 1,
    this.enabled = true,
    this.customFieldNames = const {},
  });

  /// Compiled on demand rather than cached, since a Template is an
  /// immutable value object handed around freely (Parser compiles it once
  /// per parse attempt); `dotAll` so literal `.` in older saved patterns
  /// still spans line breaks.
  RegExp get compiled => RegExp(pattern, dotAll: true);

  /// #72: true when this rule's pattern matches the very sample it was
  /// built from. A label that covers text its field pattern can't match
  /// (the old `Ref:AC123` code bug) makes this false, and the rule
  /// builder uses it to stop the person saving a rule that can never fire.
  bool get readsOwnSample => compiled.hasMatch(sampleText);

  /// ADR-007: builds a regex from a pasted sample plus the spans the user
  /// labeled over it. Literal text between, before and after the labels is
  /// regex-escaped, so punctuation in the sample (".", "(", "+", "$", ...)
  /// is matched literally rather than as regex syntax (testing.md P-04).
  /// Different names/numbers/amounts in a *future* message still match,
  /// because only the labeled spans became capture groups — everything
  /// else in the sample is now fixed literal text (testing.md P-03).
  factory CaptureTemplate.fromLabeledSample({
    required String id,
    required String unitId,
    String? captureSourceId,
    required String name,
    required TemplateDirection direction,
    required String sampleText,
    required List<LabeledSpan> labels,
    int version = 1,
    bool enabled = true,
  }) {
    final sorted = [...labels]..sort((a, b) => a.start.compareTo(b.start));
    for (var i = 1; i < sorted.length; i++) {
      assert(
        sorted[i].start >= sorted[i - 1].end,
        'Labeled spans must not overlap',
      );
    }

    final buffer = StringBuffer();
    final fieldMap = <String, TemplateFieldType>{};
    final usedCounts = <TemplateFieldType, int>{};
    var cursor = 0;

    final customFieldNames = <String, String>{};
    var customCount = 0;

    for (var i = 0; i < sorted.length; i++) {
      final span = sorted[i];
      buffer.write(_escapeLiteral(sampleText.substring(cursor, span.start)));

      // #55: a wildcard span is "this part changes between messages". It
      // matches any text but is deliberately *not* a captured field — the
      // parser has nothing to do with it, and it never reaches fieldMap.
      //
      // Non-greedy so it stops at the next literal/label. Greedy when it is
      // the last label, so it takes the rest of the line instead of one
      // character (the same trap as a trailing person label, #72/F11b).
      if (span.type == TemplateFieldType.wildcard) {
        final isLast = i == sorted.length - 1;
        buffer.write(isLast ? r'(?:[\s\S]+)' : r'(?:[\s\S]+?)');
        cursor = span.end;
        continue;
      }

      final isCustom = span.type == TemplateFieldType.custom;

      final groupName = isCustom
          ? 'custom${++customCount}' //#56
          : _nextGroupName(span.type, usedCounts);

      if (isCustom) {
        final label = span.customName?.trim();
        if (label == null || label.isEmpty) {
          throw ArgumentError('A custom field label needs a name.');
        }
        customFieldNames[groupName] = label;
      }

      final isFreeText = span.type == TemplateFieldType.person || isCustom;
      final fieldPattern = isFreeText && i == sorted.length - 1
          ? _lastFreeTextPattern(sampleText.substring(span.end))
          : _fieldPattern(span.type);

      // #72 (F11b): a lazy person match with nothing after it stops at one
      // character, so the *last* label needs an explicit boundary.
      // final fieldPattern =
      //     span.type == TemplateFieldType.person && i == sorted.length - 1
      //     ? _lastPersonPattern(sampleText.substring(span.end))
      //     : _fieldPattern(span.type);
      buffer.write('(?<$groupName>$fieldPattern)');
      fieldMap[groupName] = span.type;
      cursor = span.end;
    }

    // #20 Intentionally no trailing literal: the pattern ends where the last
    // labeled field ends. Real messages have variable tails (URLs, "see all
    // your balances", counters, per-message limits) that we don't want to
    // require on every future message. Leading literals before the first
    // label are still kept — a header like "Confirmed." pins the rule to
    // the right kind of message.
    //     buffer.write(_escapeLiteral(sampleText.substring(cursor)));
    return CaptureTemplate(
      id: id,
      unitId: unitId,
      captureSourceId: captureSourceId,
      name: name,
      direction: direction,
      pattern: buffer.toString(),
      fieldMap: fieldMap,
      sampleText: sampleText,
      version: version,
      enabled: enabled,
      customFieldNames: customFieldNames,
    );
  }

  CaptureTemplate copyWith({
    bool? enabled,
    String? name,
    int? version,
    Map<String, String>? customFieldNames,
  }) {
    return CaptureTemplate(
      id: id,
      unitId: unitId,
      captureSourceId: captureSourceId,
      name: name ?? this.name,
      direction: direction,
      pattern: pattern,
      fieldMap: fieldMap,
      sampleText: sampleText,
      version: version ?? this.version,
      enabled: enabled ?? this.enabled,
      customFieldNames: customFieldNames ?? this.customFieldNames,
    );
  }

  /// testing.md P-11: round-trips through the same shape tables.dart's
  /// `fieldMapJson` column stores (group name -> field type name), so a
  /// repository just needs to `jsonEncode`/`jsonDecode` this map.
  Map<String, dynamic> toJson() => {
    'id': id,
    'unitId': unitId,
    'captureSourceId': captureSourceId,
    'name': name,
    'direction': direction.name,
    'pattern': pattern,
    'fieldMap': fieldMap.map(
      (groupName, type) => MapEntry(groupName, type.name),
    ),
    'sampleText': sampleText,
    'version': version,
    'enabled': enabled,
    if (customFieldNames.isNotEmpty) 'customFieldNames': customFieldNames,
  };

  factory CaptureTemplate.fromJson(Map<String, dynamic> json) {
    final rawFieldMap = json['fieldMap'] as Map<String, dynamic>;

    final rawCustom = json['customFieldNames'];
    final customFieldNames = <String, String>{};
    if (rawCustom is Map) {
      rawCustom.forEach((key, value) {
        if (key is String && value is String && value.trim().isNotEmpty) {
          customFieldNames[key] = value.trim();
        }
      });
    }

    return CaptureTemplate(
      id: json['id'] as String,
      unitId: json['unitId'] as String,
      captureSourceId: json['captureSourceId'] as String?,
      name: json['name'] as String,
      direction: TemplateDirection.values.byName(json['direction'] as String),
      pattern: json['pattern'] as String,
      fieldMap: rawFieldMap.map(
        (groupName, typeName) => MapEntry(
          groupName,
          TemplateFieldType.values.byName(typeName as String),
        ),
      ),
      sampleText: json['sampleText'] as String,
      version: json['version'] as int? ?? 1,
      enabled: json['enabled'] as bool? ?? true,
      customFieldNames: customFieldNames,
    );
  }

  static String _nextGroupName(
    TemplateFieldType type,
    Map<TemplateFieldType, int> used,
  ) {
    final count = (used[type] ?? 0) + 1;
    used[type] = count;
    // Dart named-group names must start with a letter and be alphanumeric —
    // `type.name` (e.g. "amount") already is; appending the count for a
    // repeat keeps that true ("amount2").
    return count == 1 ? type.name : '${type.name}$count';
  }

  /// Escapes regex metacharacters so literal text from the sample is
  /// matched as itself. Dart's RegExp has no built-in escape helper.
  static String _escapeLiteral(String s) {
    return s.replaceAllMapped(
      RegExp(r'[.*+?^${}()|[\]\\]'),
      (m) => '\\${m[0]}',
    );
  }

  /// The regex each field type matches against in a *future* message —
  /// deliberately more permissive than any one sample, since the amount,
  /// code, date etc. will differ every time (testing.md P-02/P-03).
  static String _fieldPattern(TemplateFieldType type) {
    switch (type) {
      case TemplateFieldType.amount:
      case TemplateFieldType.balance:
      case TemplateFieldType.fee:
        // Optional currency label/prefix, digits with optional thousands
        // separators, optional decimal part — "Ksh350.00", "KES 1,250",
        // "350" all match (testing.md P-02).
        return r'(?:[A-Za-z]{2,5}\.?\s*)?[\d,]+(?:\.\d+)?[.,;:!?]?';
      case TemplateFieldType.code:
        // #72 (F11a): letters and digits, with punctuation allowed
        // *between* them (Ref:AC123, TXN-45/B, ab_12.3) but never leading
        // or trailing, so a sentence-ending "." or ":" stays outside.
        return r'[A-Za-z0-9]+(?:[:_\-./][A-Za-z0-9]+)*';
      case TemplateFieldType.date:
        // #72 (F11c): a real date shape rather than a lazy match, so it
        // doesn't depend on what follows. Numeric dates (28/9/26,
        // 28-09-2026, 28.09.2026, 2026-09-28) or "28 Sep 2026" /
        // "28-Sep-26", then an optional time (12 or 24 hour, optional
        // "at", optional seconds, optional AM/PM). Parser._parseDate reads
        // the same shapes.
        return r'(?:(?:on|at)\s+)?'
            r'(?:\d{1,4}[-/.]\d{1,2}[-/.]\d{1,4}'
            r'|\d{1,2}[ -][A-Za-z]{3,9}[ -]\d{2,4})'
            r'(?:(?:[ ,]*|T)(?:at\s+)?\d{1,2}:\d{2}(?::\d{2})?'
            r'(?:\s*[AaPp][Mm])?)?';
      case TemplateFieldType.person:
        // Non-greedy so it stops at the next literal chunk once compiled,
        // rather than swallowing the rest of the message. Never crosses a
        // line break.
        return r'[^\n]+?';

      case TemplateFieldType.custom:
        // Same shape as a person: free text bounded by the surrounding
        // literals, or by the end of the line when it is the last label.
        return r'[^\n]+?';
      case TemplateFieldType.wildcard:
        // Handled separately in fromLabeledSample as a non-capturing
        // group; this case exists only so the switch stays exhaustive.
        return r'[\s\S]+?';
    }
  }

  /// #72 (F11b): the pattern for a person label that is the *last* label.
  /// [rest] is the sample text after the label. With text after it, stop at
  /// the next few literal characters (a zero-width lookahead, so the
  /// variable tail of the message stays unconstrained). With nothing after
  /// it, take the rest of the line.
  static String _lastFreeTextPattern(String rest) {
    final lineEnd = rest.indexOf('\n');
    final line = lineEnd < 0 ? rest : rest.substring(0, lineEnd);
    if (line.isEmpty) return r'[^\n]+';
    final boundary = line.length <= 4 ? line : line.substring(0, 4);
    return '[^\\n]+?(?=${_escapeLiteral(boundary)})';
  }
}
</file>

<file path="lib/platform/notification_capture.dart">
// ---------------------------------------------------------------------------
// Notification capture (issue #22) — replaces the #18 spike
// (listener_spike.dart, now deleted).
//
// Two halves live here:
//
//  * UI-isolate API: register the background entry point with Android,
//    mirror the allow-list to the native side, check/open notification
//    access, list installed apps for the picker, and hear about captures
//    the background isolate wrote.
//
//  * The background entry point, `captureBackgroundDispatcher`: started by
//    NotificationListener.kt / CaptureEngine.kt in its own FlutterEngine
//    when an allow-listed notification arrives — possibly while the app is
//    fully closed. It runs the same CaptureProcessor the UI runs.
//
// Privacy: notification text only ever travels native -> this isolate ->
// CaptureProcessor. It is never logged here, and nothing is stored unless
// the package is an enabled capture source (US-10).
// ---------------------------------------------------------------------------
import 'dart:ui';

import 'package:flutter/services.dart';
import 'package:flutter/widgets.dart';
import 'package:fuata/platform/widget_bridge.dart';

import '../data/constants/method_channels_constants.dart';
import '../data/db/app_database.dart';
import '../data/db/drift_repositories.dart';
import '../domain/logic/banner_loader.dart';
import '../domain/logic/capture_pipeline.dart';
import '../domain/logic/serial_queue.dart';
import '../domain/logic/widget_content.dart';
import 'alerts.dart';
import 'banner.dart';

const _channel = MethodChannel(captureMethodName);

/// One launchable app, as offered in the allow-list picker.
class InstalledApp {
  final String packageName;
  final String label;
  const InstalledApp({required this.packageName, required this.label});
}

// --- UI isolate ---------------------------------------------------------

/// Call once from `main()` on every start. Registers the background entry
/// point below with Android so the listener service can find it again
/// from a process that never ran Dart's `main()` (app swiped away).
///
/// The handle is only valid for the build that produced it, so it is
/// re-registered on every launch. After an app *update*, capture resumes
/// once the app has been opened once.
Future<void> registerCaptureCallback() async {
  final handle = PluginUtilities.getCallbackHandle(captureBackgroundDispatcher);
  if (handle == null) {
    // Only happens if the dispatcher loses its vm:entry-point pragma.
    debugPrint('[capture] could not obtain a callback handle');
    return;
  }
  try {
    await _channel.invokeMethod('setCallbackHandle', handle.toRawHandle());
  } on MissingPluginException {
    // Widget tests / non-Android: no native side.
  }
}

/// Opens Android's notification-access screen. On some phones (see
/// design.md 5.1, MIUI) the grant only takes effect when switched off and
/// on again *there* — the UI copy tells the person so.
Future<void> openNotificationAccessSettings() async {
  try {
    await _channel.invokeMethod('openNotificationAccessSettings');
  } on MissingPluginException {
    // no native side
  }
}

/// Whether the person has granted Fuata notification access. This is the
/// *grant*, not proof the service is bound (design.md 5.1) — detecting a
/// granted-but-unbound listener is #36.
Future<bool> isNotificationAccessEnabled() async {
  try {
    return await _channel.invokeMethod<bool>('isNotificationAccessEnabled') ??
        false;
  } on MissingPluginException {
    return false;
  } on PlatformException {
    return false;
  }
}

/// Mirrors the allow-list to the native listener so it can discard a
/// non-allowed notification *before* it wakes Dart. The database's
/// capture_sources table stays the source of truth; this is a cache, and
/// CaptureProcessor.captureNotification re-checks the database anyway.
Future<void> setAllowedPackages(Iterable<String> packages) async {
  try {
    await _channel.invokeMethod('setAllowedPackages', packages.toList());
  } on MissingPluginException {
    // no native side
  }
}

/// Launchable apps on the phone, for the picker. Uses a launcher-intent
/// `<queries>` entry rather than QUERY_ALL_PACKAGES, so Fuata never asks
/// for the broad "see every app" permission.
Future<List<InstalledApp>> listLaunchableApps() async {
  try {
    final raw = await _channel.invokeListMethod<Map<Object?, Object?>>(
      'listLaunchableApps',
    );
    return [
      for (final m in raw ?? const <Map<Object?, Object?>>[])
        if (m['packageName'] is String && m['label'] is String)
          InstalledApp(
            packageName: m['packageName']! as String,
            label: m['label']! as String,
          ),
    ];
  } on MissingPluginException {
    return const [];
  } on PlatformException {
    return const [];
  }
}

/// The background isolate writes through its *own* database connection, so
/// this isolate's drift streams don't hear about it. Native pings us when
/// a capture landed; [onChanged] is where the caller tells drift to re-run
/// its queries. Pass null to detach.
void listenForCaptureChanges(VoidCallback? onChanged) {
  if (onChanged == null) {
    _channel.setMethodCallHandler(null);
    return;
  }
  _channel.setMethodCallHandler((call) async {
    debugPrint('[capture] got ${call.method}');
    if (call.method == 'onCapturesChanged') onChanged();
    return null;
  });
}

// --- Background isolate -------------------------------------------------

/// The background entry point. Runs in its own isolate, in its own
/// FlutterEngine, started by CaptureEngine.kt — this is NOT the UI
/// isolate. `vm:entry-point` stops the AOT compiler tree-shaking a
/// function that's only ever reached from native code.
@pragma('vm:entry-point')
void captureBackgroundDispatcher() {
  WidgetsFlutterBinding.ensureInitialized();
  const channel = MethodChannel(captureBackgroundMethodName);
  final queue = SerialQueue();

  channel.setMethodCallHandler((call) async {
    if (call.method != 'onNotification') return null;
    final args = (call.arguments as Map).cast<String, Object?>();
    final packageName = args['packageName'] as String?;
    final text = args['text'] as String?;
    if (packageName == null || text == null) return false;

    // One notification at a time: capture is check-then-insert, and
    // native may hand us several at once (SMS + push for one payment).
    return queue.run(() => _captureOne(packageName, text));
  });

  // Tell the native side this isolate is alive and ready for
  // onNotification calls.
  channel.invokeMethod('backgroundIsolateReady');
}

/// Returns true when something was written (a pending/confirmed
/// transaction or an unparsed entry), so native knows whether to tell a
/// running UI to refresh.
Future<bool> _captureOne(String packageName, String text) async {
  // A connection per notification, closed straight after — the pattern
  // the #18 spike proved safe across two isolates on one file
  // (design.md 5.1). Closing also lets the connection's own isolate exit.
  final db = AppDatabase();
  try {
    final processor = CaptureProcessor(
      units: DriftUnitRepository(db),
      templates: DriftTemplateRepository(db),
      transactions: DriftTransactionRepository(db),
      captures: DriftCaptureRepository(db),
      sources: DriftCaptureSourceRepository(db),
      settings: DriftSettingsRepository(db),
    );
    final outcome = await processor.captureNotification(packageName, text);
    final wrote = outcome is Captured || outcome is CaptureUnparsed;
    if (wrote) {
      // Issue #16: the ongoing banner has to be re-posted from *here*
      // too — this isolate is the only thing running when the app is
      // closed, so the UI isolate's bannerSyncProvider can't see the
      // write. A banner failure must never break the capture: the row is
      // already saved, and the UI isolate re-posts on next open.
      try {
        await _refreshBanner(db);
      } catch (e) {
        debugPrint('[capture] banner re-post failed: ${e.runtimeType}');
      }
      // Issue #63: same reasoning for limit alerts — the UI isolate can't
      // see this write when the app is closed. Independent try/catch: a
      // banner failure must not swallow an alert, or the reverse.
      try {
        await fireDueAlerts(
          units: DriftUnitRepository(db),
          transactions: DriftTransactionRepository(db),
          limits: DriftLimitRepository(db),
          outings: DriftOutingRepository(db),
          settings: DriftSettingsRepository(db),
          log: DriftAlertLogRepository(db),
        );
      } catch (e) {
        debugPrint('[capture] alert failed: ${e.runtimeType}');
      }

      //Issue #29
      try {
        await _refreshWidget(db);
      } catch (e) {
        debugPrint('[capture] widget push failed: ${e.runtimeType}');
      }
    }
    return wrote;
  } catch (e, st) {
    // Type only — an exception message could echo notification text.
    debugPrint('[capture] failed: ${e.runtimeType}\n$st');
    return false;
  } finally {
    await db.close();
  }
}

/// Rebuilds the banner from the same repositories the capture just wrote
/// through, and posts or cancels it. Runs the exact same
/// [loadBannerContent] the UI isolate does.
Future<void> _refreshBanner(AppDatabase db) async {
  final content = await loadBannerContent(
    units: DriftUnitRepository(db),
    transactions: DriftTransactionRepository(db),
    limits: DriftLimitRepository(db),
    outings: DriftOutingRepository(db),
    settings: DriftSettingsRepository(db),
  );
  if (content == null) {
    await BannerPlatform.instance.cancel();
  } else {
    await BannerPlatform.instance.show(
      content,
      // Read once here from the *current* settings so the background
      // isolate sees the same lock-screen choice the UI isolate would.
      redactOnLockScreen: (await DriftSettingsRepository(
        db,
      ).watchSettings().first).redactedLockScreenBanner,
    );
  }
}

/// Rebuilds the home-screen widget's snapshot from the same repositories
/// the capture just wrote through. Issue #29; the widget has no other
/// source of truth when the app is closed.
/// Rebuilds the home-screen widget's snapshot from the same repositories
/// the capture just wrote through — via the shared loader, so the two
/// isolates can never disagree about what the widget says (issue #29,
/// options #113).
Future<void> _refreshWidget(AppDatabase db) async {
  final snapshot = await loadWidgetSnapshot(
    units: DriftUnitRepository(db),
    transactions: DriftTransactionRepository(db),
    limits: DriftLimitRepository(db),
    settings: DriftSettingsRepository(db),
  );
  await AndroidHomeWidgetBridge().push(snapshot);
}

/// Opens Android's per-app notification settings for Fuata (F15: the
/// "Android is blocking Fuata's notifications" warning on the Banner
/// screen). Distinct from [openNotificationAccessSettings], which is the
/// special-access list for the listener.
Future<void> openAppNotificationSettings() async {
  try {
    await _channel.invokeMethod('openAppNotificationSettings');
  } on MissingPluginException {
    // no native side
  }
}
</file>

<file path="lib/platform/scheduled_export.dart">
// ---------------------------------------------------------------------------
// Scheduled encrypted export (issue #35) — UI API and background entry point.
//
// Two halves, same shape as platform/notification_capture.dart:
//
//  * UI-isolate API: register the background callback, schedule / cancel
//    the alarm, pick the export folder, save an encrypted file now (the
//    "Run now" button), and read the last run's status.
//
//  * `scheduledExportDispatcher`: started by ScheduledExportReceiver.kt
//    in its own engine when the alarm fires. Reads the DB, builds the
//    backup, encrypts it with the cached passphrase, writes it to the
//    chosen folder, and reports success or a runtime-type-only failure.
//
// No amount or passphrase is ever logged here.
// ---------------------------------------------------------------------------
import 'dart:ui';

import 'package:flutter/services.dart';
import 'package:flutter/widgets.dart';

import '../data/constants/method_channels_constants.dart';
import '../data/db/app_database.dart';
import '../data/db/backup_repository.dart';
import '../data/db/drift_repositories.dart';
import '../domain/logic/backup_crypto.dart';
import '../domain/logic/backup_service.dart';
import '../domain/logic/scheduled_export.dart';
import 'backup_passphrase_store.dart';

const _channel = MethodChannel(scheduledExportMethodName);

// --- UI isolate ---------------------------------------------------------

class ScheduledExportStatus {
  /// Null when the schedule has never run since install.
  final DateTime? lastRunAt;
  final bool lastRunSuccess;

  /// Just the runtime type — never exception text. A scheduled run that
  /// fails has no context for a message, and the type is what a bug
  /// report needs.
  final String? lastRunError;

  const ScheduledExportStatus({
    this.lastRunAt,
    this.lastRunSuccess = false,
    this.lastRunError,
  });

  static const empty = ScheduledExportStatus();
}

/// Call once from main() on every start. Re-registers the callback handle
/// every launch — the handle is valid for one build.
Future<void> registerScheduledExportCallback() async {
  final handle =
  PluginUtilities.getCallbackHandle(scheduledExportDispatcher);
  if (handle == null) {
    debugPrint('[scheduled_export] could not obtain a callback handle');
    return;
  }
  try {
    await _channel
        .invokeMethod('setCallbackHandle', handle.toRawHandle());
  } on MissingPluginException {
    // Widget tests / non-Android.
  }
}

/// Arms (or re-arms) the alarm. [firstTriggerAt] is a wall-clock correct
/// first occurrence from `nextScheduledExportTrigger`; the OS then repeats
/// it at [intervalMs] and, after a reboot, the boot receiver re-arms from
/// saved state.
Future<void> scheduleScheduledExport({
  required DateTime firstTriggerAt,
  required int intervalMs,
}) async {
  try {
    await _channel.invokeMethod('schedule', {
      'triggerAtMillis': firstTriggerAt.toUtc().millisecondsSinceEpoch,
      'intervalMillis': intervalMs,
    });
  } on MissingPluginException {
    // no native side
  }
}

Future<void> cancelScheduledExport() async {
  try {
    await _channel.invokeMethod('cancel');
  } on MissingPluginException {
    // no native side
  }
}

/// Opens Android's folder picker, takes a persistable permission, and
/// returns the tree URI. Null when the person backs out.
Future<String?> pickScheduledExportFolder() async {
  try {
    return await _channel.invokeMethod<String>('pickFolder');
  } on MissingPluginException {
    return null;
  } on PlatformException {
    return null;
  }
}

Future<bool> hasScheduledExportFolderPermission(String uri) async {
  try {
    return await _channel.invokeMethod<bool>(
      'hasPersistedFolder',
      {'uri': uri},
    ) ??
        false;
  } on MissingPluginException {
    return false;
  }
}

Future<String?> scheduledExportFolderName(String uri) async {
  try {
    return await _channel.invokeMethod<String>(
      'folderDisplayName',
      {'uri': uri},
    );
  } on MissingPluginException {
    return null;
  }
}

/// Releases the SAF permission for [uri] (the "change folder" flow calls
/// this before picking a new one; "clear folder" would too if added).
Future<void> clearScheduledExportFolder(String uri) async {
  try {
    await _channel.invokeMethod('clearFolder', {'uri': uri});
  } on MissingPluginException {
    // no native side
  }
}

/// Writes [content] to [filename] inside [folderUri]. Returns false on any
/// failure — the caller decides whether to surface a message.
Future<bool> writeToExportFolder({
  required String folderUri,
  required String filename,
  required String content,
}) async {
  try {
    return await _channel.invokeMethod<bool>('saveToFolder', {
      'uri': folderUri,
      'filename': filename,
      'content': content,
    }) ??
        false;
  } on MissingPluginException {
    return false;
  } on PlatformException {
    return false;
  }
}

Future<ScheduledExportStatus> readScheduledExportStatus() async {
  try {
    final map =
    await _channel.invokeMapMethod<String, Object?>('lastRun');
    if (map == null) return ScheduledExportStatus.empty;
    final ms = map['at'] as int?;
    return ScheduledExportStatus(
      lastRunAt: ms == null || ms == 0
          ? null
          : DateTime.fromMillisecondsSinceEpoch(ms),
      lastRunSuccess: (map['success'] as bool?) ?? false,
      lastRunError: map['error'] as String?,
    );
  } on MissingPluginException {
    return ScheduledExportStatus.empty;
  }
}

// --- Background isolate -------------------------------------------------

@pragma('vm:entry-point')
void scheduledExportDispatcher() {
  WidgetsFlutterBinding.ensureInitialized();
  // Fire and forget. Any error is reported back to native, which records
  // it for the settings screen and then tears the engine down.
  _runExport().then((outcome) async {
    const ch = MethodChannel(scheduledExportBackgroundMethodName);
    try {
      await ch.invokeMethod('reportResult', {
        'success': outcome == null,
        'error': ?outcome,
      });
    } on MissingPluginException {
      // no native side
    }
  });
}

/// Returns null on success, or the *runtime type* of the failure.
Future<String?> _runExport() async {
  AppDatabase? db;
  try {
    db = AppDatabase();
    final settings =
    await DriftSettingsRepository(db).watchSettings().first;
    final folderUri = settings.scheduledExportFolderUri;
    if (folderUri == null || folderUri.isEmpty) {
      return 'StateError';
    }

    final passphrase = await BackupPassphraseStore.read();
    if (passphrase == null) return 'StateError';

    final backup = await BackupService(DriftBackupRepository(db))
        .buildExport(includeRawText: settings.scheduledExportIncludeRawText);
    final encrypted =
    await BackupCrypto.encode(backup.json, passphrase: passphrase);

    const ch = MethodChannel(scheduledExportBackgroundMethodName);
    final ok = await ch.invokeMethod<bool>('saveToFolder', {
      'uri': folderUri,
      'filename': scheduledExportFileName(DateTime.now()),
      'content': encrypted,
    });
    if (ok != true) return 'PlatformException';
    return null;
  } catch (e) {
    // Type only — an exception message could echo data. See the doc on
    // ScheduledExportStatus.lastRunError.
    return e.runtimeType.toString();
  } finally {
    await db?.close();
  }
}
</file>

