/// The most important widget in the app: one glance answers
/// "Am I okay today?" (ui-design-brief.md section 7.2).
class _HeroStatusCard extends StatelessWidget {
  final HomeState state;
  const _HeroStatusCard({required this.state});

  @override
  Widget build(BuildContext context) {
    final color = _statusColor(state.status, context);
    final limit = state.dailyLimit;
    final currency = state.units.isNotEmpty ? state.units.first.currencyCode : 'KES';

    if (limit == null) {
      return _Card(
        color: color.withValues(alpha: 0.12),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('Altogether you have',
                style: Theme.of(context).textTheme.bodyMedium),
            const SizedBox(height: 4),
            Text(
              Money(_totalMinor(state), currency).format(),
              style: Theme.of(context)
                  .textTheme
                  .displaySmall
                  ?.copyWith(fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 4),
            const Text('Set a daily limit to see how today is going.'),
          ],
        ),
      );
    }

    final ratio = (state.spentToday / limit.amountMinor).clamp(0.0, 1.0);
    final left = Money(state.leftToday, currency);

    return _Card(
      color: color.withValues(alpha: 0.12),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Text(state.status.emoji, style: const TextStyle(fontSize: 20)),
              const SizedBox(width: 8),
              Text(state.status.label,
                  style: Theme.of(context)
                      .textTheme
                      .titleMedium
                      ?.copyWith(color: color, fontWeight: FontWeight.w600)),
            ],
          ),
          const SizedBox(height: 8),
          Text(
            state.leftToday >= 0
                ? '${left.format()} left today'
                : '${(-state.leftToday > 0 ? Money(-state.leftToday, currency) : left).format()} over today',
            style: Theme.of(context)
                .textTheme
                .displaySmall
                ?.copyWith(fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 12),
          ClipRRect(
            borderRadius: BorderRadius.circular(8),
            child: LinearProgressIndicator(
              value: ratio,
              minHeight: 8,
              backgroundColor: color.withValues(alpha: 0.15),
              valueColor: AlwaysStoppedAnimation(color),
            ),
          ),
          const SizedBox(height: 6),
          Text(
            'of ${Money(limit.amountMinor, currency).format()} · resets at midnight',
            style: Theme.of(context).textTheme.bodySmall,
          ),
        ],
      ),
    );
  }

  int _totalMinor(HomeState state) =>
      state.balanceByUnit.values.fold(0, (a, b) => a + b);
}

class _UnitRow extends StatelessWidget {
  final HomeState state;
  const _UnitRow({required this.state});

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: 96,
      child: ListView.separated(
        scrollDirection: Axis.horizontal,
        itemCount: state.units.length + 1,
        separatorBuilder: (_, __) => const SizedBox(width: 12),
        itemBuilder: (context, i) {
          if (i == state.units.length) {
            return _AddUnitCard(onTap: () {});
          }
          final unit = state.units[i];
          final balance = state.balanceByUnit[unit.id] ?? 0;
          return _UnitCard(unit: unit, balanceMinor: balance);
        },
      ),
    );
  }
}

class _UnitCard extends StatelessWidget {
  final MoneyUnit unit;
  final int balanceMinor;
  const _UnitCard({required this.unit, required this.balanceMinor});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 140,
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: unit.color.withValues(alpha: 0.12),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(unit.iconEmoji, style: const TextStyle(fontSize: 22)),
          Text(unit.name,
              style: Theme.of(context).textTheme.bodySmall,
              maxLines: 1,
              overflow: TextOverflow.ellipsis),
          Text(
            Money(balanceMinor, unit.currencyCode).format(),
            style: Theme.of(context)
                .textTheme
                .titleMedium
                ?.copyWith(fontWeight: FontWeight.bold),
          ),
        ],
      ),
    );
  }
}

class _AddUnitCard extends StatelessWidget {
  final VoidCallback onTap;
  const _AddUnitCard({required this.onTap});

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(20),
      child: Container(
        width: 100,
        decoration: BoxDecoration(
          border: Border.all(color: Theme.of(context).dividerColor),
          borderRadius: BorderRadius.circular(20),
        ),
        alignment: Alignment.center,
        child: const Icon(Icons.add),
      ),
    );
  }
}

class _TransactionRow extends StatelessWidget {
  final MoneyTransaction transaction;
  final MoneyUnit unit;
  const _TransactionRow({required this.transaction, required this.unit});

  @override
  Widget build(BuildContext context) {
    final isSpend = transaction.type == TxType.spent;
    final amount = Money(transaction.amountMinor.abs(), unit.currencyCode);
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8),
      child: Row(
        children: [
          CircleAvatar(
            backgroundColor: unit.color.withValues(alpha: 0.15),
            child: Text(unit.iconEmoji),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(transaction.counterparty ?? unit.name,
                    style: Theme.of(context).textTheme.bodyMedium),
                Text(_friendlyTime(transaction.occurredAt),
                    style: Theme.of(context).textTheme.bodySmall),
              ],
            ),
          ),
          Text(
            isSpend ? '-${amount.format()}' : '+${amount.format()}',
            style: TextStyle(
              fontWeight: FontWeight.w600,
              color: isSpend ? null : const Color(0xFF2E9E6B),
            ),
          ),
        ],
      ),
    );
  }

  String _friendlyTime(DateTime t) {
    final now = DateTime.now();
    final isToday = t.year == now.year && t.month == now.month && t.day == now.day;
    if (isToday) return DateFormat('h:mm a').format(t);
    final yesterday = now.subtract(const Duration(days: 1));
    final isYesterday =
        t.year == yesterday.year && t.month == yesterday.month && t.day == yesterday.day;
    if (isYesterday) return 'yesterday';
    return DateFormat('EEE, d MMM').format(t);
  }
}

class _Card extends StatelessWidget {
  final Color color;
  final Widget child;
  const _Card({required this.color, required this.child});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(20),
      decoration: BoxDecoration(
        color: color,
        borderRadius: BorderRadius.circular(24),
      ),
      child: child,
    );
  }
}

class _EmptyHome extends StatelessWidget {
