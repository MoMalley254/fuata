<file path="lib/domain/models/money.dart">
import 'package:intl/intl.dart';

/// Shown in place of any amount while "Hide amounts in the app" is on
/// (issue #81, finding F7). A fixed run of bullets, not one per digit —
/// a length-matched mask would leak the rough size of a balance, which is
/// exactly what hiding is for.
const kHiddenAmountMask = '••••';

/// Decimal places for a currency, from intl's ISO 4217 data. Every code
/// intl knows gets the right answer; the two-decimal default only applies
/// to a code intl has never heard of, which in practice only happens on a
/// hand-edited backup file. Issue #114.
int minorUnitExponent(String currencyCode) {
  try {
    return NumberFormat.simpleCurrency(
      name: currencyCode.toUpperCase(),
      locale: 'en_US',
    ).decimalDigits ?? 2;
  } catch (_) {
    return 2;
  }
}

/// Display symbol/prefix for a currency. intl's CLDR data decides the
/// symbol; the space rule below is the only Fuata-specific thing, and
/// exists because "KSh 1,250" reads better than "KSh1,250" while
/// "$1,250" reads better than "$ 1,250". Letter-shaped symbols get a
/// trailing space, punctuation symbols don't. Issue #114.
String currencySymbol(String currencyCode) {
  String symbol;
  try {
    final s = NumberFormat.simpleCurrency(
      name: currencyCode.toUpperCase(),
      locale: 'en_US',
    ).currencySymbol;
    symbol = s.isNotEmpty ? s : '${currencyCode.toUpperCase()} ';
  } catch (_) {
    symbol = '${currencyCode.toUpperCase()} ';
  }
  if (symbol.isNotEmpty &&
      !symbol.endsWith(' ') &&
      RegExp(r'^[A-Za-z]').hasMatch(symbol)) {
    return '$symbol ';
  }
  return symbol;
}

int pow10(int exponent) {
  var r = 1;
  for (var i = 0; i < exponent; i++) {
    r *= 10;
  }
  return r;
}

/// All amounts in the app are integers in the currency's minor unit
/// (e.g. cents). Never use double for money (ADR-003). `majorValue`
/// exists only to bridge into widgets built around double + symbol
/// (StatusRingCard, UnitCard, TransactionRow) — never store or do
/// arithmetic on it.
class Money {
  final int minor;
  final String currencyCode;

  const Money(this.minor, this.currencyCode);

  factory Money.zero(String currencyCode) => Money(0, currencyCode);

  /// Parses a human-entered major-unit string ("1,250.50") into Money.
  /// Throws FormatException on invalid input.
  factory Money.parseMajor(String input, String currencyCode) {
    final cleaned = input.replaceAll(',', '').trim();
    if (cleaned.isEmpty) throw const FormatException('Empty amount');
    final exponent = minorUnitExponent(currencyCode);
    final parts = cleaned.split('.');
    final wholePart = int.parse(parts[0].isEmpty ? '0' : parts[0]);
    int fractionPart = 0;
    if (parts.length > 1 && exponent > 0) {
      final frac = parts[1].padRight(exponent, '0').substring(0, exponent);
      fractionPart = int.parse(frac);
    }
    final factor = pow10(exponent);
    final sign = cleaned.startsWith('-') ? -1 : 1;
    return Money(sign * (wholePart.abs() * factor + fractionPart), currencyCode);
  }

  Money operator +(Money other) {
    assert(currencyCode == other.currencyCode, 'Currency mismatch');
    return Money(minor + other.minor, currencyCode);
  }

  Money operator -(Money other) {
    assert(currencyCode == other.currencyCode, 'Currency mismatch');
    return Money(minor - other.minor, currencyCode);
  }

  Money operator -() => Money(-minor, currencyCode);

  bool get isNegative => minor < 0;
  bool get isZero => minor == 0;

  /// Double major-unit value, e.g. 125050 minor -> 1250.50. Display-only
  /// bridge for widgets that take double + a currency symbol string.
  double get majorValue => minor / pow10(minorUnitExponent(currencyCode));

  /// Formatted for display, e.g. "1,250.50".
  String format({bool showSign = false}) {
    final exponent = minorUnitExponent(currencyCode);
    final divisor = pow10(exponent);
    final major = minor.abs() / divisor;
    final formatter = NumberFormat.currency(
      symbol: '',
      decimalDigits: exponent,
    );
    final formatted = formatter.format(major).trim();
    final sign = minor < 0 ? '-' : (showSign ? '+' : '');
    return '$sign$formatted';
  }

  @override
  String toString() => '${format()} $currencyCode';
}
</file>

<file path="lib/domain/models/outing.dart">
// ---------------------------------------------------------------------------
// An outing (issue #30): a temporary, named budget with its own window.
//
// "I'm going to Mombasa for 3 days, I have 15,000 for the trip."
//
// Deliberately not a LimitRule: a limit's window is derived from `now`
// (today / this week / this month), while an outing's window is explicit
// and can be any span. The two share *status computation*, not storage —
// `Outing.asLimit()` presents an outing in the shape the limit engine,
// the alert engine and the banner already understand, so none of them
// grows a special case for outings.
//
// No Flutter imports. The whole model is testable without a device.
// ---------------------------------------------------------------------------
import 'limit_rule.dart';

class Outing {
  final String id;
  final String name;

  /// The trip's budget in minor units, in [currencyCode].
  final int amountMinor;

  /// Carried from `AppSettings.currencyCode` at creation. The app is
  /// single-currency (#114), so this equals the app's currency until the
  /// person changes it — at which point the outing keeps the *amount*
  /// they chose (15,000 of whatever was current), which is the honest
  /// reading of "I set my trip budget to 15,000 KES".
  final String currencyCode;

  final DateTime startAt;
  final DateTime endAt;

  /// The units this outing counts, or empty for "every unit". Empty is
  /// the common case: a person on a trip spends across cash, mobile
  /// money and their card, and doesn't want to configure that.
  final Set<String> unitIds;

  /// Whether the ongoing banner shows the outing while active. Also
  /// respects the master `AppSettings.bannerEnabled` — that off means
  /// no banner at all.
  final bool bannerEnabled;

  /// False when the person cancelled the outing early. History stays
  /// (their transactions), but the outing stops counting as active,
  /// stops showing on the banner, and stops alerting.
  final bool enabled;

  final DateTime createdAt;

  const Outing({
    required this.id,
    required this.name,
    required this.amountMinor,
    required this.currencyCode,
    required this.startAt,
    required this.endAt,
    required this.createdAt,
    this.unitIds = const <String>{},
    this.bannerEnabled = true,
    this.enabled = true,
  });

  /// True when [now] is inside [startAt, endAt) and the outing is enabled.
  /// `endAt` is exclusive — an outing that ends at 11am has ended at 11am,
  /// matching how Ledger treats period ends.
  bool isActive(DateTime now) =>
      enabled && !now.isBefore(startAt) && now.isBefore(endAt);

  bool get isPast => DateTime.now().isAfter(endAt);
  bool get isUpcoming => DateTime.now().isBefore(startAt);
  bool get hasStarted => !isUpcoming;

  /// How many days the outing runs for, rounded up — the "3-day trip"
  /// figure shown on the tile.
  int get dayCount {
    final ms = endAt.difference(startAt).inMilliseconds;
    final days = (ms / const Duration(days: 1).inMilliseconds).ceil();
    return days < 1 ? 1 : days;
  }

  Outing copyWith({
    String? name,
    int? amountMinor,
    String? currencyCode,
    DateTime? startAt,
    DateTime? endAt,
    Set<String>? unitIds,
    bool? bannerEnabled,
    bool? enabled,
  }) {
    return Outing(
      id: id,
      name: name ?? this.name,
      amountMinor: amountMinor ?? this.amountMinor,
      currencyCode: currencyCode ?? this.currencyCode,
      startAt: startAt ?? this.startAt,
      endAt: endAt ?? this.endAt,
      unitIds: unitIds ?? this.unitIds,
      bannerEnabled: bannerEnabled ?? this.bannerEnabled,
      enabled: enabled ?? this.enabled,
      createdAt: createdAt,
    );
  }

  /// The outing presented as a LimitRule. Every downstream consumer that
  /// already accepts a LimitRule — `LimitRule.statusFor`, `Ledger.statusFor`,
  /// `BannerContent.build`, `AlertEngine.levelFor`, `AlertText.build` —
  /// works unchanged on this.
  ///
  /// The `period` field is a placeholder (`day`): outings have no
  /// `LimitPeriod`, and no code that receives an outing's limit ever
  /// reads `period` (they read `startAt`/`endAt` from the outing they
  /// came from).
  LimitRule asLimit() => LimitRule(
    id: id,
    scope: LimitScope.overall,
    period: LimitPeriod.day,
    amountMinor: amountMinor,
    currencyCode: currencyCode,
    enabled: enabled,
  );
}
</file>

<file path="lib/domain/models/unit.dart">
import 'package:flutter/material.dart';

enum UnitKind { cash, mobileMoney, bank, card, other }

/// A pot of money the user has defined themselves: cash, mobile money,
/// a bank account, a card, or anything else, with their own name,
/// icon and colour (see design.md UNIT table; ADR-003 for currency).
class MoneyUnit {
  final String id;
  final String name;
  final UnitKind kind;

  /// Vestigial as of #114: the app has a single currency
  /// (`AppSettings.currencyCode`), and every unit is created with it and
  /// kept in step with `UnitRepository.updateAllCurrencies`. Kept on the
  /// model, the schema and the backup format so nothing churns; a screen
  /// may still read it (it drives per-unit `Money` formatting), but it is
  /// always equal to the app-wide setting.
  final String currencyCode;

  final String iconEmoji; // v0.1: emoji only; photo/icon-pack deferred
  final Color color;
  final int openingBalanceMinor;
  final int sortOrder;
  final bool archived;

  /// When the unit was archived; null when it isn't, or when the install
  /// predates the field. Presentation-only — the domain never reasons
  /// about "how long ago".
  final DateTime? archivedAt;
  final DateTime? lastVerifiedAt;
  final DateTime createdAt;

  const MoneyUnit({
    required this.id,
    required this.name,
    required this.kind,
    required this.currencyCode,
    required this.iconEmoji,
    required this.color,
    required this.openingBalanceMinor,
    required this.sortOrder,
    required this.createdAt,
    this.archived = false,
    this.archivedAt,
    this.lastVerifiedAt,
  });

  /// Sentinel for the two nullable-with-meaning fields: passing `null`
  /// explicitly means "clear it", omitting the argument means "leave it".
  /// Same trick freezed generates; without it there is no way to tell
  /// `copyWith(archivedAt: null)` from a call that didn't mention it.
  static const _unset = Object();

  MoneyUnit copyWith({
    String? name,
    String? iconEmoji,
    Color? color,
    int? sortOrder,
    bool? archived,
    Object? archivedAt = _unset,
    Object? lastVerifiedAt = _unset,
    String? currencyCode,
  }) {
    return MoneyUnit(
      id: id,
      name: name ?? this.name,
      kind: kind,
      currencyCode: currencyCode ?? this.currencyCode,
      iconEmoji: iconEmoji ?? this.iconEmoji,
      color: color ?? this.color,
      openingBalanceMinor: openingBalanceMinor,
      sortOrder: sortOrder ?? this.sortOrder,
      createdAt: createdAt,
      archived: archived ?? this.archived,
      archivedAt: identical(archivedAt, _unset)
          ? this.archivedAt
          : archivedAt as DateTime?,
      lastVerifiedAt: identical(lastVerifiedAt, _unset)
          ? this.lastVerifiedAt
          : lastVerifiedAt as DateTime?,
    );
  }
}

/// The name to show a unit by once it's been put away: "Cash (archived)".
/// Only the row labels in history use this — the unit page has its own,
/// longer notice. See Activity and the transaction detail sheet.
extension MoneyUnitDisplay on MoneyUnit {
  String get displayName => archived ? '$name (archived)' : name;
}
