<file path="test/ui/provider_error_card_test.dart">
// Issue #115: one error card, no exception text on screen.

import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:fuata/ui/theme/app_theme.dart';
import 'package:fuata/widgets/provider_error_card.dart';

void main() {
  testWidgets('shows the headline, the runtime type and a working retry',
          (tester) async {
        var retried = 0;
        await tester.pumpWidget(
          MaterialApp(
            theme: AppTheme.light(),
            home: Scaffold(
              body: ProviderErrorCard(
                headline: "Couldn't load your money right now",
                error: StateError('the database is on fire'),
                onRetry: () => retried++,
              ),
            ),
          ),
        );
        await tester.pumpAndSettle();

        expect(find.text("Couldn't load your money right now"), findsOneWidget);
        // Runtime type only — never the exception's own message, which can
        // echo the person's data.
        expect(find.text('StateError'), findsOneWidget);
        expect(find.textContaining('on fire'), findsNothing);

        await tester.tap(find.text('Try again'));
        expect(retried, 1);
      });

  testWidgets('no retry button when there is nothing to retry',
          (tester) async {
        await tester.pumpWidget(
          MaterialApp(
            theme: AppTheme.light(),
            home: Scaffold(
              body: ProviderErrorCard(
                headline: "Couldn't load your money right now",
                error: StateError('nope'),
              ),
            ),
          ),
        );
        await tester.pumpAndSettle();

        expect(find.text('Try again'), findsNothing);
        // The headline is still shown, so the person still gets the message.
        expect(find.text("Couldn't load your money right now"), findsOneWidget);
      });
}
</file>

<file path="android/app/src/main/AndroidManifest.xml">
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Issue #16: Android 13+ needs explicit permission to post the
         ongoing banner. Requested at first post (see BannerPlatform's
         _requestPermissionOnce), never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Issue #25 (US-16, ADR-009): Fuata never touches the network. The
         release build must not hold INTERNET, so strip it (and the
         connectivity-state permissions) if any plugin's manifest ever
         merges it in. Debug and profile builds add INTERNET back from
         their own manifests, which outrank this file, so hot reload
         still works. Verified on the built APK by
         scripts/verify-privacy.sh. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove"/>

    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Issue #28: minSdk is 26, so API 26-27 need the legacy permission.
     USE_BIOMETRIC (above) only covers API 28+. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27"/>

    <!-- Issue #31: reschedules the summary notifications after a reboot.
     Without this, the scheduled alarm is lost and the person only
     gets the notification again once they next open Fuata. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Issue #25: no Android auto-backup to Google Drive and no
         device-to-device transfer of the database. allowBackup covers
         Android 11 and below; dataExtractionRules covers 12+, where it
         takes over from allowBackup for transfers. The only way data
         leaves the phone is the person's own Back up & restore file. -->
    <application
        android:label="fuata"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Issue #21 share target: appear in other apps' "Share" sheets
                 for plain text, with no permission required (US-09).
                 MainActivity forwards the text to Dart over the
                 fuata/share_intake channel. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Issue #22: notification listener. Only apps on the person's
             allow-list are ever read (US-10); everything else is dropped
             in NotificationListener.kt before any text is touched.
             Requires the user to grant special access in
             Settings > Notification access; the Auto-catch screen opens
             that page directly. -->
        <service
            android:name=".NotificationListener"
            android:label="Fuata"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Issue #29: the home-screen widget. A plain AppWidgetProvider
     receiver; it reads only the cached snapshot HomeWidgetChannel
     writes (see WidgetDataStore.kt) and never touches drift. -->
        <receiver
            android:name=".FuataWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fuata_widget_info" />
        </receiver>

        <!-- Issue #31: flutter_local_notifications' boot receiver. It
     re-arms every scheduled notification after the phone reboots.
     The plugin's own manifest may already merge one of these in;
     the merger unions the intent filters, so a duplicate is
     harmless. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <!-- Issue #35: the alarm receiver and the boot re-arm. Neither is
     exported — the alarm is posted by this app's own AlarmManager, and
     the boot broadcast is delivered to the app regardless of `exported`. -->
        <receiver
            android:name=".ScheduledExportReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kinyuanexus.fuata.SCHEDULED_EXPORT_FIRE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ScheduledExportBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Issue #22: lets the Auto-catch picker list launchable apps on
             Android 11+ without QUERY_ALL_PACKAGES. Fuata never sees
             non-launchable apps and never asks for the broad permission. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
</file>

<file path="docs/testing.md">
# Testing: Fuata

**Related:** [requirements](requirements.md) (US-xx IDs), [design](design.md)

## 1. Strategy

| Level | What | How | When |
|---|---|---|---|
| Unit tests | Ledger, limit engine, parser, money helpers (pure Dart) | `flutter test` | Written with the code; **must pass before merging** |
| Widget tests | Key components (status card, transaction row) | `flutter test` | Only if time allows |
| Manual device tests | Everything involving Android: banner, listener, permissions, reboot | Checklist in section 3 on a **real device** | Thursday, before release |
| Privacy checks | No `INTERNET`, backup off, no unexpected network use | Commands in section 4 | Before tagging v0.1.0 |

**Priority rule:** ledger and limit-engine tests are never cut; everything else depends on them.

```bash
flutter analyze
flutter test
flutter test --coverage    # optional
```

## 2. Unit test plan

### Money helpers
| ID | Case | Expected |
|---|---|---|
| M-01 | Parse "1,250.50" with 2 decimals | 125050 minor units |
| M-02 | Format 125050 KES | "1,250.50" |
| M-03 | Currency with 0 decimals (e.g. JPY) | No decimal handling errors |
| M-04 | Sum of 0.10 + 0.20 as minor units | Exactly 30, no float drift |

### Ledger (US-02, US-03)
| ID | Case | Expected |
|---|---|---|
| L-01 | Unit with opening balance only | Balance = opening |
| L-02 | Add `spent` 350 | Balance decreases by 350 |
| L-03 | Add `got` 5,000 | Balance increases by 5,000 |
| L-04 | Move 2,000 from A to B | A −2,000, B +2,000, **total across units unchanged** |
| L-05 | Moved rows in spending and income totals | Excluded from both |
| L-06 | Fee as child `spent` row | Counted in spending; balance reduced by amount + fee |
| L-07 | Pending transaction | Excluded from balance and limits until confirmed |
| L-08 | Confirm a pending transaction | Balance and totals update |
| L-09 | Update balance to a new true value | Adjustment row equals the difference; balance matches |
| L-10 | Edit or delete a transaction | Balance recomputes correctly (never stale) |
| L-11 | Spending "today" across midnight boundary | Rows before/after local midnight land in the right day |
| L-12 | Archived unit | Excluded from totals but history kept |
| L-13 | Spending by day for the last 7 days | Oldest first, today last; seven entries always |
| L-14 | Moved, adjustment and pending rows in the strip | All excluded |
| L-15 | Custom day count (e.g. 3) | Length matches; oldest first |
| L-16 | 23:59 vs 00:00 the next day | Each lands on its own day |

### Limit engine (US-04, US-06)
| ID | Case | Expected |
|---|---|---|
| T-01 | Ratio 0.69 | Safe |
| T-02 | Ratio 0.70 | Warning |
| T-03 | Ratio 0.89 | Warning |
| T-04 | Ratio 0.90 | Danger |
| T-05 | Ratio 0.99 | Danger |
| T-06 | Ratio 1.00 and above | Overdraft |
| T-07 | Any unit balance below zero | Overdraft regardless of ratio |
| T-08 | No limit set | Neutral state, no alerts |
| T-09 | Per-unit limit vs overall limit | Each computed on its own scope |
| T-10 | Custom thresholds (e.g. 50/80) | Respected |
| T-11 | Week starts Monday; month is calendar month | Period boundaries correct |
| T-12 | Alert fires once per threshold per period | No repeat on the next transaction in the same band |
| T-13 | Limit and unit currencies differ | Unit excluded from the overall total |
| T-14 | One transaction jumps 50% → 105% | One "over" alert; lower levels marked used |
| T-15 | Quiet hours 22:00–07:00 | 23:00 and 06:59 quiet; 07:00 and 12:00 not; start == end never quiet |
| T-16 | Two claims for the same (limit, period, level) | Exactly one wins (drift primary key) |
| T-17 | Limit amount changed / limit deleted | Its announcements are cleared; editing levels or the switch keeps them |
| L-17 | An `occurredAt` stored as UTC (parser ISO output, a backup import) | Buckets by its **local** calendar day, not its UTC one (#109) |
### Summaries (US-12) — issue #23

| ID | Case | Expected |
|---|---|---|
| S-01 | Moved, adjustment and pending rows | Not in spent or got |
| S-02 | Summary spent vs `Ledger.spentInPeriod` | Same figure for day, week and month |
| S-03 | Sunday 23:59 vs Monday 00:00 | Sunday is last week, Monday this week |
