<file path="lib/data/constants/rule_builder_constants.dart">
import '../../domain/models/template.dart';

/// The labelable fields, palette order. Amount first deliberately: a
/// rule is useless without it, and both the palette UX and the save
/// button lean on that.
const palette = [
  (TemplateFieldType.amount, 'Amount', 'The money that moved'),
  (TemplateFieldType.code, 'Code', 'Reference like QW12ABC3'),
  (TemplateFieldType.date, 'When', 'Date and time'),
  (TemplateFieldType.person, 'Payee', 'Who or where, to or from'),
  (TemplateFieldType.balance, 'Balance', 'New balance quoted'),
  (TemplateFieldType.fee, 'Fee', 'Any charge taken'),
];

String fieldName(TemplateFieldType type) => switch (type) {
  TemplateFieldType.amount => 'Amount',
  TemplateFieldType.code => 'Code',
  TemplateFieldType.date => 'When',
  TemplateFieldType.person => 'Payee',
  TemplateFieldType.balance => 'Balance',
  TemplateFieldType.fee => 'Fee',
};

/// One whitespace-delimited run of the sample, with its offsets so a
/// label span can be built from token indices.
class WordToken {
  const WordToken(this.start, this.end, this.text);
  final int start;
  final int end; // exclusive
  final String text;
}

/// A human-readable version of what a rule will demand from a future
/// message: the sample with each labeled span replaced by
/// `xxxx(FieldName)`. Anything after the *last* labeled span is dropped,
/// because [CaptureTemplate.fromLabeledSample] ends the compiled pattern
/// at the last label — real messages vary in their tail (URLs, per-message
/// counters, "see all your balances"), and requiring an exact tail would
/// break the rule on the very next message.
///
/// Purely presentational; the compiled regex is unaffected.
String describePattern({
  required String sampleText,
  required List<LabeledSpan> labels,
}) {
  if (labels.isEmpty) return sampleText;
  final sorted = [...labels]..sort((a, b) => a.start.compareTo(b.start));
  final buffer = StringBuffer();
  var cursor = 0;
  for (final span in sorted) {
    if (span.start < cursor) continue; // defensive: overlapping span
    buffer.write(sampleText.substring(cursor, span.start));
    buffer.write('xxxx(${fieldName(span.type)})');
    cursor = span.end;
  }
  return buffer.toString();
}
</file>

<file path="lib/domain/logic/alert_engine.dart">
// ---------------------------------------------------------------------------
// Deciding which limit alerts are due (issue #63, US-06).
//
// Pure functions, no I/O: given the limits, the transactions and what has
// already been shown, say what should be shown now. The same function runs
// in the UI isolate and in the notification listener's background isolate
// (via alert_service.dart), so an alert never depends on which of the two
// happened to see a transaction first.
//
// Rules (requirements.md US-06, ui-design-brief.md 7.8):
//  * One alert per limit per evaluation, for the *highest* level crossed
//    and not yet shown this period. Jumping from 50% to 105% shows "over",
//    not three notifications.
//  * Each (limit, period, level) fires at most once. Spending less again
//    (a deleted transaction) and re-crossing does not re-fire.
//  * A disabled limit never alerts.
// ---------------------------------------------------------------------------

import '../models/limit_alert.dart';
import '../models/limit_rule.dart';
import '../models/money.dart';
import '../models/transaction.dart';
import '../models/unit.dart';
import 'ledger.dart';

class AlertEngine {
  AlertEngine._();

  /// Identifies the period a limit is currently measuring, so "once per
  /// period" has something to key on: the date for a day, the Monday's
  /// date for a week (Monday-start, matching [Ledger.weekRange]), and
  /// year-month for a month.
  static String periodKey(LimitPeriod period, DateTime now) {
    String two(int n) => n.toString().padLeft(2, '0');
    final (start, _) = rangeFor(period, now);
    return switch (period) {
      LimitPeriod.day || LimitPeriod.week =>
      '${start.year}-${two(start.month)}-${two(start.day)}',
      LimitPeriod.month => '${start.year}-${two(start.month)}',
    };
  }

  static (DateTime, DateTime) rangeFor(LimitPeriod period, DateTime now) =>
      switch (period) {
        LimitPeriod.day => Ledger.todayRange(now),
        LimitPeriod.week => Ledger.weekRange(now),
        LimitPeriod.month => Ledger.monthRange(now),
      };

  /// The level [spentMinor] has reached on [limit], or null below the
  /// first threshold. Mirrors [LimitRule.statusFor] exactly, so the
  /// banner's emoji and the alert level can never disagree.
  static AlertLevel? levelFor(LimitRule limit, int spentMinor) =>
      switch (limit.statusFor(spentMinor)) {
        SpendStatus.safe => null,
        SpendStatus.warning => AlertLevel.warning,
        SpendStatus.danger => AlertLevel.danger,
        SpendStatus.overdraft => AlertLevel.overdraft,
      };

  /// What is due right now. [fired] is everything already shown.
  ///
  /// Overall limits count spending in the limit's own currency (design.md
  /// LIMIT_RULE, T-13): a KES limit is not eaten by USD spending. A
  /// transaction whose unit isn't in [units] (an archived one) is still
  /// counted, matching how Home and the banner treat archived history.
  /// Per-unit limits count that unit only, and are skipped when the unit
  /// is gone or archived.
  static List<LimitAlert> due({
    required List<LimitRule> limits,
    required List<MoneyUnit> units,
    required Iterable<MoneyTransaction> transactions,
    required Set<AlertKey> fired,
    required DateTime now,
  }) {
    final unitsById = {for (final u in units) u.id: u};
    final currencyOf = {for (final u in units) u.id: u.currencyCode};
    final out = <LimitAlert>[];

    for (final limit in limits) {
      if (!limit.enabled || limit.amountMinor <= 0) continue;

      String? unitName;
      String? unitId;
      if (limit.scope == LimitScope.unit) {
        final unit = unitsById[limit.unitId];
        if (unit == null || unit.archived) continue;
        unitName = unit.name;
        unitId = unit.id;
      }

      final (from, to) = rangeFor(limit.period, now);
      final counted = unitId != null
          ? transactions
          : transactions.where((t) {
        final code = currencyOf[t.unitId];
        return code == null || code == limit.currencyCode;
      });
      final spent = Ledger.spentInPeriod(counted, from, to, unitId: unitId);
      final level = levelFor(limit, spent);
      if (level == null) continue;

      final key = periodKey(limit.period, now);
      if (fired.contains(AlertKey(limit.id, key, level))) continue;

      out.add(LimitAlert(
        limit: limit,
        level: level,
        periodKey: key,
        spentMinor: spent,
        unitName: unitName,
      ));
    }
    return out;
  }
}

/// Quiet hours (ui-design-brief.md 7.8): a daily window in which alerts
/// still arrive, but without sound or a heads-up. Minutes after local
/// midnight; the window may wrap midnight (22:00 -> 07:00).
class QuietHours {
  QuietHours._();

  /// An empty window (start == end) is "never quiet", not "always quiet":
  /// silencing every alert because two pickers match would be a nasty
  /// surprise.
  static bool contains({
    required int startMinute,
    required int endMinute,
    required DateTime at,
  }) {
    if (startMinute == endMinute) return false;
    final m = at.hour * 60 + at.minute;
    if (startMinute < endMinute) return m >= startMinute && m < endMinute;
    return m >= startMinute || m < endMinute; // wraps midnight
  }
}

/// The words on an alert notification (ui-design-brief.md 7.10: "Easy now:
/// you've used 80% of today.").
class AlertText {
  AlertText._();

  static ({String title, String body}) build(LimitAlert a) {
    final limit = a.limit;
    final period = switch (limit.period) {
      LimitPeriod.day => "today's",
      LimitPeriod.week => "this week's",
      LimitPeriod.month => "this month's",
    };
    final where = a.unitName == null ? '' : ' on ${a.unitName}';
    final percent = limit.amountMinor <= 0
        ? 0
        : (a.spentMinor * 100 / limit.amountMinor).floor();

    return switch (a.level) {
      AlertLevel.warning => (
      title: '${a.level.status.emoji} Easy now',
      body: "You've used $percent% of $period limit$where.",
      ),
      AlertLevel.danger => (
      title: '${a.level.status.emoji} Almost at your limit',
      body: "You've used $percent% of $period limit$where.",
      ),
      AlertLevel.overdraft => (
      title: "${a.level.status.emoji} You're over",
      body: "You're over $period limit$where by "
          '${Money(a.spentMinor - limit.amountMinor, limit.currencyCode).format()}.',
      ),
    };
  }
}
</file>

<file path="lib/domain/logic/alert_service.dart">
// ---------------------------------------------------------------------------
// Claiming the alerts that are due (issue #63, US-06).
//
// Depends only on repository interfaces, so — like banner_loader.dart — it
// runs unchanged in the UI isolate and in the notification listener's
// background isolate.
//
// "Claim" is the important word. Both isolates can notice the same
// transaction at nearly the same moment (the background isolate writes it,
// the UI isolate's streams then fire). Each one asks the log to claim the
// alert *before* showing it; the log grants a claim to exactly one caller,
// so a limit crossed once is announced once.
// ---------------------------------------------------------------------------

import '../models/limit_alert.dart';
import '../repositories/repositories.dart';
import 'alert_engine.dart';

class AlertBatch {
  /// Alerts this caller has claimed and must now show.
  final List<LimitAlert> alerts;

  /// True inside quiet hours: show them, but without sound or a heads-up.
  final bool quiet;

  /// Mirrors the person's lock-screen privacy choice.
  final bool redactOnLockScreen;

  const AlertBatch({
    required this.alerts,
    required this.quiet,
    required this.redactOnLockScreen,
  });

  static const none = AlertBatch(
    alerts: [],
    quiet: false,
    redactOnLockScreen: true,
  );
}

/// How long a firing record is kept. Only the current period matters for
/// "once per period"; older rows are just clutter.
const alertLogRetention = Duration(days: 90);

Future<AlertBatch> claimDueAlerts({
  required UnitRepository units,
  required TransactionRepository transactions,
  required LimitRepository limits,
  required SettingsRepository settings,
  required AlertLogRepository log,
  DateTime Function()? now,
}) async {
  final clock = now ?? DateTime.now;
  final s = await settings.watchSettings().first;
  if (!s.alertsEnabled) return AlertBatch.none;

  final at = clock();
  final due = AlertEngine.due(
    limits: await limits.watchLimits().first,
    units: await units.watchUnits().first,
    transactions: await transactions.watchTransactions().first,
    fired: await log.firedKeys(),
    now: at,
  );
  if (due.isEmpty) return AlertBatch.none;

  final claimed = <LimitAlert>[];
  for (final alert in due) {
    // Claim every level this alert uses up, top level last: the top one
    // decides whether *we* won. Lower levels are recorded so a nudge
    // can't turn up after an "over" for the same limit and period.
    for (final key in alert.consumedKeys.where((k) => k != alert.key)) {
      await log.claim(key, at);
    }
    if (await log.claim(alert.key, at)) claimed.add(alert);
  }

  if (claimed.isNotEmpty) await log.purgeBefore(at.subtract(alertLogRetention));

  return AlertBatch(
    alerts: claimed,
    quiet: s.quietHoursEnabled &&
        QuietHours.contains(
          startMinute: s.quietStartMinute,
          endMinute: s.quietEndMinute,
          at: at,
        ),
    redactOnLockScreen: s.redactedLockScreenBanner,
  );
}
</file>

<file path="lib/domain/logic/banner_content.dart">
// ---------------------------------------------------------------------------
// What the notification banner says (issues #16 / #17, US-05,
// ui-design-brief.md 7.9-7.10).
//
// Pure Dart, no widgets: the banner setup screen's live preview (#17) and
// the real ongoing notification (#16) both call BannerContent.build(), so
// what the person sees in the preview is exactly what Android will show.
// ---------------------------------------------------------------------------

import '../models/limit_rule.dart';
import '../models/money.dart';
import '../models/settings.dart';
import '../models/unit.dart';

class BannerContent {
  final SpendStatus status;

  /// Collapsed headline, e.g. "🟢 1,500 left today".
  final String title;

  /// 0..1 share of today's limit used; null when hidden or no daily limit.
  final double? progress;

  /// Expanded body: one "Cash 760" entry per shown unit (empty when redacted).
  final List<String> unitLines;

  /// Expanded body: "Spent today 1,500" (null when redacted).
  final String? spentLine;

  final bool showQuickAdd;

  const BannerContent({
    required this.status,
    required this.title,
    required this.progress,
    required this.unitLines,
    required this.spentLine,
    required this.showQuickAdd,
  });

  static BannerContent build({
    required SpendStatus status,
    required int spentToday,
    required LimitRule? dailyLimit,
    required List<MoneyUnit> units,
    required Map<String, int> balanceByUnit,
    required BannerHeadline headline,
    required Set<String> selectedUnitIds, // empty = every unit
    required bool showProgress,
    required bool showQuickAdd,
    required bool redacted,

}) {
    final active = units.where((u) => !u.archived).toList();
    final shown = active
        .where((u) => selectedUnitIds.isEmpty || selectedUnitIds.contains(u.id))
        .toList();

    final code =
        dailyLimit?.currencyCode ??
            (active.isEmpty ? 'KES' : active.first.currencyCode);
    String fmt(int minor) => Money(minor, code).format();

    final emoji = status.emoji;
    final left = dailyLimit == null ? null : dailyLimit.amountMinor - spentToday;

    final String title;
    if (redacted) {
// Lock-screen version: words only, never an amount.
      title = '$emoji ${status.label}';
    } else {
switch(headline) {
  case BannerHeadline.leftToday:
    if (left == null) {
      title = '$emoji Spent ${fmt(spentToday)} today';
    } else if (left < 0) {
      title = '$emoji Over by ${fmt(-left)}';
    } else if (left == 0) {
      title = '$emoji Nothing left today';
    } else {
      title = '$emoji ${fmt(left)} left today';
    }
  case BannerHeadline.spentToday:
    title = '$emoji Spent ${fmt(spentToday)} today';
  case BannerHeadline.totalIHave:
  // Only units in the banner's currency are summed: adding KES to
  // USD would be a made-up number.
    final total = shown
        .where((u) => u.currencyCode == code)
        .fold<int>(0, (sum, u) => sum + (balanceByUnit[u.id] ?? 0));
    title = '$emoji ${fmt(total)} in total';
}
    }

    double? progress;
    if (showProgress && dailyLimit != null && dailyLimit.amountMinor > 0) {
      progress = (spentToday / dailyLimit.amountMinor).clamp(0.0, 1.0);
    }

    return BannerContent(
      status: status,
      title: title,
      progress: progress,
      unitLines: redacted
          ? const []
          : [
        for (final u in shown)
          '${u.name} ${Money(balanceByUnit[u.id] ?? 0, u.currencyCode).format()}',
      ],
      spentLine: redacted ? null : 'Spent today ${fmt(spentToday)}',
      showQuickAdd: showQuickAdd,
    );
  }
}
