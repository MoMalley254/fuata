package com.kinyuanexus.fuata

import android.content.Context
import android.net.Uri
import android.provider.DocumentsContract

/**
 * Shared SAF-tree file logic for scheduled export (issue #35). Both the
 * UI channel (for the "Run now" button) and the background channel (for
 * the scheduled run) delegate here, so there is exactly one place that
 * knows how a Fuata file gets written into a chosen folder.
 */
object FolderWriter {

    fun hasPersistedPermission(context: Context, uri: Uri): Boolean {
        return context.contentResolver.persistedUriPermissions.any {
            it.uri == uri && it.isWritePermission
        }
    }

    fun displayName(context: Context, folderUri: Uri): String? = try {
        val docUri = DocumentsContract.buildDocumentUriUsingTree(
            folderUri,
            DocumentsContract.getTreeDocumentId(folderUri),
        )
        context.contentResolver.query(
            docUri,
            arrayOf(DocumentsContract.Document.COLUMN_DISPLAY_NAME),
            null, null, null,
        )?.use { c -> if (c.moveToFirst()) c.getString(0) else null }
    } catch (_: Exception) {
        null
    }

    /**
     * Writes [content] to a new file named [filename] inside [folderUri].
     * Timestamped filenames (see scheduledExportFileName in Dart) mean
     * collisions are essentially impossible; if one does occur, delete
     * the existing file and retry, which is the one time we're willing to
     * lose data — a "same-second" retry after a visible failure is more
     * useful than refusing forever.
     */
    fun write(
        context: Context,
        folderUri: Uri,
        filename: String,
        content: String,
    ): Boolean = try {
        val resolver = context.contentResolver
        val parentDoc = DocumentsContract.buildDocumentUriUsingTree(
            folderUri,
            DocumentsContract.getTreeDocumentId(folderUri),
        )
        var target = tryCreate(resolver, parentDoc, filename)
        if (target == null) {
            // Provider says the name is taken: delete and retry once.
            findChild(resolver, folderUri, filename)?.let {
                try { DocumentsContract.deleteDocument(resolver, it) } catch (_: Exception) {}
            }
            target = tryCreate(resolver, parentDoc, filename)
        }
        if (target == null) return false
        resolver.openOutputStream(target, "wt")?.use {
            it.write(content.toByteArray(Charsets.UTF_8))
        } ?: return false
        true
    } catch (_: Exception) {
        false
    }

    private fun tryCreate(
        resolver: android.content.ContentResolver,
        parentDoc: Uri,
        filename: String,
    ): Uri? = try {
        DocumentsContract.createDocument(
            resolver, parentDoc, "application/octet-stream", filename,
        )
    } catch (_: Exception) {
        null
    }

    private fun findChild(
        resolver: android.content.ContentResolver,
        folderUri: Uri,
        filename: String,
    ): Uri? {
        val treeDocId = DocumentsContract.getTreeDocumentId(folderUri)
        val childrenUri =
            DocumentsContract.buildChildDocumentsUriUsingTree(folderUri, treeDocId)
        resolver.query(
            childrenUri,
            arrayOf(
                DocumentsContract.Document.COLUMN_DOCUMENT_ID,
                DocumentsContract.Document.COLUMN_DISPLAY_NAME,
            ),
            null, null, null,
        )?.use { c ->
            while (c.moveToNext()) {
                if (c.getString(1) == filename) {
                    return DocumentsContract.buildDocumentUriUsingTree(
                        folderUri, c.getString(0),
                    )
                }
            }
        }
        return null
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/FuataWidgetProvider.kt">
package com.kinyuanexus.fuata

import android.app.PendingIntent
import android.appwidget.AppWidgetManager
import android.appwidget.AppWidgetProvider
import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.os.Bundle
import android.view.View
import android.widget.RemoteViews

/**
 * The home-screen widget (issue #29): a small at-a-glance card matching
 * the notification banner — status emoji, big number, caption, optional
 * progress bar. Tap opens the app.
 *
 * A plain BroadcastReceiver: it runs in the app process, has no Flutter
 * engine, and reads only what HomeWidgetChannel last wrote to
 * WidgetDataStore. Every render is the same code path, so an update from
 * Dart and an update from the launcher's own periodic refresh look
 * identical.
 *
 * Colours come from @color / @color-night resources rather than Flutter's
 * ThemeExtension — RemoteViews can't read Flutter-side state, and the
 * status colour is the only thing that changes with the data.
 */
class FuataWidgetProvider : AppWidgetProvider() {

    override fun onUpdate(
        context: Context,
        manager: AppWidgetManager,
        ids: IntArray,
    ) {
        val snapshot = WidgetDataStore.read(context)
        for (id in ids) {
            manager.updateAppWidget(id, buildViews(context, id, snapshot))
        }
    }

    override fun onAppWidgetOptionsChanged(
        context: Context,
        manager: AppWidgetManager,
        id: Int,
        newOptions: Bundle,
    ) {
        // A resize can change the variant: re-render so the split line
        // appears or disappears with the cell width (issue #113).
        manager.updateAppWidget(
            id,
            buildViews(context, id, WidgetDataStore.read(context)),
        )
    }

    private fun buildViews(
        context: Context,
        id: Int,
        snapshot: WidgetDataStore.Snapshot?,
    ): RemoteViews {
        val views = RemoteViews(context.packageName, R.layout.fuata_widget)

        if (snapshot == null) {
            views.setTextViewText(R.id.widget_emoji, "👋")
            views.setTextViewText(R.id.widget_amount, "—")
            views.setTextViewText(R.id.widget_currency, "")
            views.setTextViewText(R.id.widget_caption, "open Fuata")
            views.setViewVisibility(R.id.widget_progress, View.GONE)
            views.setViewVisibility(R.id.widget_split_line, View.GONE)
        } else {
            views.setTextViewText(R.id.widget_emoji, snapshot.emoji)
            views.setTextViewText(R.id.widget_amount, snapshot.amount)
            views.setTextViewText(R.id.widget_currency, snapshot.currency)
            views.setTextViewText(R.id.widget_caption, snapshot.caption)
            views.setTextColor(R.id.widget_caption, statusColour(context, snapshot.status))

            if (snapshot.progress in 0.0..1.0) {
                views.setViewVisibility(R.id.widget_progress, View.VISIBLE)
                views.setInt(
                    R.id.widget_progress,
                    "setProgress",
                    (snapshot.progress * 100).toInt(),
                )
            } else {
                views.setViewVisibility(R.id.widget_progress, View.GONE)
            }

            if (shouldShowSplit(context, id, snapshot)) {
                views.setViewVisibility(R.id.widget_split_line, View.VISIBLE)
                views.setTextViewText(R.id.widget_split_line, snapshot.splitLine)
            } else {
                views.setViewVisibility(R.id.widget_split_line, View.GONE)
            }
        }

        val launch = context.packageManager
            .getLaunchIntentForPackage(context.packageName)
            ?.apply {
                flags = Intent.FLAG_ACTIVITY_NEW_TASK or
                        Intent.FLAG_ACTIVITY_CLEAR_TOP
            }
        if (launch != null) {
            val pending = PendingIntent.getActivity(
                context,
                0,
                launch,
                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
            )
            views.setOnClickPendingIntent(R.id.widget_root, pending)
        }

        return views
    }

    /**
     * Whether this instance shows the split line. A forced variant wins;
     * `auto` uses the minimum width the launcher reports, so a 2-cell
     * widget stays compact and a 3-cell one gets the split. The split
     * line is empty when the person switched it off or no unit is in the
     * widget's currency, and empty means hide.
     */
    private fun shouldShowSplit(
        context: Context,
        id: Int,
        snapshot: WidgetDataStore.Snapshot,
    ): Boolean {
        if (snapshot.splitLine.isEmpty()) return false
        return when (snapshot.variant) {
            "compact" -> false
            "rich" -> true
            else -> {
                val options = AppWidgetManager.getInstance(context)
                    .getAppWidgetOptions(id)
                val widthDp = options.getInt(
                    AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH,
                )
                widthDp >= RICH_MIN_WIDTH_DP
            }
        }
    }

    private fun statusColour(context: Context, status: String): Int =
        context.getColor(
            when (status) {
                "warning" -> R.color.status_warning
                "danger" -> R.color.status_danger
                "overdraft" -> R.color.status_overdraft
                else -> R.color.status_safe
            },
        )

    companion object {
        /** Called from HomeWidgetChannel after every Dart-side write. */
        /// Below this width (dp) the auto variant stays compact: the split
        /// line would either wrap or shrink to unreadable. Matches
        /// fuata_widget_info.xml's targetCellWidth of 3 — a two-cell
        /// widget is about 140-160 dp on most launchers, a three-cell one
        /// about 210-240.
        private const val RICH_MIN_WIDTH_DP = 200
        fun refreshAll(context: Context) {
            val manager = AppWidgetManager.getInstance(context)
            val ids = manager.getAppWidgetIds(
                ComponentName(context, FuataWidgetProvider::class.java),
            )
            if (ids.isEmpty()) return
            val intent = Intent(context, FuataWidgetProvider::class.java).apply {
                action = AppWidgetManager.ACTION_APPWIDGET_UPDATE
                putExtra(AppWidgetManager.EXTRA_APPWIDGET_IDS, ids)
            }
            context.sendBroadcast(intent)
        }
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/HomeWidgetChannel.kt">
package com.kinyuanexus.fuata

import android.content.Context
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.MethodChannel

/**
 * `fuata/home_widget` channel: issue #29. Dart pushes a small data
 * snapshot; this writes it and asks the widget provider to redraw.
 *
 *  - `update {amount, currency, caption, progress, emoji, status}` -> null
 *  - `clear`                                                       -> null
 */
class HomeWidgetChannel(
    private val context: Context,
    messenger: BinaryMessenger,
) {
    private val channel = MethodChannel(messenger, CHANNEL)

    init {
        channel.setMethodCallHandler { call, result ->
            when (call.method) {
                "update" -> {
                    val args = call.arguments as? Map<*, *>
                    if (args == null) {
                        result.error("bad_args", "Expected a map", null)
                        return@setMethodCallHandler
                    }
                    @Suppress("UNCHECKED_CAST")
                    WidgetDataStore.write(context, args as Map<String, Any?>)
                    FuataWidgetProvider.refreshAll(context)
                    result.success(null)
                }

                "clear" -> {
                    WidgetDataStore.clear(context)
                    FuataWidgetProvider.refreshAll(context)
                    result.success(null)
                }

                else -> result.notImplemented()
            }
        }
    }

    fun dispose() {
        channel.setMethodCallHandler(null)
    }

    companion object {
        const val CHANNEL = "fuata/home_widget"
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/MainActivity.kt">
package com.kinyuanexus.fuata

import android.content.Intent
// Issue #28: FlutterFragmentActivity, not FlutterActivity — local_auth
// drives AndroidX BiometricPrompt, which requires its host to be a
// FragmentActivity. On a plain Activity it fails with
// uiUnavailable/"the current activity must be a FragmentActivity".
// FlutterFragmentActivity is the same Flutter delegate in a Fragment
// host, so every channel below is unaffected.
import io.flutter.embedding.android.FlutterFragmentActivity
import io.flutter.embedding.engine.FlutterEngine

/**
 * Hosts the UI engine and wires its native channels:
 *  - `fuata/share_intake` (issue #21): text shared in from other apps.
 *  - `fuata/capture` (issue #22): notification-access status, the
 *    allow-list mirror, the installed-apps picker, and the "captures
 *    changed" ping. Replaces the #18 spike's `fuata/listener_spike`.
 *  - `fuata/backup_files` (issue #24): save / open a JSON backup through
 *    the system file picker.
 */
class MainActivity : FlutterFragmentActivity() {
    private var shareIntake: ShareIntakeChannel? = null
    private var captureChannel: CaptureChannel? = null
    private var backupFiles: BackupFilesChannel? = null

    private var homeWidget: HomeWidgetChannel? = null

    private var privacy: PrivacyChannel? = null   // issue #84

    private var scheduledExport: ScheduledExportChannel? = null  // #35

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)

        captureChannel = CaptureChannel(
            applicationContext,
            flutterEngine.dartExecutor.binaryMessenger,
        )

        // Issue #84: takes `this` — the window flag is on this Activity's
        // window, not on the application context.
        privacy = PrivacyChannel(
            this,
            flutterEngine.dartExecutor.binaryMessenger,
        )

        homeWidget = HomeWidgetChannel(
            applicationContext,
            flutterEngine.dartExecutor.binaryMessenger,
        )

        shareIntake = ShareIntakeChannel(flutterEngine.dartExecutor.binaryMessenger)

        backupFiles = BackupFilesChannel(
            this,
            flutterEngine.dartExecutor.binaryMessenger,
        )

        scheduledExport = ScheduledExportChannel(
            this, flutterEngine.dartExecutor.binaryMessenger,
        )

        // The intent that started (or restarted) this activity may be a
        // share; route it now that the channel exists.
        shareIntake?.handleShareIntent(intent)
    }

    override fun cleanUpFlutterEngine(flutterEngine: FlutterEngine) {
        captureChannel?.dispose()
        captureChannel = null
        privacy?.dispose()
        privacy = null
        homeWidget?.dispose()
        homeWidget = null
        backupFiles?.dispose()
        backupFiles = null
        scheduledExport?.dispose()
        scheduledExport = null
        super.cleanUpFlutterEngine(flutterEngine)
    }

    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        // Our picker results are consumed here; everything else (plugins)
        // goes on to Flutter's own handling.
        if (backupFiles?.handleActivityResult(requestCode, resultCode, data) == true) return
        if (scheduledExport?.handleActivityResult(requestCode, resultCode, data) == true) return
        super.onActivityResult(requestCode, resultCode, data)
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        // singleTop: shares into a running activity arrive here.
        shareIntake?.handleShareIntent(intent)
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/NotificationListener.kt">
package com.kinyuanexus.fuata

import android.util.Log
import android.app.Notification
import android.service.notification.NotificationListenerService
import android.service.notification.StatusBarNotification

/**
 * Issue #22 — the real listener; replaces the #18 spike.
 *
 * The privacy gate is the first thing that happens: a notification from
 * any app that is not on the person's allow-list is dropped right here —
 * no text is read, no engine is started, nothing is stored (US-10,
 * requirements.md Privacy row). Only allow-listed notifications continue,
 * and even then their text goes straight to the capture pipeline in
 * memory; only what the parser extracts, or an unreadable message the
 * person can teach Fuata to read, is ever written.
 *
 * design.md 5.1: on some phones (confirmed on MIUI) this service is only
 * bound after the notification-access switch is toggled off and on in
 * Android's own settings screen. The Auto-catch screen says so.
 */
class NotificationListener : NotificationListenerService() {

    override fun onNotificationPosted(sbn: StatusBarNotification) {
        Log.d("fuata_capture", "onNotificationPosted pkg=${sbn.packageName}")
        val packageName = sbn.packageName ?: return

        // Never read our own notifications (the banner, #16).
        if (packageName == applicationContext.packageName) return

        // The gate. Everything below only runs for allowed apps.
        if (!CaptureStore.isAllowed(applicationContext, packageName)) return

        val notification = sbn.notification ?: return

        // A group summary is a container for children the app posts as
        // separate notifications (Android's bundling contract); reading it
        // would just produce unreadable "3 new messages" entries.
        if ((notification.flags and Notification.FLAG_GROUP_SUMMARY) != 0) return

        val text = NotificationText.extract(notification) ?: return

        CaptureEngine.submit(applicationContext, packageName, text)
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/NotificationText.kt">
package com.kinyuanexus.fuata

import android.app.Notification

/**
 * Pulls the message text out of a notification (issue #22).
 *
 * Fixes the known gap from the #18 spike (design.md 5.1): the spike's
 * text ended up as `sbn.tag` on one device. This walks the notification's
 * own extras in a fixed, documented order and never touches `sbn.tag` or
 * `sbn.key` — those identify the notification, they are not its content.
 *
 * Order (first non-blank wins):
 *  1. EXTRA_BIG_TEXT    — the expanded body; the full message when the
 *                         app supplies one (usually the least truncated)
 *  2. EXTRA_TEXT        — the collapsed body
 *  3. EXTRA_TEXT_LINES  — inbox-style lines, joined with newlines
 *  4. EXTRA_SUB_TEXT    — secondary line
 *  5. tickerText        — legacy one-liner
 *  6. EXTRA_TITLE       — last resort: some apps put the whole message in
 *                         the title. It is NOT prepended to the body, so
 *                         the parser sees the same text a pasted SMS gives.
 *
 * The result is handed to Dart in memory only. It is never logged.
 */
object NotificationText {

    fun extract(notification: Notification): String? {
        val extras = notification.extras
        val candidates = sequenceOf(
            extras?.getCharSequence(Notification.EXTRA_BIG_TEXT),
            extras?.getCharSequence(Notification.EXTRA_TEXT),
            joinLines(extras?.getCharSequenceArray(Notification.EXTRA_TEXT_LINES)),
            extras?.getCharSequence(Notification.EXTRA_SUB_TEXT),
            notification.tickerText,
            extras?.getCharSequence(Notification.EXTRA_TITLE),
        )
        return candidates
            .mapNotNull { it?.toString()?.trim() }
            .firstOrNull { it.isNotEmpty() }
    }

    private fun joinLines(lines: Array<CharSequence>?): CharSequence? {
        if (lines == null || lines.isEmpty()) return null
        return lines.joinToString("\n") { it.toString() }
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/PrivacyChannel.kt">
package com.kinyuanexus.fuata

import android.app.Activity
import android.view.WindowManager
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.MethodChannel

/**
 * `fuata/privacy` channel: issue #84, finding F20.
 *
 * One thing: set or clear `WindowManager.LayoutParams.FLAG_SECURE` on the
 * Activity's window. While set, Android blocks screenshots and screen
 * recording, and shows a blank card for Fuata in the app switcher. That's
 * the whole feature — the toggle in Settings stores the person's choice,
 * and this is what tells Android about it.
 *
 * Takes the Activity rather than the application context (unlike
 * CaptureChannel): the window flag lives on a specific Activity's window,
 * and there is no way to reach it from an application context.
 *
 * applySecure is idempotent. Re-sending the same value is a no-op, so the
 * Dart side can push on every settings emission without churning the
 * window, which is noticeable as a flicker on some devices.
 */
class PrivacyChannel(
    private val activity: Activity,
    messenger: BinaryMessenger,
) {
    private val channel = MethodChannel(messenger, CHANNEL)
    private var lastValue: Boolean? = null

    init {
        channel.setMethodCallHandler { call, result ->
            when (call.method) {
                "setSecure" -> {
                    val secure = call.arguments as? Boolean
                    if (secure == null) {
                        result.error("bad_args", "Expected true or false", null)
                        return@setMethodCallHandler
                    }
                    applySecure(secure)
                    result.success(null)
                }

                // Read-only, for tests and for anything that wants to know
                // what the OS currently has without changing it.
                "isSecure" -> result.success(lastValue ?: false)

                else -> result.notImplemented()
            }
        }
    }

    /**
     * Sets or clears FLAG_SECURE on the window. Field writes go through
     * `lastValue` so a caller that pushes the same value twice doesn't
     * touch the window at all.
     */
    private fun applySecure(secure: Boolean) {
        if (lastValue == secure) return
        lastValue = secure
        if (secure) {
            activity.window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
        } else {
            activity.window.clearFlags(WindowManager.LayoutParams.FLAG_SECURE)
        }
    }

    fun dispose() {
        channel.setMethodCallHandler(null)
        lastValue = null
    }

    companion object {
        const val CHANNEL = "fuata/privacy"
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/ScheduledExportBackgroundChannel.kt">
package com.kinyuanexus.fuata

import android.content.Context
import android.net.Uri
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.MethodChannel

/**
 * `fuata/scheduled_export_bg` — the background isolate's channel
 * (issue #35). Three methods only, all application-context-only; the
 * folder picker and any intent-launching live on the UI channel.
 *
 *  backgroundIsolateReady                        -> null
 *  saveToFolder {uri, filename, content}        -> bool
 *  reportResult {success, error?}               -> null
 */
class ScheduledExportBackgroundChannel(
    private val context: Context,
    messenger: BinaryMessenger,
    private val onFinished: () -> Unit,
) {
    private val channel = MethodChannel(messenger, CHANNEL)

    init {
        channel.setMethodCallHandler { call, result ->
            when (call.method) {
                "backgroundIsolateReady" -> result.success(null)
                "saveToFolder" -> {
                    val m = call.arguments as? Map<*, *>
                    val uri = (m?.get("uri") as? String)?.let(Uri::parse)
                    val name = m?.get("filename") as? String
                    val content = m?.get("content") as? String
                    if (uri == null || name == null || content == null) {
                        result.error("bad_args", "uri, filename and content required", null)
                        return@setMethodCallHandler
                    }
                    Thread {
                        val ok = FolderWriter.write(context, uri, name, content)
                        result.success(ok)
                    }.start()
                }
                "reportResult" -> {
                    val m = call.arguments as? Map<*, *>
                    val success = (m?.get("success") as? Boolean) ?: false
                    val error = m?.get("error") as? String
                    ScheduledExportEngine.recordRun(context, success, error)
                    result.success(null)
                    onFinished()
                }
                else -> result.notImplemented()
            }
        }
    }

    fun dispose() {
        channel.setMethodCallHandler(null)
    }

    companion object {
        const val CHANNEL = "fuata/scheduled_export_bg"
    }
}
</file>

