<file path="lib/platform/share_intake.dart">
import 'dart:async';

import 'package:flutter/services.dart';
import 'package:fuata/data/constants/method_channels_constants.dart';

final _channel = MethodChannel(shareIntakeMethodName);
final _sharedText = StreamController<String>.broadcast();
final _queue = <String>[];

/// Text that arrived before anyone was listening (cold start from the
/// share sheet). Drained once by RootShell's initState.
String? _pendingInitialText;

Stream<String> get sharedTextStream => _sharedText.stream;

Future<void> initShareIntake() async {
  _channel.setMethodCallHandler((call) async {
    if (call.method == 'onSharedText') {
      _add(call.arguments);
    }
    return null;
  });
  try {
    final initial = await _channel.invokeMethod<dynamic>('getSharedText');
    if (initial is String && initial.trim().isNotEmpty) {
      // No listener yet — stash it; RootShell will drain it in initState.
      _pendingInitialText = initial.trim();
    }
  } on PlatformException {
    // Older builds / widget tests have no native side.
  }
}

/// Returns and clears text stashed before listeners attached.
String? consumePendingSharedText() {
  final t = _pendingInitialText;
  _pendingInitialText = null;
  return t;
}

void _add(dynamic text) {
  if (text is! String) return;
  final trimmed = text.trim();
  if (trimmed.isEmpty) return;
  if (!_sharedText.hasListener) {
    _queue.add(trimmed);
    return;
  }
  _sharedText.add(trimmed);
}

/// Called by RootShell after it subscribes — replays anything that
/// arrived before the UI was ready.
List<String> drainShareQueue() {
  final out = List<String>.from(_queue);
  _queue.clear();
  return out;
}
</file>

<file path="lib/platform/widget_bridge.dart">
// ---------------------------------------------------------------------------
// Pushing the widget's snapshot to native (issue #29). One-way: the
// widget provider reads what this wrote and never talks back. A no-op
// when there's no native side (widget tests, non-Android), so callers
// don't have to guard.
// ---------------------------------------------------------------------------

import 'package:flutter/services.dart';

import '../data/constants/method_channels_constants.dart';
import '../domain/logic/widget_content.dart';

abstract class HomeWidgetBridge {
  Future<void> push(WidgetSnapshot snapshot);

  /// Clears the cached snapshot; the widget falls back to its
  /// "open Fuata" empty state on next render. Used when the app is
  /// erased or the person asks to hide the widget's numbers.
  Future<void> clear();
}

class AndroidHomeWidgetBridge implements HomeWidgetBridge {
  AndroidHomeWidgetBridge()
      : _channel = const MethodChannel(homeWidgetMethodName);
  final MethodChannel _channel;

  @override
  Future<void> push(WidgetSnapshot snapshot) async {
    try {
      await _channel.invokeMethod<void>('update', snapshot.toJson());
    } on MissingPluginException {
      // Widget tests / non-Android: no native side.
    } on PlatformException {
      // A widget that fails to update is not the app's problem; the
      // next push or the launcher's own 30-minute refresh will retry.
    }
  }

  @override
  Future<void> clear() async {
    try {
      await _channel.invokeMethod<void>('clear');
    } on MissingPluginException {
      // no native side
    } on PlatformException {
      // as above
    }
  }
}
</file>

