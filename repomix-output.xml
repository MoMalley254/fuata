<file path="lib/domain/logic/banner_loader.dart">
// ---------------------------------------------------------------------------
// Loading what the ongoing banner needs (issue #16). Depends only on
// repository interfaces, so the same function runs in the UI isolate
// (via banner_providers.dart) and in the notification listener's
// background isolate (via platform/notification_capture.dart) — the
// banner a person sees can never disagree with what the parser wrote.
// ---------------------------------------------------------------------------

import '../models/limit_rule.dart';
import '../repositories/repositories.dart';
import 'banner_content.dart';
import 'ledger.dart';

/// Returns the content the banner should show, or null when the banner
/// is switched off in settings (in which case the caller should cancel
/// any stale one).
///
/// [now] is injectable so tests can pin "today"; production callers leave
/// it out and get [DateTime.now].
Future<BannerContent?> loadBannerContent({
  required UnitRepository units,
  required TransactionRepository transactions,
  required LimitRepository limits,
  required SettingsRepository settings,
  DateTime Function()? now,
}) async {
  final clock = now ?? DateTime.now;

  final s = await settings.watchSettings().first;
  if (!s.bannerEnabled) return null;

  final unitList = await units.watchUnits().first;
  final txList = await transactions.watchTransactions().first;
  final limitList = await limits.watchLimits().first;

  final (start, end) = Ledger.todayRange(clock());
  final spentToday = Ledger.spentInPeriod(txList, start, end);

  final dailyLimit = limitList
      .where((l) =>
  l.scope == LimitScope.overall &&
      l.period == LimitPeriod.day &&
      l.enabled)
      .firstOrNull;

  final balanceByUnit = {
    for (final u in unitList) u.id: Ledger.balanceOf(u, txList),
  };

  return BannerContent.build(
    status: Ledger.statusFor(dailyLimit, spentToday),
    spentToday: spentToday,
    dailyLimit: dailyLimit,
    units: unitList,
    balanceByUnit: balanceByUnit,
    headline: s.bannerHeadline,
    selectedUnitIds: s.bannerUnitIds,
    showProgress: s.bannerShowProgress,
    showQuickAdd: s.bannerShowQuickAdd,
    // Never pre-redacted here: the *real* banner defers redaction to
    // Android's lock-screen visibility (see BannerPlatform.show). The
    // setup screen's preview uses `redacted: true` on its own to mock
    // what the lock screen version looks like.
    redacted: false,
  );
}

extension _FirstOrNull<T> on Iterable<T> {
  T? get firstOrNull => isEmpty ? null : first;
}
</file>

<file path="lib/domain/logic/capture_pipeline.dart">
// ---------------------------------------------------------------------------
// The capture pipeline (issues #21 and #22): turns one message — pasted,
// shared, or read from an allowed app's notification — into a pending (or
// auto-accepted) transaction, a duplicate no-op, or an unparsed capture.
//
// This used to live inside CaptureService in capture_providers.dart and
// took a Riverpod `Ref`. The notification listener (#22) runs it in a
// *background isolate* with no ProviderScope and no widgets, so the logic
// moved here: it depends only on repository interfaces, which means the
// UI isolate and the background isolate run literally the same code, and
// it can be unit-tested without a device (test/domain/capture_pipeline_test.dart).
// CaptureService is now a thin Riverpod wrapper around it.
// ---------------------------------------------------------------------------
import 'package:fuata/domain/logic/parser.dart';
import 'package:fuata/domain/logic/serial_queue.dart';

import '../models/transaction.dart';
import '../repositories/repositories.dart';
import 'dedupe.dart';

sealed class CaptureOutcome {
  const CaptureOutcome();
}

class Captured extends CaptureOutcome {
  final String transactionId;

  /// True when the auto-accept setting confirmed it immediately, so the
  /// caller's message can say "already added" instead of "waiting".
  final bool autoAccepted;
  const Captured(this.transactionId, {this.autoAccepted = false});
}

class CaptureDuplicate extends CaptureOutcome {
  const CaptureDuplicate();
}

class CaptureUnparsed extends CaptureOutcome {
  const CaptureUnparsed();
}

/// Nothing to do, and nothing stored: empty text, or (for notifications)
/// an app that isn't on the allow-list.
class CaptureIgnored extends CaptureOutcome {
  const CaptureIgnored();
}

class CaptureProcessor {
  CaptureProcessor({
    required this._units,
    required this._templates,
    required this._transactions,
    required this._captures,
    required this._sources,
    required this._settings,
    DateTime Function()? now,
  }) : _now = now ?? DateTime.now;

  final UnitRepository _units;
  final TemplateRepository _templates;
  final TransactionRepository _transactions;
  final CaptureRepository _captures;
  final CaptureSourceRepository _sources;
  final SettingsRepository _settings;
  final DateTime Function() _now;

  final _queue = SerialQueue();

/// A notification posted by [packageName] (#22). The native listener has
/// already dropped anything not on the allow-list before it ever woke
/// Dart; this checks again against the database, so the guarantee in
/// US-10 — "non-allowed notifications are discarded immediately and
/// never stored" — holds even if the native copy of the list is stale.
  Future<CaptureOutcome> captureNotification(String packageName, String text) async {
    final trimmed = text.trim();
    if (trimmed.isEmpty) return const CaptureIgnored();

    final sources = await _sources.watchSources().first;
    final allowed = sources.any((s) => s.enabled && s.packageName == packageName);
    if (!allowed) return const CaptureIgnored();

    return capture(
      trimmed,
      source: TxSource.notification,
      sourcePackage: packageName,
    );
  }

  /// Parses a message against the units' templates, dedupes against what's
  /// already stored, and inserts a pending row — or records an unparsed
  /// capture for the "Couldn't read these" list. This is where
  /// testing.md's P-07/P-08 dedupe cases actually run.
  Future<CaptureOutcome> capture(
      String text, {
        required TxSource source,
        String sourcePackage = 'shared',
      }) {
    final trimmed = text.trim();
    if (trimmed.isEmpty) return Future.value(const CaptureIgnored());
    return _queue.run(() => _capture(trimmed, source, sourcePackage));
  }

  Future<CaptureOutcome> _capture(
      String trimmed,
      TxSource source,
      String sourcePackage,
      ) async {
    // Read fresh from the repositories — never from a StreamProvider's
    // .future (hangs if nothing is watching) or .value (empty until
    // something has watched). `.first` always resolves.
    final units = await _units.watchUnits().first;
    final templates = await _templates.watchTemplates().first;

    if (units.isEmpty) {
      // Nothing to attach a transaction to — keep the message teachable.
      await _recordUnparsed(sourcePackage, trimmed);
      return const CaptureUnparsed();
    }

    // Try each unit's templates in turn; a message belongs to whichever
    // unit's rules match it (P-06 picks between templates *within* a
    // unit — the unit itself is whoever matches first).
    for (final unit in units) {
      final unitTemplates = templates.where((t) => t.unitId == unit.id).toList();
      if (unitTemplates.isEmpty) continue;

      final result = Parser.parse(
        trimmed,
        unitTemplates,
        currencyCode: unit.currencyCode,
      );
      if (!result.matched) continue;
      final fields = result.fields;
      if (fields == null || fields.amountMinor == null) continue;

      final type = result.type ?? TxType.spent;
      final signed = type == TxType.got
          ? fields.amountMinor!
          : -fields.amountMinor!;
      final now = _now();
      final occurredAt = fields.occurredAt ?? now;

      final all = await _transactions.watchTransactions().first;
      if (Dedupe.isDuplicate(
        all,
        unitId: unit.id,
        amountMinor: signed,
        at: occurredAt,
        code: fields.code,
      )) {
        return const CaptureDuplicate();
      }

      final autoAccept = (await _settings.watchSettings().first).autoAcceptCaptures;
      final status = autoAccept ? TxStatus.confirmed : TxStatus.pending;
      final baseId = 'cap_${now.microsecondsSinceEpoch}';
      await _transactions.addTransaction(
        MoneyTransaction(
          id: baseId,
          unitId: unit.id,
          type: type,
          amountMinor: signed,
          counterparty: fields.counterparty,
          code: fields.code,
          occurredAt: occurredAt,
          createdAt: now,
          source: source,
          status: status,
          templateId: result.template!.id,
          balanceAfterMinor: fields.balanceAfterMinor,
          // rawText stays null — raw messages are opt-in only (ADR-009);
          // only unparsed captures keep text, because that's their point.
        ),
      );
      if (fields.feeMinor != null && fields.feeMinor! > 0) {
        // ADR-005: the fee is its own child `spent` row, pending too, so
        // it confirms — or is discarded — together with its parent.
        await _transactions.addTransaction(
          MoneyTransaction(
            id: '${baseId}_fee',
            unitId: unit.id,
            type: TxType.spent,
            amountMinor: -fields.feeMinor!,
            counterparty: 'Fee',
            occurredAt: occurredAt,
            createdAt: now,
            source: source,
            status: status,
            parentId: baseId,
          ),
        );
      }
      return Captured(baseId, autoAccepted: autoAccept);
    }

    await _recordUnparsed(sourcePackage, trimmed);
    return const CaptureUnparsed();
  }

  /// Same app + same text is one entry, not one per arrival. Notifications
  /// get re-posted (a chat app updating its notification, a listener
  /// rebind) and "Teach me" re-runs capture on the text it already holds,
  /// so without this the "Couldn't read these" list fills with copies.
  Future<void> _recordUnparsed(String sourcePackage, String rawText) async {
    final existing = await _captures.watchUnparsed().first;
    final already = existing.any(
          (u) => u.sourcePackage == sourcePackage && u.rawText == rawText,
    );
    if (already) return;
    await _captures.recordUnparsed(
      id: 'unp_${_now().microsecondsSinceEpoch}',
      sourcePackage: sourcePackage,
      rawText: rawText,
    );
  }
}
</file>

<file path="lib/domain/logic/dedupe.dart">
import 'package:fuata/data/constants/captures_constants.dart';

import '../models/transaction.dart';

/// Dedupe rule from requirements.md section 5: "by transaction code when
/// present; otherwise unit + amount + 2-minute window" — testing.md
/// P-07 (same code seen twice -> one row) and P-08 (the same payment
/// arriving as both an SMS and a push notification, no code -> one row).
///
/// Pure function over already-loaded transactions so it is unit-testable
/// without a database; the capture service (#21) loads the list and
/// calls this before inserting a captured transaction. This is where
/// parser_test.dart's deferred P-07/P-08 cases actually live.
class Dedupe {
  const Dedupe._();

  static const defaultWindow = dedupeWindowDuration;

/// [at] is when the money moved (the parsed date, or now if the
/// message carried none). [amountMinor] is the SIGNED effect on the
/// balance, matching how rows are stored (ADR-004).
 static bool isDuplicate(List<MoneyTransaction> existing, {
   required String unitId,
   required int amountMinor,
   required DateTime at,
   String? code,
   Duration window = defaultWindow,
 }) {
   final trimmedCode = code?.trim();
   if (trimmedCode != null && trimmedCode.isNotEmpty) {
     // P-07: the code is provider-unique, so any row in this unit with
     // the same code is the same payment — regardless of amount or
     // when it says it happened.
     return existing.any(
           (t) => t.unitId == unitId && t.code == trimmedCode,
     );
   }

   // P-08: no code -> same unit, same signed amount, inside the window.
   return existing.any(
         (t) =>
     t.unitId == unitId &&
         t.amountMinor == amountMinor &&
         t.occurredAt.difference(at).abs() <= window,
   );
 }
}
</file>

<file path="lib/domain/logic/ledger.dart">
import '../models/limit_rule.dart';
import '../models/transaction.dart';
import '../models/unit.dart';

/// Pure functions only — no Flutter, no I/O — so these are unit-testable
/// without a device (design.md section 1, "domain layer is pure Dart").
class Ledger {
  /// Balance = opening + sum of signed amounts over CONFIRMED transactions
  /// for that unit. Never stored; always derived (ADR-004).
  static int balanceOf(MoneyUnit unit, Iterable<MoneyTransaction> all) {
    var total = unit.openingBalanceMinor;
    for (final t in all) {
      if (t.unitId == unit.id && t.isConfirmed) {
        total += t.amountMinor;
      }
    }
    return total;
  }

  /// Total spent (positive number) across confirmed `spent` transactions
  /// in [from, to). `moved` is excluded by construction (only `spent`
  /// rows are summed) — see ADR-005.
  static int spentInPeriod(
      Iterable<MoneyTransaction> all,
      DateTime from,
      DateTime to, {
        String? unitId,
      }) {
    var total = 0;
    for (final t in all) {
      if (!t.countsAsSpending) continue;
      if (unitId != null && t.unitId != unitId) continue;
      if (t.occurredAt.isBefore(from) || !t.occurredAt.isBefore(to)) continue;
      total += -t.amountMinor; // amountMinor is negative for spending
    }
    return total;
  }

  static int gotInPeriod(
      Iterable<MoneyTransaction> all,
      DateTime from,
      DateTime to, {
        String? unitId,
      }) {
    var total = 0;
    for (final t in all) {
      if (!t.countsAsIncome) continue;
      if (unitId != null && t.unitId != unitId) continue;
      if (t.occurredAt.isBefore(from) || !t.occurredAt.isBefore(to)) continue;
      total += t.amountMinor;
    }
    return total;
  }

  /// [start, end) for "today" in local time.
  static (DateTime, DateTime) todayRange(DateTime now) {
    final start = DateTime(now.year, now.month, now.day);
    return (start, start.add(const Duration(days: 1)));
  }

  /// [start, end) for the current calendar week, Monday-start.
  static (DateTime, DateTime) weekRange(DateTime now) {
    final startOfDay = DateTime(now.year, now.month, now.day);
    final start = startOfDay.subtract(Duration(days: startOfDay.weekday - 1));
    return (start, start.add(const Duration(days: 7)));
  }

  /// [start, end) for the current calendar month.
  static (DateTime, DateTime) monthRange(DateTime now) {
    final start = DateTime(now.year, now.month, 1);
    final end = DateTime(now.year, now.month + 1, 1);
    return (start, end);
  }

  static SpendStatus statusFor(LimitRule? limit, int spentMinor) {
    if (limit == null || !limit.enabled) return SpendStatus.safe;
    return limit.statusFor(spentMinor);
  }
}
</file>

<file path="lib/domain/logic/serial_queue.dart">
import 'dart:async';

/// Runs async actions strictly one after another, in the order they were
/// submitted. A failing action completes *its own* future with the error
/// and never blocks the actions behind it.
///
/// Why this exists (issue #22): capture is check-then-insert (dedupe reads
/// the stored rows, then writes one). Two notifications arriving together
/// — say the same payment as an SMS and as a push — would both read
/// "nothing stored yet" and both insert. Serialising the whole
/// check-and-insert closes that race inside one isolate.
class SerialQueue {
  Future<void> _tail = Future<void>.value();

  Future<T> run<T>(Future<T> Function() action) {
    final completer = Completer<T>();
    _tail = _tail.then((_) async {
      try {
        completer.complete(await action());
      } catch (e, st) {
        completer.completeError(e, st);
      }
    });
    return completer.future;
  }
}
</file>

<file path="lib/domain/models/capture_source.dart">
/// design.md CAPTURE_SOURCE: one app whose notifications Fuata is allowed
/// to read (US-10). The set of *enabled* sources is the allow-list —
/// anything posted by a package that isn't in it is discarded the moment
/// it arrives and never stored (requirements.md, Privacy row).
///
/// Turning an app off keeps the row and flips [enabled] rather than
/// deleting it: `Templates.captureSourceId` references this table, and a
/// delete would trip the foreign key the moment a rule is tied to an app.
class CaptureSource {
  final String id;
  final String packageName;
  final String displayName;
  final bool enabled;

  const CaptureSource({
    required this.id,
    required this.packageName,
    required this.displayName,
    this.enabled = true,
  });

  // One row per package, by construction: the id is derived from the
  /// package name, so saving the same app twice is an upsert rather than a
  /// duplicate (the table has no unique index on `packageName`, and
  /// changing a table definition without a migration is off the table).
  static String idFor(String packageName) => 'src_$packageName';

  CaptureSource copyWith({String? displayName, bool? enabled}) {
    return CaptureSource(
      id: id,
      packageName: packageName,
      displayName: displayName ?? this.displayName,
      enabled: enabled ?? this.enabled,
    );
  }
}
