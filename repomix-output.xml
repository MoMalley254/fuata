<file path="lib/domain/logic/scheduled_export.dart">
// ---------------------------------------------------------------------------
// Pure logic for scheduled export (issue #35): when the next one is due,
// and what the file will be called. Both are the sort of thing that looks
// obvious and is wrong at a month end, a year end or a DST shift — so they
// are top-level functions with an explicit `now`, testable without a device
// or a clock.
//
// The actual alarm lives in ScheduledExportEngine.kt; this file's job is
// to compute the first trigger, and the interval the OS then repeats.
// DST handling: the first trigger is wall-clock-correct; repeated
// occurrences through `setInexactRepeating` drift by up to an hour twice a
// year, which for a daily backup is acceptable (and preferable to relying
// on SCHEDULE_EXACT_ALARM, which the person can revoke).
// ---------------------------------------------------------------------------

import '../models/settings.dart';

DateTime nextScheduledExportTrigger({
  required ScheduledExportFrequency frequency,
  required int minuteOfDay,
  required int weekday, // 1 = Mon … 7 = Sun; ignored when daily
  required DateTime now,
}) {
  final hour = minuteOfDay ~/ 60;
  final minute = minuteOfDay % 60;
  final today = DateTime(now.year, now.month, now.day);
  final todayAtTime =
  DateTime(today.year, today.month, today.day, hour, minute);

  if (frequency == ScheduledExportFrequency.daily) {
    if (todayAtTime.isAfter(now)) return todayAtTime;
    return DateTime(today.year, today.month, today.day + 1, hour, minute);
  }

  // Weekly. `%7` in Dart returns 0..6 even for negatives.
  final daysUntil = (weekday - now.weekday) % 7;
  var candidate =
  DateTime(today.year, today.month, today.day + daysUntil, hour, minute);
  if (!candidate.isAfter(now)) {
    candidate =
        DateTime(candidate.year, candidate.month, candidate.day + 7, hour, minute);
  }
  return candidate;
}

/// Interval between repeats, in milliseconds.
int scheduledExportIntervalMs(ScheduledExportFrequency frequency) =>
    frequency == ScheduledExportFrequency.weekly
        ? const Duration(days: 7).inMilliseconds
        : const Duration(days: 1).inMilliseconds;

/// The file written by one export: `fuata-backup-20261017-201533.json.enc`.
/// Timestamped rather than overwriting, so a run that fails halfway can't
/// destroy an earlier good file; the person can prune history in their
/// file manager.
String scheduledExportFileName(DateTime now) {
  String two(int n) => n.toString().padLeft(2, '0');
  return 'fuata-backup-${now.year}${two(now.month)}${two(now.day)}'
      '-${two(now.hour)}${two(now.minute)}${two(now.second)}.json.enc';
}
</file>

<file path="lib/domain/logic/unit_order.dart">
import '../models/unit.dart';

/// Issue #117: the new `sortOrder` for each unit after the person drags
/// them into [orderedIds] (first id = first on Home and My money).
///
/// Rather than renumbering everything 0..n, the units being reordered
/// trade the sort values they already hold, handed out in ascending order
/// down the new list. That leaves every unit *not* in [orderedIds]
/// (archived ones, chiefly) exactly where it was, so a restored unit still
/// comes back to roughly the place it left from (finding F9).
///
/// When the existing values aren't all distinct (units seeded with 0, or
/// an older backup), trading them would leave ties and the new order
/// wouldn't stick, so those fall back to 0..n-1 by position.
///
/// Ids that match no unit, and repeated ids, are ignored. Returns only
/// the units whose value actually changes.
Map<String, int> unitSortOrdersFor(
  Iterable<MoneyUnit> units,
  List<String> orderedIds,
) {
  final byId = {for (final u in units) u.id: u};
  final ids = <String>[];
  for (final id in orderedIds) {
    if (byId.containsKey(id) && !ids.contains(id)) ids.add(id);
  }

  final slots = [for (final id in ids) byId[id]!.sortOrder]..sort();
  final distinct = slots.toSet().length == slots.length;

  final result = <String, int>{};
  for (var i = 0; i < ids.length; i++) {
    final next = distinct ? slots[i] : i;
    if (byId[ids[i]]!.sortOrder != next) result[ids[i]] = next;
  }
  return result;
}
</file>

<file path="lib/domain/models/backup_snapshot.dart">
// ---------------------------------------------------------------------------
// Everything a backup file carries, as plain domain objects (issue #24).
//
// Pure Dart, no I/O. The codec (logic/backup_codec.dart) turns one of these
// into JSON and back; the planner (logic/backup_import.dart) compares one
// read from a file with one read from the database; the repository
// (data/db/backup_repository.dart) reads and writes them.
//
// What is deliberately NOT in here:
//  - Unparsed captures: raw message text kept for 7 days by design (US-11),
//    never worth carrying to another phone.
//  - Alert firings: derived state. Importing limits on a new phone should
//    not silence alerts for a period that phone never showed.
//  - Balances: always computed from the opening balance plus transactions
//    (ADR-004), so there is nothing to store.
// ---------------------------------------------------------------------------

import 'package:fuata/domain/models/settings.dart';
import 'package:fuata/domain/models/template.dart';
import 'package:fuata/domain/models/transaction.dart';
import 'package:fuata/domain/models/unit.dart';

import 'capture_source.dart';
import 'limit_rule.dart';
import 'outing.dart';

/// A row of the `categories` table (issue #83). Was previously a raw
/// shape with no domain model — now that categories are user-editable,
/// the fields are the same ones the domain model carries.
class BackupCategory {
  final String id;
  final String name;
  final String emoji;
  final int colorValue;
  final int sortOrder;
  final bool archived;

  const BackupCategory({
    required this.id,
    required this.name,
    required this.emoji,
    required this.colorValue,
    this.sortOrder = 0,
    this.archived = false,
  });
}

class BackupSnapshot {
  final List<BackupCategory> categories;
  final List<MoneyUnit> units;
  final List<CaptureSource> captureSources;
  final List<CaptureTemplate> templates;
  final List<MoneyTransaction> transactions;
  final List<LimitRule> limits;

  /// Null when the file has no settings section (or the caller left them
  /// out). Settings are preferences, not money, so they are handled
  /// separately from the records above on import.
  final AppSettings? settings;

  /// Outings (issue #30). No FKs to units — an outing's `unitIds` is a
  /// soft set, and a missing id at import just means that unit wasn't
  /// restored. The outing itself always imports.
  final List<Outing> outings;

  const BackupSnapshot({
    this.categories = const [],
    this.units = const [],
    this.captureSources = const [],
    this.templates = const [],
    this.transactions = const [],
    this.limits = const [],
    this.settings,
    this.outings = const [],
  });

  static const empty = BackupSnapshot();

  /// Number of money records (settings not counted).
  int get recordCount =>
      categories.length +
      units.length +
      captureSources.length +
      templates.length +
      transactions.length +
      limits.length +
      outings.length;

  bool get isEmpty => recordCount == 0;
}
