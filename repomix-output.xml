  AppSettings copyWith({
    String? name,
    Color? accent,
    AppThemeMode? themeMode,
    HomeHeadline? homeHeadline,
    Set<HomeSection>? homeSections,
    DetailLevel? detailLevel,
    bool? amountsHiddenInRecents,
