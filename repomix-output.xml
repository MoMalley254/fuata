      await limits.setLimit(dayLimit());
      await txs.addTransaction(MoneyTransaction(
        id: 't1',
        unitId: 'u1',
        type: TxType.spent,
        amountMinor: -95000,
        occurredAt: lateNight,
        createdAt: lateNight,
      ));

      final batch = await claimDueAlerts(
        units: units,
        transactions: txs,
        limits: limits,
        settings: settings,
