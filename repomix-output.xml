<file path="lib/platform/share_intake.dart">
import 'dart:async';

import 'package:flutter/services.dart';
import 'package:fuata/data/constants/method_channels_constants.dart';

final _channel = MethodChannel(shareIntakeMethodName);
final _sharedText = StreamController<String>.broadcast();
final _queue = <String>[];

/// Text that arrived before anyone was listening (cold start from the
/// share sheet). Drained once by RootShell's initState.
String? _pendingInitialText;

Stream<String> get sharedTextStream => _sharedText.stream;

Future<void> initShareIntake() async {
  _channel.setMethodCallHandler((call) async {
    if (call.method == 'onSharedText') {
      _add(call.arguments);
    }
    return null;
  });
  try {
    final initial = await _channel.invokeMethod<dynamic>('getSharedText');
    if (initial is String && initial.trim().isNotEmpty) {
      // No listener yet — stash it; RootShell will drain it in initState.
      _pendingInitialText = initial.trim();
    }
  } on PlatformException {
    // Older builds / widget tests have no native side.
  }
}

/// Returns and clears text stashed before listeners attached.
String? consumePendingSharedText() {
  final t = _pendingInitialText;
  _pendingInitialText = null;
  return t;
}

void _add(dynamic text) {
  if (text is! String) return;
  final trimmed = text.trim();
  if (trimmed.isEmpty) return;
  if (!_sharedText.hasListener) {
    _queue.add(trimmed);
    return;
  }
  _sharedText.add(trimmed);
}

/// Called by RootShell after it subscribes — replays anything that
/// arrived before the UI was ready.
List<String> drainShareQueue() {
  final out = List<String>.from(_queue);
  _queue.clear();
  return out;
}
</file>

<file path="lib/ui/providers/alert_providers.dart">
// ---------------------------------------------------------------------------
// Firing limit alerts from the UI isolate (issue #63, US-06).
//
// Like bannerSyncProvider: watch the data, and act whenever it changes. What
// it does *not* handle is a capture written by the notification listener
// while the app is closed — that path fires from its own isolate
// (platform/notification_capture.dart). Both go through [fireDueAlerts],
// whose database claim makes "once per threshold per period" hold no matter
// which of them notices first.
// ---------------------------------------------------------------------------

import 'package:flutter/foundation.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/serial_queue.dart';
import '../../platform/alerts.dart';
import 'app_providers.dart';

final _alertQueue = SerialQueue();

/// Start once, from Fuata's build (watched, like bannerSyncProvider).
final alertSyncProvider = Provider<void>((ref) {
  final units = ref.watch(unitsProvider);
  final transactions = ref.watch(transactionsProvider);
  final limits = ref.watch(limitsProvider);
  final settings = ref.watch(settingsProvider);

  // Still loading: evaluating against half the data could announce a
  // crossing that isn't real. Wait for everything.
  if (units.value == null ||
      transactions.value == null ||
      limits.value == null ||
      settings.value == null) {
    return;
  }

  final unitRepo = ref.read(unitRepositoryProvider);
  final txRepo = ref.read(transactionRepositoryProvider);
  final limitRepo = ref.read(limitRepositoryProvider);
  final settingsRepo = ref.read(settingsRepositoryProvider);
  final log = ref.read(alertLogRepositoryProvider);

  // Serialised so two quick changes can't run two evaluations at once in
  // this isolate. An alert failure must never surface to the person.
  _alertQueue.run(() async {
    try {
      await fireDueAlerts(
        units: unitRepo,
        transactions: txRepo,
        limits: limitRepo,
        settings: settingsRepo,
        log: log,
      );
    } catch (e) {
      debugPrint('[alerts] failed: ${e.runtimeType}');
    }
  });
});
</file>

<file path="lib/ui/providers/banner_providers.dart">
// ---------------------------------------------------------------------------
// The ongoing banner's data-driven re-post (issue #16, US-05).
//
// HomeState already recomputes on every units/transactions/limits change
// (app_providers.dart), and settings change on every write — so watching
// both is enough to re-post whenever the numbers or the options move.
// What this deliberately does *not* handle: a capture written by the
// notification listener's background isolate. That path re-posts from
// its own isolate (platform/notification_capture.dart), because the UI
// isolate isn't running to notice.
// ---------------------------------------------------------------------------

import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/banner_content.dart';
import '../../platform/banner.dart';
import 'app_providers.dart';

/// Start once, from Fuata's initState. Never read the value — the side
/// effect *is* the provider.
final bannerSyncProvider = Provider<void>((ref) {
  final home = ref.watch(homeStateProvider).value;
  final settings = ref.watch(currentSettingsProvider);

  // Still loading: don't cancel a banner the background isolate just
  // posted, and don't post a stale one. Wait for the first real value.
  if (home == null) return;

  if (!settings.bannerEnabled) {
    BannerPlatform.instance.cancel();
    return;
  }

  final content = BannerContent.build(
    status: home.status,
    spentToday: home.spentToday,
    dailyLimit: home.dailyLimit,
    units: home.units,
    balanceByUnit: home.balanceByUnit,
    headline: settings.bannerHeadline,
    selectedUnitIds: settings.bannerUnitIds,
    showProgress: settings.bannerShowProgress,
    showQuickAdd: settings.bannerShowQuickAdd,
    redacted: false, // see BannerPlatform.show — Android redacts, not us
  );

  BannerPlatform.instance.show(
    content,
    redactOnLockScreen: settings.redactedLockScreenBanner,
  );
});
</file>

<file path="lib/ui/screens/auto_catch_screen.dart">
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:fuata/widgets/personalization/section_card.dart';

import '../../domain/models/capture_source.dart';
import '../../platform/notification_capture.dart';
import '../../widgets/personalization/action_row.dart';
import '../../widgets/personalization/label.dart';
import '../../widgets/personalization/toggle_row.dart';
import '../providers/capture_providers.dart';
import '../theme/app_colors.dart';
import '../theme/app_spacing.dart';
import '../theme/app_typography.dart';

/// Auto-catch (issue #22, US-10, ui-design-brief.md section 7.12 "Message
/// reading — allowed apps"): the two things the person controls about
/// reading notifications — the Android notification-access grant, and
/// which apps Fuata may read at all.
///
/// The promise this screen makes, and the listener keeps: only apps
/// switched on here are ever read; a notification from any other app is
/// dropped the instant it arrives and never stored.

class AutoCatchScreen extends ConsumerStatefulWidget {
  const AutoCatchScreen({super.key});

  @override
  ConsumerState<AutoCatchScreen> createState() => _AutoCatchScreenState();
}

class _AutoCatchScreenState extends ConsumerState<AutoCatchScreen> with WidgetsBindingObserver {
  bool? _accessEnabled; // null until the first check returns
  List<InstalledApp>? _apps; // null while loading
  String _query = '';
  final _packageController = TextEditingController();

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _refreshAccess();
    _loadApps();
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _packageController.dispose();
    super.dispose();
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    // Coming back from Android's notification-access screen: re-check, so
    // the status card reflects what the person just did there.
    if (state == AppLifecycleState.resumed) _refreshAccess();
  }

  Future<void> _refreshAccess() async {
    final enabled = await isNotificationAccessEnabled();
    if (mounted) setState(() => _accessEnabled = enabled);
  }

  Future<void> _loadApps() async {
    final apps = await listLaunchableApps();
    if (mounted) setState(() => _apps = apps);
  }

  Future<void> _toggle(String packageName, String label, bool on) {
    return ref
        .read(captureSourceRepositoryProvider)
        .saveSource(
      CaptureSource(
        id: CaptureSource.idFor(packageName),
        packageName: packageName,
        displayName: label,
        enabled: on,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final allowed = ref.watch(allowedPackagesProvider);
    final sources = ref.watch(captureSourcesProvider).value ?? const [];

    // Installed apps, plus any watched app that is no longer installed
    // (kept visible so it can still be switched off).
    final byPackage = <String, String>{
      for (final a in _apps ?? const <InstalledApp>[]) a.packageName: a.label,
      for (final s in sources)
        if (s.enabled) s.packageName: s.displayName,
    };
    final q = _query.trim().toLowerCase();
    final rows =
    byPackage.entries
        .where(
          (e) =>
      q.isEmpty ||
          e.value.toLowerCase().contains(q) ||
          e.key.toLowerCase().contains(q),
    )
        .toList()
      ..sort((a, b) {
        // Watched apps first, then A-Z.
        final aOn = allowed.contains(a.key) ? 0 : 1;
        final bOn = allowed.contains(b.key) ? 0 : 1;
        if (aOn != bOn) return aOn.compareTo(bOn);
        return a.value.toLowerCase().compareTo(b.value.toLowerCase());
      });

    final accessOn = _accessEnabled == true;

    return Scaffold(
      appBar: AppBar(title: const Text('Auto-Catch'),),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.fromLTRB(
            AppSpacing.margin,
            AppSpacing.sm,
            AppSpacing.margin,
            AppSpacing.xl,
          ),
          children: [
            SectionCard(
                title: 'Notification access',
                children: [
                  Text(
                    'Fuata can read the notification a bank or mobile-money '
                        'message makes and turn it into a transaction for you to '
                        'check. It only looks at the apps you switch on below. '
                        'Every other notification is dropped the moment it '
                        'arrives and is never stored. Nothing leaves this phone.',
                    style: AppTypography.bodySm.copyWith(
                      color: c.onSurfaceVariant,
                    ),
                  ),
                  const SizedBox(height: AppSpacing.md,),
                  Container(
                    padding: const EdgeInsets.all(AppSpacing.md),
                    decoration: BoxDecoration(
                      color: accessOn
                          ? c.statusSafeContainer
                          : c.statusWarningContainer,
                      borderRadius: BorderRadius.circular(
                        AppSpacing.unitTileRadius,
                      ),
                    ),
                    child: Row(
                      children: [
                        Icon(
                          accessOn
                              ? Icons.check_circle_outline_rounded
                              : Icons.info_outline_rounded,
                          color: accessOn ? c.statusSafe : c.statusWarning,
                        ),
                        const SizedBox(width: AppSpacing.sm),
                        Expanded(
                          child: Text(
                            _accessEnabled == null
                                ? 'Checking…'
                                : accessOn
                                ? 'Access is on.'
                                : 'Access is off, so nothing is caught from '
                                'notifications yet.',
                            style: AppTypography.bodySm.copyWith(
                              color: c.onSurface,
                            ),
                          ),
                        )
                      ],
                    ),
                  ),
                  const SizedBox(height: AppSpacing.sm),
                  ActionRow(
                    icon: Icons.notifications_active_outlined,
                    title: accessOn ? 'Manage access' : 'Turn on access',
                    subtitle: 'Opens Android’s notification access list',
                    onTap: openNotificationAccessSettings,
                  ),
                  const SizedBox(height: AppSpacing.sm),
                  Text(
                    'If Fuata’s switch is greyed out, open Fuata’s App info, '
                        'tap ⋮ and choose “Allow restricted settings”. On some '
                        'phones the switch only takes effect after turning it '
                        'off and on again.',
                    style: AppTypography.bodySm.copyWith(
                      color: c.onSurfaceTertiary,
                    ),
                  ),
                ]
            ),
            const SizedBox(height: AppSpacing.lg),
            SectionCard(
              title: 'Apps to watch',
              children: [
                Text(
                  'Pick your messages app, and any bank or mobile-money app '
                      'that sends you payment notifications.',
                  style: AppTypography.bodySm.copyWith(
                    color: c.onSurfaceVariant,
                  ),
                ),
                const SizedBox(height: AppSpacing.md),
                TextField(
                  onChanged: (v) => setState(() => _query = v),
                  decoration: const InputDecoration(
                    prefixIcon: Icon(Icons.search_rounded),
                    hintText: 'Search apps',
                  ),
                ),
                const SizedBox(height: AppSpacing.md),
                // Debug builds only: lets `adb shell cmd notification post`
                // (posted as com.android.shell, which has no launcher icon
                // and so never appears above) be allow-listed for
                // testing.md's listener checks.
                if (kDebugMode) ...[
                  Row(
                    children: [
                      Expanded(
                        child: TextField(
                          controller: _packageController,
                          decoration: const InputDecoration(
                            hintText: 'Add by package name (debug only)',
                          ),
                        ),
                      ),
                      const SizedBox(width: AppSpacing.sm),
                      FilledButton.tonal(
                        onPressed: () {
                          final pkg = _packageController.text.trim();
                          if (pkg.isEmpty) return;
                          _toggle(pkg, pkg, true);
                          _packageController.clear();
                        },
                        child: const Text('Add'),
                      ),
                    ],
                  ),
                  const SizedBox(height: AppSpacing.md),
                ],
                if (_apps == null)
                  const Center(child: CircularProgressIndicator.adaptive())
                else if (rows.isEmpty)
                  Text(
                    byPackage.isEmpty
                        ? 'No apps found.'
                        : 'No app matches “$_query”.',
                    style: AppTypography.bodyMd.copyWith(
                      color: c.onSurfaceVariant,
                    ),
                  )
                else ...[
                    Label('${allowed.length} on · ${rows.length} shown'),
                    const SizedBox(height: AppSpacing.sm),
                    for (final e in rows) ...[
                      ToggleRow(
                        title: e.value,
                        subtitle: e.key,
                        value: allowed.contains(e.key),
                        onChanged: (v) => _toggle(e.key, e.value, v),
                      ),
                      const SizedBox(height: AppSpacing.sm),
                    ],
                  ],
              ],
            ),
          ],
        ),
      ),
    );
  }
}
</file>

<file path="lib/ui/screens/banner_setup_screen.dart">
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/banner_content.dart';
import '../../domain/models/limit_rule.dart';
import '../../domain/models/money.dart';
import '../../domain/models/settings.dart';
import '../../widgets/app_chips.dart';
import '../../widgets/banner/banner_preview.dart';
import '../../widgets/personalization/section_card.dart';
import '../../widgets/personalization/toggle_row.dart';
import '../providers/app_providers.dart';
import '../theme/app_colors.dart';
import '../theme/app_spacing.dart';
import '../theme/app_typography.dart';

/// Banner setup (issue #17, US-05, ui-design-brief.md 7.9): choose what the
/// notification banner shows, with a live preview at the top.
///
/// Options are saved straight into AppSettings; the banner service (#16)
/// reads the same settings and the same BannerContent.build(), so the
/// preview never disagrees with the real notification.
class BannerSetupScreen extends ConsumerStatefulWidget {
  const BannerSetupScreen({super.key});

  @override
  ConsumerState<BannerSetupScreen> createState() => _BannerSetupScreenState();
}

/// null = "Now" (the person's real numbers); otherwise a made-up day that
/// lands in that status, so all four looks can be checked (brief 7.10).
class _BannerSetupScreenState extends ConsumerState<BannerSetupScreen> {
  SpendStatus? _sample;
  bool _lockScreen = false;

  static const _sampleRatio = {
    SpendStatus.safe: 0.25,
    SpendStatus.warning: 0.8,
    SpendStatus.danger: 0.95,
    SpendStatus.overdraft: 1.1,
  };

  void _update(AppSettings Function(AppSettings) fn) {
    final current = ref.read(currentSettingsProvider);
    ref.read(settingsRepositoryProvider).updateSettings(fn(current));
  }

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final s = ref.watch(currentSettingsProvider);
    final home = ref.watch(homeStateProvider).value ?? HomeState.empty;
    final units = home.units.where((u) => !u.archived).toList();

    // --- Numbers the preview uses: real ones, or an illustrative day. ---
    var spent = home.spentToday;
    var limit = home.dailyLimit;
    var status = home.status;
    final sample = _sample;
    if (sample != null) {
      final code = limit?.currencyCode ??
          (units.isEmpty ? 'KES' : units.first.currencyCode);
      final amount =
          limit?.amountMinor ?? Money.parseMajor('2000', code).minor;
      limit = LimitRule(
        id: 'preview',
        scope: LimitScope.overall,
        period: LimitPeriod.day,
        amountMinor: amount,
        currencyCode: code,
      );
      spent = (amount * _sampleRatio[sample]!).round();
      status = limit.statusFor(spent);
    }

    final content = BannerContent.build(
      status: status,
      spentToday: spent,
      dailyLimit: limit,
      units: units,
      balanceByUnit: home.balanceByUnit,
      headline: s.bannerHeadline,
      selectedUnitIds: s.bannerUnitIds,
      showProgress: s.bannerShowProgress,
      showQuickAdd: s.bannerShowQuickAdd,
      redacted: _lockScreen && s.redactedLockScreenBanner,
    );

    final allUnits = s.bannerUnitIds.isEmpty;

    return Scaffold(
      appBar: AppBar(title: const Text('Banner')),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.fromLTRB(
              AppSpacing.margin, AppSpacing.md, AppSpacing.margin, AppSpacing.xl),
          children: [
            SectionCard(
              title: 'Preview',
              children: [
                BannerPreview(content: content),
                const SizedBox(height: AppSpacing.md),
                Wrap(
                  spacing: AppSpacing.sm,
                  runSpacing: AppSpacing.sm,
                  children: [
                    AppChoiceChip(
                      label: 'Now',
                      selected: _sample == null,
                      onTap: () => setState(() => _sample = null),
                    ),
                    for (final st in SpendStatus.values)
                      AppChoiceChip(
                        label: '${st.emoji} ${st.label}',
                        selected: _sample == st,
                        onTap: () => setState(() => _sample = st),
                      ),
                  ],
                ),
                const SizedBox(height: AppSpacing.sm),
                Wrap(
                  spacing: AppSpacing.sm,
                  children: [
                    AppChoiceChip(
                      label: 'Unlocked',
                      selected: !_lockScreen,
                      onTap: () => setState(() => _lockScreen = false),
                    ),
                    AppChoiceChip(
                      label: 'Lock screen',
                      selected: _lockScreen,
                      onTap: () => setState(() => _lockScreen = true),
                    ),
                  ],
                ),
                const SizedBox(height: AppSpacing.sm),
                Text(
                  'Android limits notification colour, so your status shows as an '
                      'emoji, a progress bar and a coloured icon.',
                  style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
                ),
              ],
            ),
            const SizedBox(height: AppSpacing.lg),
            SectionCard(
              title: 'Show the banner',
              children: [
                ToggleRow(
                  title: 'Banner in my notifications',
                  subtitle: 'See how you are doing without opening the app.',
                  value: s.bannerEnabled,
                  onChanged: (v) => _update((x) => x.copyWith(bannerEnabled: v)),
                ),
              ],
            ),
            const SizedBox(height: AppSpacing.lg),
            SectionCard(
              title: 'The big number',
              children: [
                Wrap(
                  spacing: AppSpacing.sm,
                  runSpacing: AppSpacing.sm,
                  children: [
                    for (final h in BannerHeadline.values)
                      AppChoiceChip(
                        label: h.label,
                        selected: s.bannerHeadline == h,
                        onTap: () => _update((x) => x.copyWith(bannerHeadline: h)),
                      ),
                  ],
                ),
              ],
            ),
            const SizedBox(height: AppSpacing.lg),
            SectionCard(
              title: 'Units shown',
              children: [
                Wrap(
                  spacing: AppSpacing.sm,
                  runSpacing: AppSpacing.sm,
                  children: [
                    AppChoiceChip(
                      label: 'All',
                      selected: allUnits,
                      onTap: () =>
                          _update((x) => x.copyWith(bannerUnitIds: <String>{})),
                    ),
                    for (final u in units)
                      AppChoiceChip(
                        label: '${u.iconEmoji} ${u.name}',
                        selected: !allUnits && s.bannerUnitIds.contains(u.id),
                        onTap: () => _update((x) {
                          final next = {...x.bannerUnitIds};
                          if (!next.remove(u.id)) next.add(u.id);
                          // Everything picked, or nothing left: same as "All".
                          final everything = units.every((e) => next.contains(e.id));
                          return x.copyWith(
                            bannerUnitIds: everything ? <String>{} : next,
                          );
                        }),
                      ),
                  ],
                ),
              ],
            ),
            const SizedBox(height: AppSpacing.lg),
            SectionCard(
              title: 'Details',
              children: [
                ToggleRow(
                  title: 'Progress bar',
                  subtitle: 'How much of today\'s limit is used.',
                  value: s.bannerShowProgress,
                  onChanged: (v) =>
                      _update((x) => x.copyWith(bannerShowProgress: v)),
                ),
                const SizedBox(height: AppSpacing.sm),
                ToggleRow(
                  title: '+ Add button',
                  subtitle: 'Add a transaction straight from the banner.',
                  value: s.bannerShowQuickAdd,
                  onChanged: (v) =>
                      _update((x) => x.copyWith(bannerShowQuickAdd: v)),
                ),
                const SizedBox(height: AppSpacing.sm),
                ToggleRow(
                  title: 'Hide amounts on the lock screen',
                  subtitle: 'Shows only the status until the phone is unlocked.',
                  value: s.redactedLockScreenBanner,
                  onChanged: (v) =>
                      _update((x) => x.copyWith(redactedLockScreenBanner: v)),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}
</file>

<file path="lib/ui/screens/manage_rules_screen.dart">
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:fuata/ui/providers/app_providers.dart';
import 'package:fuata/ui/theme/app_colors.dart';

import '../../widgets/rule_builder/rules_body.dart';
import '../theme/app_typography.dart';

/// Manage the message-reading rules for a unit  #20.
///
/// The unit page's "Reading messages" row used to say "N rules · add or
/// review" but only supported "add" — tapping it opened the rule builder
/// directly. This screen is the "review" half: it lists every template
/// saved for [unitId], lets the person enable/disable each one and
/// delete ones they no longer want, and links into the builder to add
/// another. It's the only place `deleteTemplate` and
/// `CaptureTemplate.enabled` are actually used.
class ManageRulesScreen extends ConsumerWidget {
  final String unitId;
  const ManageRulesScreen({super.key, required this.unitId});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final c = context.colors;
    final unitsAsync = ref.read(unitsProvider);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Reading Rules'),
      ),
      body: SafeArea(
        child: unitsAsync.when(
          loading: () => const Center(child: CircularProgressIndicator.adaptive(),),
          error: (e, st) => Center(
            child: Text(
              'Something went wrong: $e'
            ),
          ),
          data: (units) {
            final unit = units.where((u) => u.id == unitId).firstOrNull;
            if (unit == null) {
              return Center(
                child: Text(
                  "This unit's gone.",
                  style:
                  AppTypography.bodyMd.copyWith(color: c.onSurfaceVariant),
                ),
              );
            }
            return RulesBody(unit: unit);
          }
        ),
      ),
    );
  }
}
</file>

<file path="lib/ui/screens/my_money_screen.dart">
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:fuata/ui/providers/app_providers.dart';
import 'package:fuata/ui/screens/unit_detail_screen.dart';

import '../../domain/models/money.dart';
import '../../widgets/sheets/edit_unit_sheet.dart';
import '../../widgets/unit_list_tile.dart';
import '../theme/app_colors.dart';
import '../theme/app_spacing.dart';
import '../theme/app_typography.dart';

/// My money (ui-design-brief.md section 7.5): a total with a privacy eye,
/// then every unit as a full-width row. Tapping a unit opens its detail
/// page; "+ Add something" opens the same sheet used to edit a unit.
class MyMoneyScreen extends ConsumerStatefulWidget {
  const MyMoneyScreen({super.key});

  @override
  ConsumerState<MyMoneyScreen> createState() => _MyMoneyScreenState();
}

class _MyMoneyScreenState extends ConsumerState<MyMoneyScreen> {
  bool _hidden = false;

  @override
  Widget build(BuildContext context) {
    final homeAsync = ref.watch(homeStateProvider);
    final c = context.colors;

    return Scaffold(
      appBar: AppBar(title: const Text('My Money')),
      body: SafeArea(
        child: homeAsync.when(
          loading: () =>
              const Center(child: CircularProgressIndicator.adaptive()),
          error: (e, st) => Center(child: Text('Something went wrong: $e')),
          data: (state) {
            final currency = state.units.isNotEmpty
                ? state.units.first.currencyCode
                : 'KES';
            final total = state.balanceByUnit.values.fold(0, (a, b) => a + b);

            return ListView(
              padding: const EdgeInsets.fromLTRB(
                AppSpacing.margin,
                AppSpacing.sm,
                AppSpacing.margin,
                100,
              ),
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          'Altogether you have',
                          style: AppTypography.bodyMd.copyWith(
                            color: c.onSurfaceVariant,
                          ),
                        ),
                        Text(
                          _hidden ? '•••••' : Money(total, currency).format(),
                          style: AppTypography.displayHeroMobile.copyWith(
                            color: c.onSurface,
                          ),
