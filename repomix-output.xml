<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/ScheduledExportReceiver.kt">
package com.kinyuanexus.fuata

import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent

/**
 * Fires when the scheduled export alarm goes off (issue #35).
 *
 * Fire-and-forget by design: this receiver starts the background isolate
 * and returns, so Android doesn't consider it long-running. The isolate
 * reports its own result; the receiver does not re-arm — the alarm set
 * with `setInexactRepeating` keeps repeating on its own interval, and the
 * boot receiver re-arms after a reboot.
 */
class ScheduledExportReceiver : BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent) {
        if (intent.action != ACTION) return
        ScheduledExportEngine.startBackgroundExport(context.applicationContext)
    }

    companion object {
        const val ACTION = "com.kinyuanexus.fuata.SCHEDULED_EXPORT_FIRE"
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/ShareIntake.kt">
package com.kinyuanexus.fuata

import android.content.Intent
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.MethodChannel

/**
 * `fuata/share_intake` channel: issue #21. Android delivers ACTION_SEND
 * text/plain here (see the manifest's intent-filter); the text is
 * forwarded to Dart, with a small stash so a cold start from another
 * app's share sheet can't lose it before the Dart handler is up.
 */
class ShareIntakeChannel(messenger: BinaryMessenger) {
    private val channel = MethodChannel(messenger, CHANNEL)
    private var pendingSharedText: String? = null

    init {
        channel.setMethodCallHandler { call, result ->
            when (call.method) {
                "getSharedText" -> {
                    result.success(pendingSharedText)
                    pendingSharedText = null
                }
                else -> result.notImplemented()
            }
        }
    }

    /** Route an ACTION_SEND text/plain intent to Dart (stashing if needed). */
    fun handleShareIntent(intent: Intent?) {
        if (intent?.action != Intent.ACTION_SEND) return
        val text = intent.getStringExtra(Intent.EXTRA_TEXT) ?: return

        // Stash first: if the Dart handler isn't registered yet the
        // invoke fails silently, and getSharedText covers that case.
        pendingSharedText = text
        channel.invokeMethod(
            "onSharedText",
            text,
            object : MethodChannel.Result {
                // The Dart handler consumed it — drop the stash so a
                // later getSharedText can't deliver it a second time.
                override fun success(result: Any?) {
                    pendingSharedText = null
                }

                override fun error(
                    errorCode: String,
                    errorMessage: String?,
                    errorDetails: Any?,
                ) {
                }

                override fun notImplemented() {
                }
            },
        )
    }

    companion object {
        const val CHANNEL = "fuata/share_intake"
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/WidgetDataStore.kt">
package com.kinyuanexus.fuata

import android.content.Context
import android.content.SharedPreferences
import org.json.JSONObject

/**
 * The home-screen widget's cached snapshot (issue #29).
 *
 * Dart pushes a small map over `fuata/home_widget`; HomeWidgetChannel
 * writes it here and pings the widget provider to re-render. The
 * provider itself never talks to Dart and never touches the drift
 * database — it is a plain BroadcastReceiver and might run when no
 * Flutter engine is alive.
 *
 * Same pattern as CaptureStore: a small SharedPreferences cache the
 * native side can read instantly. `progress` is stored as -1.0 to mean
 * "no progress bar"; a real progress of 0 is legal and distinct.
 */
object WidgetDataStore {
    private const val PREFS = "fuata_widget"
    private const val KEY = "snapshot"
    const val NO_PROGRESS = -1.0

    data class Snapshot(
        val amount: String,
        val currency: String,
        val caption: String,
        val progress: Double,
        val emoji: String,
        val status: String,
        val splitLine: String,
        val variant: String,
    )

    fun write(context: Context, data: Map<String, Any?>) {
        val json = JSONObject(data).toString()
        prefs(context).edit().putString(KEY, json).apply()
    }

    fun read(context: Context): Snapshot? {
        val raw = prefs(context).getString(KEY, null) ?: return null
        return try {
            val o = JSONObject(raw)
            Snapshot(
                amount = o.optString("amount", "0"),
                currency = o.optString("currency", ""),
                caption = o.optString("caption", ""),
                progress = o.optDouble("progress", NO_PROGRESS),
                emoji = o.optString("emoji", ""),
                status = o.optString("status", "safe"),
                splitLine = o.optString("splitLine", ""),
                variant = o.optString("variant", "auto"),
            )
        } catch (_: Exception) {
            // A hand-edited or truncated row is one we can't render;
            // falling back to the empty state is better than crashing.
            null
        }
    }

    fun clear(context: Context) {
        prefs(context).edit().remove(KEY).apply()
    }

    private fun prefs(context: Context): SharedPreferences =
        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
}
</file>

