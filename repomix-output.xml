<file path="lib/data/db/db_key.dart">
import 'dart:math';

import 'package:flutter_secure_storage/flutter_secure_storage.dart';

/// The SQLCipher key for the on-device database.
///
/// Generated once on first run and stored behind Android Keystore (via
/// flutter_secure_storage's `encryptedSharedPreferences` on Android 6+,
/// which uses a Keystore-backed master key). The key never leaves the
/// device and is never derived from anything the person can be coerced
/// into typing.
class DbKey {
  DbKey._();

  static const _storage = FlutterSecureStorage(
    aOptions: AndroidOptions(),
  );

  static const _keyName = 'fuata.db_key.v1';

  static Future<String> getOrCreate() async {
    final existing = await _storage.read(key: _keyName);
    if (existing != null) return existing;

    final rng = Random.secure();
    final bytes = List<int>.generate(32, (_) => rng.nextInt(256));
    final hex = bytes.map((b) => b.toRadixString(16).padLeft(2, '0')).join();
    final key = hex;
    await _storage.write(key: _keyName, value: key);
    return key;
  }

  /// Wipes the key. Used by "Erase everything" — after this, the DB file
  /// is unrecoverable garbage, which is the point.
  static Future<void> destroy() => _storage.delete(key: _keyName);
}
</file>

<file path="lib/domain/logic/backup_service.dart">
// ---------------------------------------------------------------------------
// The three things the Back up & restore screen does (issue #24), with no
// UI and no file access in the way so they can be tested end to end
// against an in-memory database:
//
//   buildExport - read everything, encode it.
//   preview     - decode a file, compare it with the phone. Writes nothing.
//   apply       - write what the person confirmed, in one transaction.
// ---------------------------------------------------------------------------

import '../models/backup_snapshot.dart';
import '../repositories/repositories.dart';
import 'backup_codec.dart';
import 'backup_import.dart';

/// What opening a backup file found: either [errors] (nothing can be
/// imported) or a [plan] the person can review.
class ImportPreview {
  final BackupDecodeResult decoded;
  final ImportPlan? plan;

  /// Whether the phone already has any money units. Decides whether "also
  /// restore my settings" starts switched on (fresh phone) or off (there
  /// is something to lose).
  final bool phoneHasData;

  const ImportPreview({
    required this.decoded,
    required this.plan,
    required this.phoneHasData,
  });

  /// Every reason this file can't be imported, file problems first.
  List<String> get blockers => [
    ...decoded.errors,
    if (plan != null) ...plan!.problems,
  ];

  int get moreBlockers =>
      decoded.moreErrors + (plan == null ? 0 : plan!.moreProblems);

  bool get canImport => decoded.ok && plan != null && plan!.canApply;

  bool get hasSettings => plan?.incomingSettings != null;
}

/// What actually happened, for the "Done" message.
class ImportOutcome {
  final int added;
  final int replaced;
  final int skipped;
  final bool settingsRestored;

  const ImportOutcome({
    required this.added,
    required this.replaced,
    required this.skipped,
    required this.settingsRestored,
  });
}

class BackupService {
  BackupService(this._repo, {DateTime Function()? clock})
    : _now = clock ?? DateTime.now;

  final BackupRepository _repo;
  final DateTime Function() _now;

  /// A friendly default file name, e.g. `fuata-backup-2026-09-30.json`.
  String suggestedFileName() {
    final d = _now();
    String two(int n) => n.toString().padLeft(2, '0');
    return 'fuata-backup-${d.year}-${two(d.month)}-${two(d.day)}.json';
  }

  Future<({String json, BackupSnapshot snapshot})> buildExport({
    bool includeRawText = false,
  }) async {
    final snapshot = await _repo.readAll();
    final json = BackupCodec.encode(
      snapshot,
      exportedAt: _now(),
      includeRawText: includeRawText,
    );
    return (json: json, snapshot: snapshot);
  }

  Future<ImportPreview> preview(String fileText) async {
    final decoded = BackupCodec.decode(fileText);
    final incoming = decoded.snapshot;
    final existing = await _repo.readAll();
    if (!decoded.ok || incoming == null) {
      return ImportPreview(
        decoded: decoded,
        plan: null,
        phoneHasData: existing.units.isNotEmpty,
      );
    }
    return ImportPreview(
      decoded: decoded,
      plan: ImportPlanner.plan(incoming: incoming, existing: existing),
      phoneHasData: existing.units.isNotEmpty,
    );
  }

  /// Applies [preview] under [policy]. Throws [StateError] if the preview
  /// was not importable — the screen never offers the button in that case,
  /// but this is the last line of defence against writing a bad file.
  Future<ImportOutcome> apply(
    ImportPreview preview, {
    required ConflictPolicy policy,
    required bool restoreSettings,
  }) async {
    final plan = preview.plan;
    if (!preview.canImport || plan == null) {
      throw StateError('This backup cannot be imported.');
    }
    final restore = restoreSettings ? plan.incomingSettings : null;
    await _repo.apply(plan.recordsToWrite(policy), settings: restore);

    final replaced = policy == ConflictPolicy.useFile ? plan.conflictCount : 0;
    return ImportOutcome(
      added: plan.addedCount,
      replaced: replaced,
      skipped: policy == ConflictPolicy.keepMine ? plan.conflictCount : 0,
      settingsRestored: restore != null,
    );
  }
}
</file>

<file path="lib/domain/logic/capture_pipeline.dart">
// ---------------------------------------------------------------------------
// The capture pipeline (issues #21 and #22): turns one message — pasted,
// shared, or read from an allowed app's notification — into a pending (or
// auto-accepted) transaction, a duplicate no-op, or an unparsed capture.
//
// This used to live inside CaptureService in capture_providers.dart and
// took a Riverpod `Ref`. The notification listener (#22) runs it in a
// *background isolate* with no ProviderScope and no widgets, so the logic
// moved here: it depends only on repository interfaces, which means the
// UI isolate and the background isolate run literally the same code, and
// it can be unit-tested without a device (test/domain/capture_pipeline_test.dart).
// CaptureService is now a thin Riverpod wrapper around it.
// ---------------------------------------------------------------------------
import 'package:fuata/domain/logic/parser.dart';
import 'package:fuata/domain/logic/serial_queue.dart';

import '../models/transaction.dart';
import '../repositories/repositories.dart';
import 'dedupe.dart';
import 'looks_financial.dart';

sealed class CaptureOutcome {
  const CaptureOutcome();
}

class Captured extends CaptureOutcome {
  final String transactionId;

  /// True when the auto-accept setting confirmed it immediately, so the
  /// caller's message can say "already added" instead of "waiting".
  final bool autoAccepted;
  const Captured(this.transactionId, {this.autoAccepted = false});
}

class CaptureDuplicate extends CaptureOutcome {
  const CaptureDuplicate();
}

class CaptureUnparsed extends CaptureOutcome {
  const CaptureUnparsed();
}

/// Nothing to do, and nothing stored: empty text, or (for notifications)
/// an app that isn't on the allow-list.
class CaptureIgnored extends CaptureOutcome {
  const CaptureIgnored();
}

class CaptureProcessor {
  CaptureProcessor({
    required this._units,
    required this._templates,
    required this._transactions,
    required this._captures,
    required this._sources,
    required this._settings,
    DateTime Function()? now,
  }) : _now = now ?? DateTime.now;

  final UnitRepository _units;
  final TemplateRepository _templates;
  final TransactionRepository _transactions;
  final CaptureRepository _captures;
  final CaptureSourceRepository _sources;
  final SettingsRepository _settings;
  final DateTime Function() _now;

  final _queue = SerialQueue();

/// A notification posted by [packageName] (#22). The native listener has
/// already dropped anything not on the allow-list before it ever woke
/// Dart; this checks again against the database, so the guarantee in
/// US-10 — "non-allowed notifications are discarded immediately and
/// never stored" — holds even if the native copy of the list is stale.
  Future<CaptureOutcome> captureNotification(String packageName, String text) async {
    final trimmed = text.trim();
    if (trimmed.isEmpty) return const CaptureIgnored();

    final sources = await _sources.watchSources().first;
    final allowed = sources.any((s) => s.enabled && s.packageName == packageName);
    if (!allowed) return const CaptureIgnored();

    return capture(
      trimmed,
      source: TxSource.notification,
      sourcePackage: packageName,
    );
  }

  /// Parses a message against the units' templates, dedupes against what's
  /// already stored, and inserts a pending row — or records an unparsed
  /// capture for the "Couldn't read these" list. This is where
  /// testing.md's P-07/P-08 dedupe cases actually run.
  Future<CaptureOutcome> capture(
      String text, {
        required TxSource source,
        String sourcePackage = 'shared',
      }) {
    final trimmed = text.trim();
    if (trimmed.isEmpty) return Future.value(const CaptureIgnored());
    return _queue.run(() => _capture(trimmed, source, sourcePackage));
  }

  Future<CaptureOutcome> _capture(
      String trimmed,
      TxSource source,
      String sourcePackage,
      ) async {
    // Read fresh from the repositories — never from a StreamProvider's
    // .future (hangs if nothing is watching) or .value (empty until
    // something has watched). `.first` always resolves.
    final units = await _units.watchUnits().first;
    final templates = await _templates.watchTemplates().first;

    if (units.isEmpty) {
      // Nothing to attach a transaction to — keep the message teachable,
      // unless it's an automatic notification that doesn't look like money
      // (issue #74, US-10).
      return _recordOrIgnore(sourcePackage, trimmed, source: source);
    }

    // Try each unit's templates in turn; a message belongs to whichever
    // unit's rules match it (P-06 picks between templates *within* a
    // unit — the unit itself is whoever matches first).
    for (final unit in units) {
      final unitTemplates = templates.where((t) => t.unitId == unit.id).toList();
      if (unitTemplates.isEmpty) continue;

      final result = Parser.parse(
        trimmed,
        unitTemplates,
        currencyCode: unit.currencyCode,
      );
      if (!result.matched) continue;
      final fields = result.fields;
      if (fields == null || fields.amountMinor == null) continue;

      final type = result.type ?? TxType.spent;
      final signed = type == TxType.got
          ? fields.amountMinor!
          : -fields.amountMinor!;
      final now = _now();
      final occurredAt = fields.occurredAt ?? now;

      final all = await _transactions.watchTransactions().first;
      if (Dedupe.isDuplicate(
        all,
        unitId: unit.id,
        amountMinor: signed,
        at: occurredAt,
        code: fields.code,
      )) {
        return const CaptureDuplicate();
      }

      final autoAccept = (await _settings.watchSettings().first).autoAcceptCaptures;
      final status = autoAccept ? TxStatus.confirmed : TxStatus.pending;
      final baseId = 'cap_${now.microsecondsSinceEpoch}';
      await _transactions.addTransaction(
        MoneyTransaction(
          id: baseId,
          unitId: unit.id,
          type: type,
          amountMinor: signed,
          counterparty: fields.counterparty,
          code: fields.code,
          occurredAt: occurredAt,
          createdAt: now,
          source: source,
          status: status,
          templateId: result.template!.id,
          balanceAfterMinor: fields.balanceAfterMinor,
          // rawText stays null — raw messages are opt-in only (ADR-009);
          // only unparsed captures keep text, because that's their point.
        ),
      );
      if (fields.feeMinor != null && fields.feeMinor! > 0) {
        // ADR-005: the fee is its own child `spent` row, pending too, so
        // it confirms — or is discarded — together with its parent.
        await _transactions.addTransaction(
          MoneyTransaction(
            id: '${baseId}_fee',
            unitId: unit.id,
            type: TxType.spent,
            amountMinor: -fields.feeMinor!,
            counterparty: 'Fee',
            occurredAt: occurredAt,
            createdAt: now,
            source: source,
            status: status,
            parentId: baseId,
          ),
        );
      }
      return Captured(baseId, autoAccepted: autoAccept);
    }

    // No template matched. Gate the same way before recording.
    return _recordOrIgnore(sourcePackage, trimmed, source: source);
  }

  /// Where the pipeline has decided nothing matched. Records the text as
  /// "Couldn't read this" — or refuses to, when it arrived automatically
  /// (a notification from an allowed app) and doesn't look like a payment.
  ///
  /// The gate is notifications-only on purpose: a share or paste is the
  /// person handing Fuata the text, and gating that would tell them "I
  /// can't help with that" for no reason they can act on. Issue #74.
  Future<CaptureOutcome> _recordOrIgnore(
      String sourcePackage,
      String rawText, {
        required TxSource source,
      }) async {
    if (source == TxSource.notification && !LooksFinancial.check(rawText)) {
      return const CaptureIgnored();
    }
    await _recordUnparsed(sourcePackage, rawText);
    return const CaptureUnparsed();
  }

  /// Same app + same text is one entry, not one per arrival. Notifications
  /// get re-posted (a chat app updating its notification, a listener
  /// rebind) and "Teach me" re-runs capture on the text it already holds,
  /// so without this the "Couldn't read these" list fills with copies.
  Future<void> _recordUnparsed(String sourcePackage, String rawText) async {
    final existing = await _captures.watchUnparsed().first;
    final already = existing.any(
          (u) => u.sourcePackage == sourcePackage && u.rawText == rawText,
    );
    if (already) return;
    await _captures.recordUnparsed(
      id: 'unp_${_now().microsecondsSinceEpoch}',
      sourcePackage: sourcePackage,
      rawText: rawText,
    );
  }
}
</file>

<file path="lib/domain/logic/dedupe.dart">
import 'package:fuata/data/constants/captures_constants.dart';

import '../models/transaction.dart';

/// Dedupe rule from requirements.md section 5: "by transaction code when
/// present; otherwise unit + amount + 2-minute window" — testing.md
/// P-07 (same code seen twice -> one row) and P-08 (the same payment
/// arriving as both an SMS and a push notification, no code -> one row).
///
/// Pure function over already-loaded transactions so it is unit-testable
/// without a database; the capture service (#21) loads the list and
/// calls this before inserting a captured transaction. This is where
/// parser_test.dart's deferred P-07/P-08 cases actually live.
class Dedupe {
  const Dedupe._();

  static const defaultWindow = dedupeWindowDuration;

/// [at] is when the money moved (the parsed date, or now if the
/// message carried none). [amountMinor] is the SIGNED effect on the
/// balance, matching how rows are stored (ADR-004).
 static bool isDuplicate(List<MoneyTransaction> existing, {
   required String unitId,
   required int amountMinor,
   required DateTime at,
   String? code,
   Duration window = defaultWindow,
 }) {
   final trimmedCode = code?.trim();
   if (trimmedCode != null && trimmedCode.isNotEmpty) {
     // P-07: the code is provider-unique, so any row in this unit with
     // the same code is the same payment — regardless of amount or
     // when it says it happened.
     return existing.any(
           (t) => t.unitId == unitId && t.code == trimmedCode,
     );
   }

   // P-08: no code -> same unit, same signed amount, inside the window.
   return existing.any(
         (t) =>
     t.unitId == unitId &&
         t.amountMinor == amountMinor &&
         t.occurredAt.difference(at).abs() <= window,
   );
 }
}
</file>

<file path="lib/domain/logic/looks_financial.dart">
// ---------------------------------------------------------------------------
// "Does this notification look like it's about money?" (issue #74, US-10)
//
// Fuata keeps a notification from a watched app as "Couldn't read this"
// only when it might be a payment. Everything else — chats, delivery
// updates, OTPs — is dropped at the pipeline boundary and never reaches
// the database or a backup.
//
// The bar is deliberately high: a false negative costs a "Teach me"
// prompt (the person can paste the message by hand if they want), a
// false positive costs a private chat in the database. When in doubt,
// drop.
// ---------------------------------------------------------------------------

class LooksFinancial {
  LooksFinancial._();

  /// Currency tokens common in the messages Fuata sees. `\b` around the
  /// word-shaped ones so "KESHO" (Swahili for tomorrow) can't match
  /// "KSH"; the `/=` shorthand isn't word-shaped, so it stands alone.
  static final _currencyWord = RegExp(
    // \b on the left stops "KESHO" matching "KSH". On the right, allow a
    // digit OR a boundary, so "Ksh350", "KES 500" and a bare "KSH" all
    // match, but "KESHO" (next char H) still doesn't.
    r'\b(?:KES|KSH|Ksh|USh|TSh|NGN|GHS|ZAR|USD|EUR|GBP)(?=\d|\b)',
    caseSensitive: false,
  );
  static final _currencySym = RegExp(r'/=');

  /// A number that reads like an amount: has thousands separators or a
  /// two-decimal tail. A bare integer doesn't count — "3 new messages"
  /// mustn't match, and a message with no shape at all ("pay 1200") is
  /// close enough to noise that the person pasting it by hand is a
  /// better story than a false positive.
  static final _moneyAmount = RegExp(r'\d[\d,]*(?:\.\d{1,2})?');

  /// Words a message uses when it's about a payment. Kept tight and
  /// lowercase; matched case-insensitively.
  static final _moneyWords = RegExp(
    r'\b(?:sent|received|paid|pay|debited|credited|credited|transferred|'
    r'transfer|withdraw|withdrew|deposited|deposit|balance|bal)\b',
    caseSensitive: false,
  );

  /// Words that flag a one-time code.
  static final _otpWords = RegExp(
    r'\b(?:code|otp|pin|password|verification|verify)\b',
    caseSensitive: false,
  );

  /// A short run of digits — 4 to 8, the usual length of an OTP.
  static final _codeShaped = RegExp(r'\b\d{4,8}\b');

  /// True when the text could plausibly be a payment message Fuata
  /// should offer to teach. One-time codes are always false, even when
  /// the surrounding text also looks financial.
  static bool check(String text) {
    if (text.trim().isEmpty) return false;
    if (_looksLikeOneTimeCode(text)) return false;
    if (_currencyWord.hasMatch(text)) return true;
    if (_currencySym.hasMatch(text)) return true;
    return _hasAmountNearMoneyWord(text);
  }

  /// A number with a money shape (comma or decimals) inside a short
  /// window around one of [_moneyWords]. 80 characters each side is
  /// about one SMS clause; enough to catch "paid 1,500 to ...", not so
  /// much that a stray "balance" word elsewhere trips it.
  static bool _hasAmountNearMoneyWord(String text) {
    for (final m in _moneyAmount.allMatches(text)) {
      final raw = m[0]!;
      final hasMoneyShape = raw.contains(',') || raw.contains('.');
      if (!hasMoneyShape) continue;
      final start = (m.start - 80).clamp(0, text.length);
      final end = (m.end + 80).clamp(0, text.length);
      if (_moneyWords.hasMatch(text.substring(start, end))) return true;
    }
    return false;
  }

  /// A 4-to-8-digit run inside a short window around a code-ish word.
  /// 40 characters each side catches "Your code is 445566" and
  /// "Verify with 1234 to confirm ..." without spanning the whole
  /// message.
  static bool _looksLikeOneTimeCode(String text) {
    for (final m in _codeShaped.allMatches(text)) {
      final start = (m.start - 40).clamp(0, text.length);
      final end = (m.end + 40).clamp(0, text.length);
      if (_otpWords.hasMatch(text.substring(start, end))) return true;
    }
    return false;
  }
}
</file>

<file path="lib/domain/logic/serial_queue.dart">
import 'dart:async';

/// Runs async actions strictly one after another, in the order they were
/// submitted. A failing action completes *its own* future with the error
/// and never blocks the actions behind it.
///
/// Why this exists (issue #22): capture is check-then-insert (dedupe reads
/// the stored rows, then writes one). Two notifications arriving together
/// — say the same payment as an SMS and as a push — would both read
/// "nothing stored yet" and both insert. Serialising the whole
/// check-and-insert closes that race inside one isolate.
class SerialQueue {
  Future<void> _tail = Future<void>.value();

  Future<T> run<T>(Future<T> Function() action) {
    final completer = Completer<T>();
    _tail = _tail.then((_) async {
      try {
        completer.complete(await action());
      } catch (e, st) {
        completer.completeError(e, st);
      }
    });
    return completer.future;
  }
}
</file>

<file path="lib/domain/logic/summary.dart">
import '../models/money.dart';
import '../models/transaction.dart';
import 'ledger.dart';

/// Issue #23 / US-12: Today, this week, this month.
///
/// Pure Dart like the rest of `domain/logic` — no Flutter, no I/O — so the
/// figures can be unit-tested against hand-calculated totals
/// (testing.md, "Summaries").
enum SummaryPeriod { day, week, month }

extension SummaryPeriodWords on SummaryPeriod {
  /// Segmented-control label (ui-design-brief.md 7.11).
  String get label => switch (this) {
    SummaryPeriod.day => 'Day',
    SummaryPeriod.week => 'Week',
    SummaryPeriod.month => 'Month',
  };

  String get thisWord => switch (this) {
    SummaryPeriod.day => 'today',
    SummaryPeriod.week => 'this week',
    SummaryPeriod.month => 'this month',
  };

  String get previousWord => switch (this) {
    SummaryPeriod.day => 'yesterday',
    SummaryPeriod.week => 'last week',
    SummaryPeriod.month => 'last month',
  };
}

/// One line in "Where it went" / "Where it came from".
class RankedTotal {
  final String label;
  final int minor;
  final int count;
  const RankedTotal({
    required this.label,
    required this.minor,
    required this.count,
  });
}

/// One slice of the per-unit split.
class UnitTotal {
  final String unitId;
  final int minor;
  const UnitTotal({required this.unitId, required this.minor});
}

/// One slice of the per-category split (issue #83).
class CategoryTotal {
  final String categoryId;
  final int minor;
  const CategoryTotal({required this.categoryId, required this.minor});
}

/// "KSh 8,420" — whole amounts drop the ".00" so a story reads like a
/// sentence. Display only; nothing is computed from the string.
String friendlyMoney(
    int minor,
    String currencyCode, {
      bool masked = false,
    }) {
  if (masked) return kHiddenAmountMask;
  var text = Money(minor, currencyCode).format();
  if (text.endsWith('.00')) text = text.substring(0, text.length - 3);
  return '${currencySymbol(currencyCode)}$text';
}

class PeriodSummary {
  final SummaryPeriod period;

  /// [from, to) of the period being summarised, local time.
  final DateTime from;
  final DateTime to;

  final int spentMinor;
  final int gotMinor;

  /// The same stretch of the previous period (see [build]) so "so far"
  /// is compared with "so far" rather than with a finished week.
  final int previousSpentMinor;
  final int previousGotMinor;

  /// Ranked, biggest first. Only named counterparties appear.
  final List<RankedTotal> spentTo;
  final List<RankedTotal> gotFrom;

  /// Spending with no counterparty, so "See all" plus this adds up to
  /// [spentMinor].
  final int unnamedSpentMinor;

  final List<UnitTotal> spentByUnit;

  /// Confirmed spent/got entries in the period. Fee rows belong to their
  /// parent and are not counted separately.
  final int transactionCount;

  /// Days from [from] up to today, counting today. Used for the average.
  final int daysSoFar;

  final List<CategoryTotal> spentByCategory;

  const PeriodSummary({
    required this.period,
    required this.from,
    required this.to,
    required this.spentMinor,
    required this.gotMinor,
    required this.previousSpentMinor,
    required this.previousGotMinor,
    required this.spentTo,
    required this.gotFrom,
    required this.unnamedSpentMinor,
    required this.spentByUnit,
    required this.transactionCount,
    required this.daysSoFar,
    required this.spentByCategory,
  });

  bool get hasActivity => transactionCount > 0;

  int get netMinor => gotMinor - spentMinor;

  /// Average spent per day so far. Integer division: display only.
  int get averageSpentPerDayMinor =>
      daysSoFar <= 0 ? 0 : spentMinor ~/ daysSoFar;

  /// [include] narrows which transactions count, e.g. only units in one
  /// currency (testing.md T-13: a different-currency unit is excluded
  /// rather than added to the total as if it were the same money).
  static PeriodSummary build( Iterable<MoneyTransaction> all,
SummaryPeriod period,
DateTime now, {
bool Function(MoneyTransaction)? include,}) {
    final list = all.where((t) => include?.call(t) ?? true).toList();

    final (from, to) = switch (period) {
      SummaryPeriod.day => Ledger.todayRange(now),
      SummaryPeriod.week => Ledger.weekRange(now),
      SummaryPeriod.month => Ledger.monthRange(now),
    };

    // Previous period, cut at the same elapsed time. DateTime's
    // constructor normalises day 0 / month 0 across month and year edges.
    final prevFrom = switch (period) {
      SummaryPeriod.day => DateTime(from.year, from.month, from.day - 1),
      SummaryPeriod.week => DateTime(from.year, from.month, from.day - 7),
      SummaryPeriod.month => DateTime(from.year, from.month - 1, 1),
    };
    final aligned = prevFrom.add(now.difference(from));
    final prevTo = aligned.isAfter(from) ? from : aligned;

    final byId = {for (final t in list) t.id: t};
    final spentTo = <String, _Acc>{};
    final gotFrom = <String, _Acc>{};
    final unitSpent = <String, int>{};
    final categorySpent = <String, int>{};
    var spent = 0;
    var got = 0;
    var unnamed = 0;
    var count = 0;

    for (final t in list) {
      if (!t.countsAsSpending && !t.countsAsIncome) continue;
      if (t.occurredAt.isBefore(from) || !t.occurredAt.isBefore(to)) continue;

      final isFee = t.parentId != null;
      if (!isFee) count++;
      final name = _nameOf(t, byId);

      if (t.countsAsSpending) {
        final amount = -t.amountMinor;
        spent += amount;
        unitSpent[t.unitId] = (unitSpent[t.unitId] ?? 0) + amount;
        if (name == null) {
          unnamed += amount;
        } else {
          spentTo
              .putIfAbsent(name.toLowerCase(), () => _Acc(name))
              .add(amount, isFee);
        }

        final cat = t.categoryId;
        if (cat != null) {
          categorySpent[cat] = (categorySpent[cat] ?? 0) + amount;
        }
      } else {
        got += t.amountMinor;
        if (name != null) {
          gotFrom
              .putIfAbsent(name.toLowerCase(), () => _Acc(name))
              .add(t.amountMinor, isFee);
        }
      }
    }

    return PeriodSummary(
      period: period,
      from: from,
      to: to,
      spentMinor: spent,
      gotMinor: got,
      previousSpentMinor: Ledger.spentInPeriod(list, prevFrom, prevTo),
      previousGotMinor: Ledger.gotInPeriod(list, prevFrom, prevTo),
      spentTo: _ranked(spentTo),
      gotFrom: _ranked(gotFrom),
      unnamedSpentMinor: unnamed,
      spentByUnit: [
        for (final e in unitSpent.entries)
          UnitTotal(unitId: e.key, minor: e.value),
      ]..sort((a, b) {
        final byAmount = b.minor.compareTo(a.minor);
        return byAmount != 0 ? byAmount : a.unitId.compareTo(b.unitId);
      }),
      spentByCategory: [
        for (final e in categorySpent.entries)
          CategoryTotal(categoryId: e.key, minor: e.value),
      ]..sort((a, b) {
        final byAmount = b.minor.compareTo(a.minor);
        return byAmount != 0
            ? byAmount
            : a.categoryId.compareTo(b.categoryId);
      }),
      transactionCount: count,
      daysSoFar: DateTime(now.year, now.month, now.day)
          .difference(DateTime(from.year, from.month, from.day))
          .inDays +
          1,
    );
  }

  /// The story card's copy (ui-design-brief.md 7.11): plain sentences,
  /// never guilt. Example: "This week you spent KSh 8,420. Java House was
  /// your top spot. A bit more than last week."
  String story(String currencyCode, {bool masked = false}) {
    final when = period.thisWord;

    if (!hasActivity) return 'Nothing recorded $when yet.';

    if (spentMinor == 0) {
      return "You haven't spent anything $when, and "
          '${friendlyMoney(gotMinor, currencyCode, masked: masked)} came in.';
    }

    final sentences = <String>[
      '${_capitalise(when)} you spent '
          '${friendlyMoney(spentMinor, currencyCode, masked: masked)}.',
      if (spentTo.isNotEmpty) '${spentTo.first.label} was your top spot.',
      ?_comparison(),
    ];
    return sentences.join(' ');
  }

  String? _comparison() {
    if (spentMinor <= 0 || previousSpentMinor <= 0) return null;
    final now100 = spentMinor * 100;
    final was = previousSpentMinor;
    final String phrase;
    if (now100 >= was * 125) {
      phrase = 'Quite a bit more than';
    } else if (now100 > was * 105) {
      phrase = 'A bit more than';
    } else if (now100 <= was * 75) {
      phrase = 'Quite a bit less than';
    } else if (now100 < was * 95) {
      phrase = 'A bit less than';
    } else {
      phrase = 'About the same as';
    }
    return '$phrase ${period.previousWord}.';
  }

  static String _capitalise(String s) =>
      s.isEmpty ? s : '${s[0].toUpperCase()}${s.substring(1)}';

  /// Counterparty of [t], or of its parent for a fee row (a fee belongs to
  /// the payment it came with). Null when nothing names it.
  static String? _nameOf(MoneyTransaction t, Map<String, MoneyTransaction> byId) {
    final own = t.counterparty?.trim();
    if (own != null && own.isNotEmpty) return own;
    final parentId = t.parentId;
    if (parentId == null) return null;
    final parent = byId[parentId]?.counterparty?.trim();
    return (parent != null && parent.isNotEmpty) ? parent : null;
  }

  static List<RankedTotal> _ranked(Map<String, _Acc> accs) {
    final out = [
      for (final a in accs.values)
        RankedTotal(label: a.label, minor: a.minor, count: a.count),
    ];
    out.sort((a, b) {
      final byAmount = b.minor.compareTo(a.minor);
      return byAmount != 0
          ? byAmount
          : a.label.toLowerCase().compareTo(b.label.toLowerCase());
    });
    return out;
  }
}

/// Running total for one counterparty. Grouped case-insensitively; the
/// first spelling seen is the one shown.
class _Acc {
  final String label;
  int minor = 0;
  int count = 0;
  _Acc(this.label);

  void add(int amount, bool isFee) {
    minor += amount;
    if (!isFee) count++;
  }
}
</file>

<file path="lib/domain/models/capture_source.dart">
/// design.md CAPTURE_SOURCE: one app whose notifications Fuata is allowed
/// to read (US-10). The set of *enabled* sources is the allow-list —
/// anything posted by a package that isn't in it is discarded the moment
/// it arrives and never stored (requirements.md, Privacy row).
///
/// Turning an app off keeps the row and flips [enabled] rather than
/// deleting it: `Templates.captureSourceId` references this table, and a
/// delete would trip the foreign key the moment a rule is tied to an app.
class CaptureSource {
  final String id;
  final String packageName;
  final String displayName;
  final bool enabled;

  const CaptureSource({
    required this.id,
    required this.packageName,
    required this.displayName,
    this.enabled = true,
  });

  // One row per package, by construction: the id is derived from the
  /// package name, so saving the same app twice is an upsert rather than a
  /// duplicate (the table has no unique index on `packageName`, and
  /// changing a table definition without a migration is off the table).
  static String idFor(String packageName) => 'src_$packageName';

  CaptureSource copyWith({String? displayName, bool? enabled}) {
    return CaptureSource(
      id: id,
      packageName: packageName,
      displayName: displayName ?? this.displayName,
      enabled: enabled ?? this.enabled,
    );
  }
}
