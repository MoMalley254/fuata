// NOTE: integrate with the real theme from issue #6.
// This file defines its own status-colour lookup (matching
// docs/ui-design-brief.md section 4) so it works standalone;
// replace _statusColor with your theme's token if one already exists.
Color _statusColor(SpendStatus status, BuildContext context) {
  return switch (status) {
    SpendStatus.safe => const Color(0xFF2E9E6B),
    SpendStatus.warning => const Color(0xFFE8A317),
    SpendStatus.danger => const Color(0xFFE5533D),
    SpendStatus.overdraft => const Color(0xFFB3123F),
  };
}

class HomeScreen extends ConsumerWidget {
  const HomeScreen({super.key, required this.onToggleMode});
  final VoidCallback onToggleMode;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final homeAsync = ref.watch(homeStateProvider);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Today'),
        actions: [
          IconButton(
            onPressed: onToggleMode,
            icon: const Icon(Icons.brightness_6_rounded),
          ),
        ],
      ),
      body: SafeArea(
        child: homeAsync.when(
          loading: () => const Center(child: CircularProgressIndicator()),
          error: (e, st) => Center(child: Text('Something went wrong: $e')),
          data: (state) => state.units.isEmpty
              ? const _EmptyHome()
              : _HomeContent(state: state),
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _openAddTransaction(context),
        child: const Icon(Icons.add),
      ),
    );
  }

  void _openAddTransaction(BuildContext context) {
    // Wired up properly in issue #9 (add-transaction sheet).
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Add transaction — coming in #9')),
    );
  }
}

class _HomeContent extends StatelessWidget {
  final HomeState state;
  const _HomeContent({required this.state});

  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.fromLTRB(20, 12, 20, 100),
      children: [
        const _Greeting(name: 'Amina'), // TODO: from settings (#12)
        const SizedBox(height: 20),
        _HeroStatusCard(state: state),
        const SizedBox(height: 24),
        Text('My money', style: Theme.of(context).textTheme.titleMedium),
        const SizedBox(height: 12),
        _UnitRow(state: state),
        const SizedBox(height: 24),
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Text('Lately', style: Theme.of(context).textTheme.titleMedium),
            TextButton(onPressed: () {}, child: const Text('See all')),
          ],
        ),
        const SizedBox(height: 4),
        if (state.lately.isEmpty)
          const Padding(
            padding: EdgeInsets.symmetric(vertical: 16),
            child: Text('Nothing yet today. Nice and calm.'),
          )
        else
          ...state.lately.map((t) => _TransactionRow(
            transaction: t,
            unit: state.units.firstWhere((u) => u.id == t.unitId),
          )),
      ],
    );
  }
}

class _Greeting extends StatelessWidget {
  final String name;
  const _Greeting({required this.name});

  @override
  Widget build(BuildContext context) {
    final today = DateFormat('EEEE, d MMM').format(DateTime.now());
    return Row(
