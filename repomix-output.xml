import 'package:intl/intl.dart';

/// Number of decimal places for a currency's minor unit.
/// Extend as needed; unknown codes default to 2 (matches ADR-003).
int minorUnitExponent(String currencyCode) {
  const zeroDecimal = {'JPY', 'UGX', 'KRW', 'VND', 'CLP'};
  return zeroDecimal.contains(currencyCode.toUpperCase()) ? 0 : 2;
}

/// Display symbol/prefix for a currency. Falls back to the code itself
/// (with a trailing space) for anything not listed — never guess wrong.
String currencySymbol(String currencyCode) {
  const symbols = {
    'KES': 'KSh ',
    'UGX': 'USh ',
    'TZS': 'TSh ',
    'USD': '\$',
    'EUR': '€',
    'GBP': '£',
    'NGN': '₦',
  };
  return symbols[currencyCode.toUpperCase()] ?? '${currencyCode.toUpperCase()} ';
}

int pow10(int exponent) {
  var r = 1;
  for (var i = 0; i < exponent; i++) {
    r *= 10;
  }
  return r;
}

/// All amounts in the app are integers in the currency's minor unit
/// (e.g. cents). Never use double for money (ADR-003). `majorValue`
/// exists only to bridge into widgets built around double + symbol
/// (StatusRingCard, UnitCard, TransactionRow) — never store or do
/// arithmetic on it.
class Money {
  final int minor;
  final String currencyCode;

  const Money(this.minor, this.currencyCode);

  factory Money.zero(String currencyCode) => Money(0, currencyCode);

  /// Parses a human-entered major-unit string ("1,250.50") into Money.
  /// Throws FormatException on invalid input.
  factory Money.parseMajor(String input, String currencyCode) {
    final cleaned = input.replaceAll(',', '').trim();
    if (cleaned.isEmpty) throw const FormatException('Empty amount');
    final exponent = minorUnitExponent(currencyCode);
    final parts = cleaned.split('.');
    final wholePart = int.parse(parts[0].isEmpty ? '0' : parts[0]);
    int fractionPart = 0;
    if (parts.length > 1 && exponent > 0) {
      final frac = parts[1].padRight(exponent, '0').substring(0, exponent);
      fractionPart = int.parse(frac);
    }
    final factor = pow10(exponent);
    final sign = cleaned.startsWith('-') ? -1 : 1;
    return Money(sign * (wholePart.abs() * factor + fractionPart), currencyCode);
  }

  Money operator +(Money other) {
    assert(currencyCode == other.currencyCode, 'Currency mismatch');
    return Money(minor + other.minor, currencyCode);
  }

  Money operator -(Money other) {
    assert(currencyCode == other.currencyCode, 'Currency mismatch');
    return Money(minor - other.minor, currencyCode);
  }

  Money operator -() => Money(-minor, currencyCode);

  bool get isNegative => minor < 0;
  bool get isZero => minor == 0;

  /// Double major-unit value, e.g. 125050 minor -> 1250.50. Display-only
  /// bridge for widgets that take double + a currency symbol string.
  double get majorValue => minor / pow10(minorUnitExponent(currencyCode));

  /// Formatted for display, e.g. "1,250.50".
  String format({bool showSign = false}) {
    final exponent = minorUnitExponent(currencyCode);
    final divisor = pow10(exponent);
    final major = minor.abs() / divisor;
    final formatter = NumberFormat.currency(
      symbol: '',
      decimalDigits: exponent,
    );
    final formatted = formatter.format(major).trim();
    final sign = minor < 0 ? '-' : (showSign ? '+' : '');
    return '$sign$formatted';
  }

  @override
  String toString() => '${format()} $currencyCode';
}
</file>

<file path="lib/domain/models/transaction.dart">
enum TxType { spent, got, moved, adjustment }

enum TxSource { manual, shared, notification }

enum TxStatus { confirmed, pending }

/// A single ledger entry. amountMinor is the SIGNED effect on the unit's
/// balance (outflows negative) — see design.md ADR-004/ADR-005.
/// Transfers are two rows sharing transferGroupId; fees are a separate
/// `spent` row with parentId pointing at the transaction they belong to.
class MoneyTransaction {
  final String id;
  final String unitId;
  final TxType type;
  final int amountMinor;
  final String? counterparty;
  final String? categoryId;
  final String? note;
  final String? code;
  final DateTime occurredAt;
  final DateTime createdAt;
  final TxSource source;
  final TxStatus status;
  final String? transferGroupId;
  final String? parentId;
  final String? templateId;
  final int? balanceAfterMinor;
  final String? rawText; // null by default (privacy) — see ADR-009

  const MoneyTransaction({
    required this.id,
    required this.unitId,
    required this.type,
    required this.amountMinor,
    required this.occurredAt,
    required this.createdAt,
    this.counterparty,
    this.categoryId,
    this.note,
    this.code,
    this.source = TxSource.manual,
    this.status = TxStatus.confirmed,
    this.transferGroupId,
    this.parentId,
    this.templateId,
    this.balanceAfterMinor,
    this.rawText,
  });

  bool get isConfirmed => status == TxStatus.confirmed;
  bool get countsAsSpending => type == TxType.spent && isConfirmed;
  bool get countsAsIncome => type == TxType.got && isConfirmed;

  MoneyTransaction copyWith({TxStatus? status}) {
    return MoneyTransaction(
      id: id,
      unitId: unitId,
      type: type,
      amountMinor: amountMinor,
      counterparty: counterparty,
      categoryId: categoryId,
      note: note,
      code: code,
      occurredAt: occurredAt,
      createdAt: createdAt,
      source: source,
      status: status ?? this.status,
      transferGroupId: transferGroupId,
      parentId: parentId,
      templateId: templateId,
      balanceAfterMinor: balanceAfterMinor,
      rawText: rawText,
    );
  }
}
