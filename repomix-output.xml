<file path="lib/domain/logic/parser.dart">
import 'package:intl/intl.dart';

import '../models/money.dart';
import '../models/template.dart';
import '../models/transaction.dart';

/// The typed fields recovered from a message, in the vocabulary
/// requirements.md US-08 asks the rule builder to let the user label:
/// amount, code, date, person, balance, fee. All-optional because not
/// every template labels every field (e.g. a template with no fee).
class ParsedFields {
  final int? amountMinor;
  final int? feeMinor;
  final int? balanceAfterMinor;
  final String? code;
  final DateTime? occurredAt;
  final String? counterparty;

  const ParsedFields({
    this.amountMinor,
    this.feeMinor,
    this.balanceAfterMinor,
    this.code,
    this.occurredAt,
    this.counterparty,
  });

  @override
  String toString() =>
      'ParsedFields(amount: $amountMinor, fee: $feeMinor, balanceAfter: $balanceAfterMinor, '
      'code: $code, occurredAt: $occurredAt, counterparty: $counterparty)';
}

/// The outcome of `Parser.parse`. A non-match (testing.md P-05) is a
/// normal, expected result — callers route it to the "couldn't read this"
/// list (design.md's capture flow), not an error.
class ParseResult {
  final CaptureTemplate? template;
  final TxType? type;
  final ParsedFields? fields;

  const ParseResult._({this.template, this.type, this.fields});

  const ParseResult.noMatch() : this._();

  const ParseResult.matched({
    required CaptureTemplate template,
    required TxType type,
    required ParsedFields fields,
  }) : this._(template: template, type: type, fields: fields);

  bool get matched => template != null;
}

/// Pure functions only — no Flutter, no I/O (design.md section 1) — so
/// this is unit-testable against fake messages without a device
/// (testing.md's Parser plan, P-01 to P-12). Dedupe against already-stored
/// transactions needs repository access and is out of scope here; it's
/// built alongside the review inbox and listener (#21/#22).
class Parser {
  const Parser._();

  /// Tries each enabled template in order (a unit can have several — one
  /// per message shape, testing.md P-06) and returns the first match.
  /// [currencyCode] is the unit's currency, used to turn a captured amount
  /// string into minor units via [Money.parseMajor].
  static ParseResult parse(
    String message,
    List<CaptureTemplate> templates, {
    required String currencyCode,
  }) {
    for (final template in templates.where((t) => t.enabled)) {
      final match = template.compiled.firstMatch(message);
      if (match == null) continue;

      int? amountMinor;
      int? feeMinor;
      int? balanceAfterMinor;
      String? code;
      DateTime? occurredAt;
      String? counterparty;

      for (final entry in template.fieldMap.entries) {
        final raw = match.namedGroup(entry.key);
        if (raw == null) continue;
        switch (entry.value) {
          case TemplateFieldType.amount:
            amountMinor = _parseAmountMinor(raw, currencyCode);
            break;
          case TemplateFieldType.fee:
            feeMinor = _parseAmountMinor(raw, currencyCode);
            break;
          case TemplateFieldType.balance:
            balanceAfterMinor = _parseAmountMinor(raw, currencyCode);
            break;
          case TemplateFieldType.code:
            code = raw.trim();
            break;
          case TemplateFieldType.date:
            occurredAt = _parseDate(raw.trim());
            break;
          case TemplateFieldType.person:
            counterparty = raw.trim();
            break;
        }
      }

      // A match with no amount isn't a usable transaction — keep trying
      // other templates rather than returning a half-parsed result.
      if (amountMinor == null) continue;

      return ParseResult.matched(
        template: template,
        type: _resolveType(template.direction, message),
        fields: ParsedFields(
          amountMinor: amountMinor,
          feeMinor: feeMinor,
          balanceAfterMinor: balanceAfterMinor,
          code: code,
          occurredAt: occurredAt,
          counterparty: counterparty,
        ),
      );
    }
    return const ParseResult.noMatch();
  }

  static TxType _resolveType(TemplateDirection direction, String message) {
    switch (direction) {
      case TemplateDirection.spent:
        return TxType.spent;
      case TemplateDirection.got:
        return TxType.got;
      case TemplateDirection.either:
        final lower = message.toLowerCase();
        const gotWords = ['received', 'credited', 'deposit'];
        return gotWords.any(lower.contains) ? TxType.got : TxType.spent;
    }
  }

  ///#20 Parses one labeled money capture. Returns null instead of throwing —
  /// a labeled field that we can't parse should be reported as "not found"
  /// for that field, never abort the whole parse. (Amount's null is then
  /// treated as "no match" by the caller; fee/balance's null just means
  /// those rows show as "not labeled".)
  static int? _parseAmountMinor(String raw, String currencyCode) {
    final stripped = raw
        .replaceFirst(RegExp(r'^[A-Za-z]{2,5}\.?\s*'), '')
        .replaceAll(RegExp(r'[.,;:!?]+$'), '')
        .trim();
    if (stripped.isEmpty) return null;
    try {
      return Money.parseMajor(stripped, currencyCode).minor;
    } on FormatException {
      return null;
    }
  }

  /// testing.md P-09: "21/9/26 at 1:12 PM" and ISO both need to parse to
  /// the correct timestamp. `DateTime.tryParse` covers ISO 8601 (with a
  /// "T" or a space separator); a short list of `intl` patterns covers the
  /// common bank/mobile-money shapes. Returns null rather than throwing —
  /// a message that otherwise matched shouldn't be discarded over a date
  /// the app doesn't yet know how to read.
  static DateTime? _parseDate(String raw) {
    final cleaned = raw.replaceAll(RegExp(r'[.,;:!?]+$'), '').trim();
    if (cleaned.isEmpty) return null;

    final iso = DateTime.tryParse(cleaned);
    if (iso != null) return iso;

    const patterns = [
      "d/M/yy 'at' h:mm a",
      "d/M/yyyy 'at' h:mm a",
      'd/M/yy HH:mm',
      'd/M/yyyy HH:mm',
      'd/M/yy',
      'd/M/yyyy',
    ];
    for (final p in patterns) {
      try {
        //#20
        // Pin the locale: without it DateFormat uses the device locale,
        // which may not have a 12-hour AM/PM pattern defined and can fail
        // to parse "10:19 AM" on some devices.
        return DateFormat(p, 'en_US').parse(cleaned);
      } on FormatException {
        continue;
      }
    }
    return null;
  }
}
</file>

<file path="lib/domain/models/money.dart">
import 'package:intl/intl.dart';

/// Number of decimal places for a currency's minor unit.
/// Extend as needed; unknown codes default to 2 (matches ADR-003).
int minorUnitExponent(String currencyCode) {
  const zeroDecimal = {'JPY', 'UGX', 'KRW', 'VND', 'CLP'};
  return zeroDecimal.contains(currencyCode.toUpperCase()) ? 0 : 2;
}

/// Display symbol/prefix for a currency. Falls back to the code itself
/// (with a trailing space) for anything not listed — never guess wrong.
String currencySymbol(String currencyCode) {
  const symbols = {
    'KES': 'KSh ',
    'UGX': 'USh ',
    'TZS': 'TSh ',
    'USD': '\$',
    'EUR': '€',
    'GBP': '£',
    'NGN': '₦',
  };
  return symbols[currencyCode.toUpperCase()] ?? '${currencyCode.toUpperCase()} ';
}

int pow10(int exponent) {
  var r = 1;
  for (var i = 0; i < exponent; i++) {
    r *= 10;
  }
  return r;
}

/// All amounts in the app are integers in the currency's minor unit
/// (e.g. cents). Never use double for money (ADR-003). `majorValue`
/// exists only to bridge into widgets built around double + symbol
/// (StatusRingCard, UnitCard, TransactionRow) — never store or do
/// arithmetic on it.
class Money {
  final int minor;
  final String currencyCode;

  const Money(this.minor, this.currencyCode);

  factory Money.zero(String currencyCode) => Money(0, currencyCode);

  /// Parses a human-entered major-unit string ("1,250.50") into Money.
  /// Throws FormatException on invalid input.
  factory Money.parseMajor(String input, String currencyCode) {
    final cleaned = input.replaceAll(',', '').trim();
    if (cleaned.isEmpty) throw const FormatException('Empty amount');
    final exponent = minorUnitExponent(currencyCode);
    final parts = cleaned.split('.');
    final wholePart = int.parse(parts[0].isEmpty ? '0' : parts[0]);
    int fractionPart = 0;
    if (parts.length > 1 && exponent > 0) {
      final frac = parts[1].padRight(exponent, '0').substring(0, exponent);
      fractionPart = int.parse(frac);
    }
    final factor = pow10(exponent);
    final sign = cleaned.startsWith('-') ? -1 : 1;
    return Money(sign * (wholePart.abs() * factor + fractionPart), currencyCode);
  }

  Money operator +(Money other) {
    assert(currencyCode == other.currencyCode, 'Currency mismatch');
    return Money(minor + other.minor, currencyCode);
  }

  Money operator -(Money other) {
    assert(currencyCode == other.currencyCode, 'Currency mismatch');
    return Money(minor - other.minor, currencyCode);
  }

  Money operator -() => Money(-minor, currencyCode);

  bool get isNegative => minor < 0;
  bool get isZero => minor == 0;

  /// Double major-unit value, e.g. 125050 minor -> 1250.50. Display-only
  /// bridge for widgets that take double + a currency symbol string.
  double get majorValue => minor / pow10(minorUnitExponent(currencyCode));

  /// Formatted for display, e.g. "1,250.50".
  String format({bool showSign = false}) {
    final exponent = minorUnitExponent(currencyCode);
    final divisor = pow10(exponent);
    final major = minor.abs() / divisor;
    final formatter = NumberFormat.currency(
      symbol: '',
      decimalDigits: exponent,
    );
    final formatted = formatter.format(major).trim();
    final sign = minor < 0 ? '-' : (showSign ? '+' : '');
    return '$sign$formatted';
  }

  @override
  String toString() => '${format()} $currencyCode';
}
</file>

<file path="lib/domain/models/template.dart">
/// design.md TEMPLATE / ADR-007: the user pastes a sample message and
/// labels spans of it (amount, code, date, person, balance, fee); the app
/// turns that into a regex with one named group per labeled field. This
/// file is the template model plus the generator; matching a message
/// against a list of templates is `Parser` (logic/parser.dart).
library;

/// The kinds of field a user can label a span as (US-08). `ignore` isn't
/// listed in requirements.md's label set but is kept internal-only, not
/// exposed here, since v0.1's rule builder only offers the six above.
enum TemplateFieldType { amount, code, date, person, balance, fee }

/// `direction` on a Template: which way the transaction goes. `either`
/// lets the message decide at parse time (ui-design-brief.md 7.7 step 4)
/// — see `Parser._resolveType`.
enum TemplateDirection { spent, got, either }

/// One labeled span over `sampleText`, as produced by the rule builder UI
/// (#20). `end` is exclusive. The factory that consumes these assumes
/// they're already non-overlapping — the rule builder enforces that by
/// construction (tap-to-label chips can't cover the same character twice).
class LabeledSpan {
  final int start;
  final int end;
  final TemplateFieldType type;

  const LabeledSpan({
    required this.start,
    required this.end,
    required this.type,
  });
}

/// design.md TEMPLATE. `pattern` is a regex source string with one named
/// group per labeled field (`(?<amount>...)`, and `(?<amount2>...)` etc.
/// if a field type repeats, e.g. amount + fee are both money but distinct
/// groups); `fieldMap` maps each group name back to its [TemplateFieldType]
/// — this is tables.dart's `fieldMapJson` column, decoded.
class CaptureTemplate {
  final String id;
  final String unitId;
  final String? captureSourceId;
  final String name;
  final TemplateDirection direction;
  final String pattern;
  final Map<String, TemplateFieldType> fieldMap;
  final String sampleText;
  final int version;
  final bool enabled;

  const CaptureTemplate({
    required this.id,
    required this.unitId,
    required this.name,
    required this.direction,
    required this.pattern,
    required this.fieldMap,
    required this.sampleText,
    this.captureSourceId,
    this.version = 1,
    this.enabled = true,
  });

  /// Compiled on demand rather than cached, since a Template is an
  /// immutable value object handed around freely (Parser compiles it once
  /// per parse attempt); `dotAll` so a `date`/`person` group's `[\s\S]+?`
  /// isn't the only thing standing between us and a multi-line message
  /// silently failing to match.
  RegExp get compiled => RegExp(pattern, dotAll: true);

  /// ADR-007: builds a regex from a pasted sample plus the spans the user
  /// labeled over it. Literal text between, before and after the labels is
  /// regex-escaped, so punctuation in the sample (".", "(", "+", "$", ...)
  /// is matched literally rather than as regex syntax (testing.md P-04).
  /// Different names/numbers/amounts in a *future* message still match,
  /// because only the labeled spans became capture groups — everything
  /// else in the sample is now fixed literal text (testing.md P-03).
  factory CaptureTemplate.fromLabeledSample({
    required String id,
    required String unitId,
    String? captureSourceId,
    required String name,
    required TemplateDirection direction,
    required String sampleText,
    required List<LabeledSpan> labels,
    int version = 1,
    bool enabled = true,
  }) {
    final sorted = [...labels]..sort((a, b) => a.start.compareTo(b.start));
    for (var i = 1; i < sorted.length; i++) {
      assert(
        sorted[i].start >= sorted[i - 1].end,
        'Labeled spans must not overlap',
      );
    }

    final buffer = StringBuffer();
    final fieldMap = <String, TemplateFieldType>{};
    final usedCounts = <TemplateFieldType, int>{};
    var cursor = 0;

    for (final span in sorted) {
      buffer.write(_escapeLiteral(sampleText.substring(cursor, span.start)));
      final groupName = _nextGroupName(span.type, usedCounts);
      buffer.write('(?<$groupName>${_fieldPattern(span.type)})');
      fieldMap[groupName] = span.type;
      cursor = span.end;
    }

    // #20 Intentionally no trailing literal: the pattern ends where the last
// labeled field ends. Real messages have variable tails (URLs, "see all
// your balances", counters, per-message limits) that we don't want to
// require on every future message. Leading literals before the first
// label are still kept — a header like "Confirmed." pins the rule to
// the right kind of message.
//     buffer.write(_escapeLiteral(sampleText.substring(cursor)));
    return CaptureTemplate(
      id: id,
      unitId: unitId,
      captureSourceId: captureSourceId,
      name: name,
      direction: direction,
      pattern: buffer.toString(),
      fieldMap: fieldMap,
      sampleText: sampleText,
      version: version,
      enabled: enabled,
    );
  }

  CaptureTemplate copyWith({bool? enabled, String? name, int? version}) {
    return CaptureTemplate(
      id: id,
      unitId: unitId,
      captureSourceId: captureSourceId,
      name: name ?? this.name,
      direction: direction,
      pattern: pattern,
      fieldMap: fieldMap,
      sampleText: sampleText,
      version: version ?? this.version,
      enabled: enabled ?? this.enabled,
    );
  }

  /// testing.md P-11: round-trips through the same shape tables.dart's
  /// `fieldMapJson` column stores (group name -> field type name), so a
  /// repository just needs to `jsonEncode`/`jsonDecode` this map.
  Map<String, dynamic> toJson() => {
    'id': id,
    'unitId': unitId,
    'captureSourceId': captureSourceId,
    'name': name,
    'direction': direction.name,
    'pattern': pattern,
    'fieldMap': fieldMap.map(
      (groupName, type) => MapEntry(groupName, type.name),
    ),
    'sampleText': sampleText,
    'version': version,
    'enabled': enabled,
  };

  factory CaptureTemplate.fromJson(Map<String, dynamic> json) {
    final rawFieldMap = json['fieldMap'] as Map<String, dynamic>;
    return CaptureTemplate(
      id: json['id'] as String,
      unitId: json['unitId'] as String,
      captureSourceId: json['captureSourceId'] as String?,
      name: json['name'] as String,
      direction: TemplateDirection.values.byName(json['direction'] as String),
      pattern: json['pattern'] as String,
      fieldMap: rawFieldMap.map(
        (groupName, typeName) => MapEntry(
          groupName,
          TemplateFieldType.values.byName(typeName as String),
        ),
      ),
      sampleText: json['sampleText'] as String,
      version: json['version'] as int? ?? 1,
      enabled: json['enabled'] as bool? ?? true,
    );
  }

  static String _nextGroupName(
    TemplateFieldType type,
    Map<TemplateFieldType, int> used,
  ) {
    final count = (used[type] ?? 0) + 1;
    used[type] = count;
    // Dart named-group names must start with a letter and be alphanumeric —
    // `type.name` (e.g. "amount") already is; appending the count for a
    // repeat keeps that true ("amount2").
    return count == 1 ? type.name : '${type.name}$count';
  }

  /// Escapes regex metacharacters so literal text from the sample is
  /// matched as itself. Dart's RegExp has no built-in escape helper.
  static String _escapeLiteral(String s) {
    return s.replaceAllMapped(
      RegExp(r'[.*+?^${}()|[\]\\]'),
      (m) => '\\${m[0]}',
    );
  }

  /// The regex each field type matches against in a *future* message —
  /// deliberately more permissive than any one sample, since the amount,
  /// code, date etc. will differ every time (testing.md P-02/P-03).
  static String _fieldPattern(TemplateFieldType type) {
    switch (type) {
      case TemplateFieldType.amount:
      case TemplateFieldType.balance:
      case TemplateFieldType.fee:
        // Optional currency label/prefix, digits with optional thousands
        // separators, optional decimal part — "Ksh350.00", "KES 1,250",
        // "350" all match (testing.md P-02).
      return r'(?:[A-Za-z]{2,5}\.?\s*)?[\d,]+(?:\.\d+)?[.,;:!?]?';
      case TemplateFieldType.code:
        return r'[A-Za-z0-9]+';
      case TemplateFieldType.date:
      case TemplateFieldType.person:
        // Non-greedy so it stops at the next literal chunk once compiled,
        // rather than swallowing the rest of the message.
        return r'[\s\S]+?';
    }
  }

}
