<file path="lib/domain/logic/backup_crypto.dart">
// ---------------------------------------------------------------------------
// Envelope encryption for Fuata backups (issue #35).
//
// AES-256-GCM, key derived from a passphrase with PBKDF2-HMAC-SHA256
// (100,000 iterations). Every file gets its own random 16-byte salt and
// 12-byte nonce, so two exports of the same data produce different
// ciphertexts and a stolen file is useless without the passphrase.
//
// The envelope wraps the plaintext JSON that BackupCodec already writes;
// nothing inside the file changes. Restore unwraps first, then hands the
// plaintext to BackupService.preview — the encryption is invisible to
// everything downstream.
// ---------------------------------------------------------------------------
import 'dart:convert';
import 'dart:math';

import 'package:cryptography/cryptography.dart';

class BackupCrypto {
  BackupCrypto._();

  static const envelopeFormat = 'fuata-backup-encrypted';
  static const envelopeVersion = 1;
  static const _cipher = 'AES-256-GCM';
  static const _kdf = 'PBKDF2-HMAC-SHA256';
  static const _iterations = 100000;
  static const _saltBytes = 16;
  static const _minPassphraseLength = 8;

  /// True when [text] looks like an encrypted Fuata envelope. Never throws.
  static bool looksEncrypted(String text) {
    try {
      final root = jsonDecode(text);
      return root is Map<String, dynamic> && root['format'] == envelopeFormat;
    } catch (_) {
      return false;
    }
  }

  /// null when the passphrase is acceptable, or a message to show.
  static String? validatePassphrase(String passphrase) {
    if (passphrase.length < _minPassphraseLength) {
      return 'Use at least $_minPassphraseLength characters.';
    }
    return null;
  }

  static Future<String> encode(String plaintext, {required String passphrase}) async {
    final salt = _randomBytes(_saltBytes);
    final key = await _deriveKey(passphrase, salt);
    final algorithm = AesGcm.with256bits();
    final nonce = algorithm.newNonce();
    final secretBox = await algorithm.encrypt(
      utf8.encode(plaintext),
      secretKey: key,
      nonce: nonce,
    );
    return jsonEncode({
      'format': envelopeFormat,
      'formatVersion': envelopeVersion,
      'cipher': _cipher,
      'kdf': _kdf,
      'iterations': _iterations,
      'salt': base64Encode(salt),
      'nonce': base64Encode(secretBox.nonce),
      'ciphertext': base64Encode(secretBox.cipherText),
      'mac': base64Encode(secretBox.mac.bytes),
    });
  }

  /// Throws [SecretBoxAuthenticationError] on a wrong passphrase or a
  /// tampered file; [FormatException] on anything not shaped right.
  static Future<String> decode(String envelope, { required String passphrase}) async {
    final root = jsonDecode(envelope);
    if (root is! Map<String, dynamic> || root['format'] != envelopeFormat) {
      throw const FormatException("This isn't a Fuata encrypted backup.");
    }
    final version = root['formatVersion'];
    if (version is! int || version > envelopeVersion) {
      throw const FormatException(
        'This encrypted backup was made by a newer version of Fuata.',
      );
    }
    final iterations = root['iterations'];
    if (iterations is! int || iterations < 1000) {
      throw const FormatException('Bad KDF parameters in the file.');
    }
    final salt = _decodeBase64(root['salt']);
    final nonce = _decodeBase64(root['nonce']);
    final ciphertext = _decodeBase64(root['ciphertext']);
    final macBytes = _decodeBase64(root['mac']);

    final key = await _deriveKey(passphrase, salt, iterations: iterations);
    final algorithm = AesGcm.with256bits();
    final plaintext = await algorithm.decrypt(
      SecretBox(ciphertext, nonce: nonce, mac: Mac(macBytes)),
      secretKey: key,
    );
    return utf8.decode(plaintext);
  }

  static Future<SecretKey> _deriveKey(
      String passphrase,
      List<int> salt, {
        int iterations = _iterations,
      }) async {
    final pbkdf2 = Pbkdf2(
      macAlgorithm: Hmac.sha256(),
      iterations: iterations,
      bits: 256,
    );
    return pbkdf2.deriveKeyFromPassword(password: passphrase, nonce: salt);
  }

  static List<int> _randomBytes(int n) {
    final rng = Random.secure();
    return List<int>.generate(n, (_) => rng.nextInt(256));
  }

  static List<int> _decodeBase64(Object? raw) {
    if (raw is! String) throw const FormatException('Missing field.');
    try {
      return base64Decode(raw);
    } on FormatException {
      throw const FormatException('Bad base64 in the file.');
    }
  }
}
</file>

<file path="lib/domain/logic/backup_import.dart">
// ---------------------------------------------------------------------------
// Deciding what an import would do, before it does anything (issue #24,
// US-15: "import is validated and never overwrites silently").
//
// Pure Dart. The planner compares a decoded file with what is already on
// the phone and sorts every record into one of three piles:
//
//   added      - nothing on the phone has that id: safe to add.
//   identical  - already here, exactly the same: nothing to do.
//   conflicts  - same id, different content: needs a decision.
//
// The person sees those counts (and the conflicts by name) *before*
// choosing. Nothing is written by planning, and nothing is overwritten
// unless they pick [ConflictPolicy.useFile] on purpose.
//
// It also checks that every reference resolves (a transaction's unit, a
// template's source, a limit's unit...) against the file *and* the phone
// together, so a partial backup can be merged into an existing phone but a
// dangling reference can never reach the database's foreign keys.
// ---------------------------------------------------------------------------

import 'dart:convert';

import '../models/backup_snapshot.dart';
import '../models/capture_source.dart';
import '../models/limit_rule.dart';
import '../models/outing.dart';
import '../models/settings.dart';
import '../models/template.dart';
import '../models/transaction.dart';
import '../models/unit.dart';
import 'backup_codec.dart';

/// What to do with a record that exists on both sides but differs.
enum ConflictPolicy {
  /// Leave the phone's version alone. The default.
  keepMine,

  /// Replace the phone's version with the file's.
  useFile,
}

class Conflict<T> {
  final T existing;
  final T incoming;
  const Conflict(this.existing, this.incoming);
}

class TablePlan<T> {
  final List<T> added;
  final int identicalCount;
  final List<Conflict<T>> conflicts;

  const TablePlan({
    this.added = const [],
    this.identicalCount = 0,
    this.conflicts = const [],
  });

  bool get isEmpty => added.isEmpty && identicalCount == 0 && conflicts.isEmpty;
}

class ImportPlan {
  final TablePlan<BackupCategory> categories;
  final TablePlan<MoneyUnit> units;
  final TablePlan<CaptureSource> captureSources;
  final TablePlan<CaptureTemplate> templates;
  final TablePlan<MoneyTransaction> transactions;
  final TablePlan<LimitRule> limits;

  /// The file's settings, if it had any. Applied only when the person
  /// asks for it — never as part of "merge my records".
  final AppSettings? incomingSettings;

  final TablePlan<Outing> outings;

  /// References that don't resolve. Any problem means the import can't run.
  final List<String> problems;
  final int moreProblems;

  const ImportPlan({
    required this.categories,
    required this.units,
    required this.captureSources,
    required this.templates,
    required this.transactions,
    required this.limits,
    required this.incomingSettings,
    required this.outings,
    this.problems = const [],
    this.moreProblems = 0,
  });

  bool get canApply => problems.isEmpty;

  int get addedCount =>
      categories.added.length +
      units.added.length +
      captureSources.added.length +
      templates.added.length +
      transactions.added.length +
      limits.added.length +
      outings.added.length;

  int get identicalCount =>
      categories.identicalCount +
      units.identicalCount +
      captureSources.identicalCount +
      templates.identicalCount +
      transactions.identicalCount +
      limits.identicalCount +
      outings.identicalCount;

  int get conflictCount =>
      categories.conflicts.length +
      units.conflicts.length +
      captureSources.conflicts.length +
      templates.conflicts.length +
      transactions.conflicts.length +
      limits.conflicts.length +
      limits.conflicts.length;

  bool get hasConflicts => conflictCount > 0;

  /// True when applying (with either policy) could not change any record.
  bool get changesNothing => addedCount == 0 && conflictCount == 0;

  /// The records that would be written under [policy]: everything new,
  /// plus — only for [ConflictPolicy.useFile] — the file's side of each
  /// conflict. Settings are not included; they are a separate choice.
  BackupSnapshot recordsToWrite(ConflictPolicy policy) {
    List<T> pick<T>(TablePlan<T> t) => [
      ...t.added,
      if (policy == ConflictPolicy.useFile)
        for (final c in t.conflicts) c.incoming,
    ];
    return BackupSnapshot(
      categories: pick(categories),
      units: pick(units),
      captureSources: pick(captureSources),
      templates: pick(templates),
      transactions: pick(transactions),
      limits: pick(limits),
      outings: pick(outings),
    );
  }
}

class ImportPlanner {
  ImportPlanner._();

  static const _maxListedProblems = 20;

  static ImportPlan plan({
    required BackupSnapshot incoming,
    required BackupSnapshot existing,
  }) {
    final categories = _diff<BackupCategory>(
      incoming.categories,
      existing.categories,
      (c) => c.id,
      (c) => jsonEncode(BackupCodec.categoryToJson(c)),
    );
    final units = _diff<MoneyUnit>(
      incoming.units,
      existing.units,
      (u) => u.id,
      (u) => jsonEncode(BackupCodec.unitToJson(u)),
    );
    final sources = _diff<CaptureSource>(
      incoming.captureSources,
      existing.captureSources,
      (s) => s.id,
      (s) => jsonEncode(BackupCodec.captureSourceToJson(s)),
    );
    final templates = _diff<CaptureTemplate>(
      incoming.templates,
      existing.templates,
      (t) => t.id,
      (t) => jsonEncode(t.toJson()),
    );
    final limits = _diff<LimitRule>(
      incoming.limits,
      existing.limits,
      (l) => l.id,
      (l) => jsonEncode(BackupCodec.limitToJson(l)),
    );

    // Original message text is opt-in in a file, so a file without it must
    // not look "different" from a phone that kept it — and replacing the
    // phone's version must not throw the kept text away.
    final rawTx = _diff<MoneyTransaction>(
      incoming.transactions,
      existing.transactions,
      (t) => t.id,
      (t) => jsonEncode(BackupCodec.transactionToJson(t)),
    );
    final transactions = TablePlan<MoneyTransaction>(
      added: rawTx.added,
      identicalCount: rawTx.identicalCount,
      conflicts: [
        for (final c in rawTx.conflicts)
          Conflict(
            c.existing,
            c.incoming.rawText == null && c.existing.rawText != null
                ? c.incoming.copyWith(rawText: c.existing.rawText)
                : c.incoming,
          ),
      ],
    );

    final outings = _diff<Outing>(
      incoming.outings,
      existing.outings,
          (o) => o.id,
          (o) => jsonEncode(BackupCodec.outingToJson(o)),
    );

    final problems = <String>[];
    var more = 0;
    void problem(String m) {
      if (problems.length < _maxListedProblems) {
        problems.add(m);
      } else {
        more++;
      }
    }

    // A reference resolves if the target is in the file or already here.
    final unitIds = {
      ...incoming.units.map((u) => u.id),
      ...existing.units.map((u) => u.id),
    };
    final categoryIds = {
      ...incoming.categories.map((c) => c.id),
      ...existing.categories.map((c) => c.id),
    };
    final sourceIds = {
      ...incoming.captureSources.map((s) => s.id),
      ...existing.captureSources.map((s) => s.id),
    };
    final templateIds = {
      ...incoming.templates.map((t) => t.id),
      ...existing.templates.map((t) => t.id),
    };

    for (final t in incoming.templates) {
      if (!unitIds.contains(t.unitId)) {
        problem(
          'The rule "${t.name}" belongs to a money unit that is neither in '
          'the file nor on this phone.',
        );
      }
      final src = t.captureSourceId;
      if (src != null && !sourceIds.contains(src)) {
        problem(
          'The rule "${t.name}" points at an app that is neither in the '
          'file nor on this phone.',
        );
      }
    }
    for (final l in incoming.limits) {
      final u = l.unitId;
      if (u != null && !unitIds.contains(u)) {
        problem(
          'A ${l.period.name} limit belongs to a money unit that is '
          'neither in the file nor on this phone.',
        );
      }
    }
    for (final t in incoming.transactions) {
      final label = _txLabel(t);
      if (!unitIds.contains(t.unitId)) {
        problem(
          '$label belongs to a money unit that is neither in the file nor '
          'on this phone.',
        );
      }
      final cat = t.categoryId;
      if (cat != null && !categoryIds.contains(cat)) {
        problem('$label uses a category that is not in the file or here.');
      }
      final tpl = t.templateId;
      if (tpl != null && !templateIds.contains(tpl)) {
        problem('$label points at a rule that is not in the file or here.');
      }
    }

    return ImportPlan(
      categories: categories,
      units: units,
      captureSources: sources,
      templates: templates,
      transactions: transactions,
      limits: limits,
      incomingSettings: incoming.settings,
      outings: outings,
      problems: problems,
      moreProblems: more,
    );
  }

  static String _txLabel(MoneyTransaction t) {
    final who = t.counterparty;
    final base = who == null || who.isEmpty
        ? 'A transaction'
        : 'The "$who" entry';
    return base;
  }

  static TablePlan<T> _diff<T>(
    List<T> incoming,
    List<T> existing,
    String Function(T) idOf,
    String Function(T) fingerprint,
  ) {
    final byId = {for (final e in existing) idOf(e): e};
    final added = <T>[];
    final conflicts = <Conflict<T>>[];
    var identical = 0;
    for (final item in incoming) {
      final match = byId[idOf(item)];
      if (match == null) {
        added.add(item);
      } else if (fingerprint(match) == fingerprint(item)) {
        identical++;
      } else {
        conflicts.add(Conflict(match, item));
      }
    }
    return TablePlan(
      added: added,
      identicalCount: identical,
      conflicts: conflicts,
    );
  }
}
</file>

<file path="lib/domain/logic/banner_content.dart">
// ---------------------------------------------------------------------------
// What the notification banner says (issues #16 / #17, US-05,
// ui-design-brief.md 7.9-7.10).
//
// Pure Dart, no widgets: the banner setup screen's live preview (#17) and
// the real ongoing notification (#16) both call BannerContent.build(), so
// what the person sees in the preview is exactly what Android will show.
// ---------------------------------------------------------------------------

import '../models/limit_rule.dart';
import '../models/money.dart';
import '../models/outing.dart';
import '../models/settings.dart';
import '../models/unit.dart';

class BannerContent {
  final SpendStatus status;

  /// Collapsed headline, e.g. "🟢 1,500 left today".
  final String title;

  /// 0..1 share of today's limit used; null when hidden or no daily limit.
  final double? progress;

  /// Expanded body: one "Cash 760" entry per shown unit (empty when redacted).
  final List<String> unitLines;

  /// Expanded body: "Spent today 1,500" (null when redacted).
  final String? spentLine;

  final bool showQuickAdd;

  const BannerContent({
    required this.status,
    required this.title,
    required this.progress,
    required this.unitLines,
    required this.spentLine,
    required this.showQuickAdd,
  });

  static BannerContent build({
    required SpendStatus status,
    required int spentToday,
    required LimitRule? dailyLimit,
    required List<MoneyUnit> units,
    required Map<String, int> balanceByUnit,
    required BannerHeadline headline,
    required BannerUnitsMode unitsMode,
    required Set<String> selectedUnitIds, // empty = every unit
    required bool showProgress,
    required bool showQuickAdd,
    required bool redacted,

    /// #30: when an outing is active, the banner answers "how is the
    /// trip going?" instead of "how is today going". Overrides the
    /// headline number; the units split and the spent line stay the same
    /// (they answer "what do I have" and "what did I spend", which don't
    /// change during an outing).
    Outing? activeOuting,
    int outingSpentMinor = 0,
    SpendStatus? outingStatus,
  }) {
    final active = units.where((u) => !u.archived).toList();
    // The units whose balance *lines* appear in the expanded body.
    final linesFor = switch (unitsMode) {
      BannerUnitsMode.all => active,
      BannerUnitsMode.selected =>
        active.where((u) => selectedUnitIds.contains(u.id)).toList(),
      BannerUnitsMode.none => const <MoneyUnit>[],
    };

    // The units whose balances roll up into the "total I have" headline.
    // `none` is about the split lines, not about the total reading zero,
    // so the headline still sums every active unit — the same number the
    // person would see in My money.
    final unitsForTotal = unitsMode == BannerUnitsMode.none ? active : linesFor;

    // Effective status and limit: outing wins when active.
    final SpendStatus effectiveStatus = activeOuting != null
        ? (outingStatus ?? SpendStatus.safe)
        : status;
    final LimitRule? effectiveLimit = activeOuting != null
        ? activeOuting.asLimit()
        : dailyLimit;
    final int effectiveSpent = activeOuting != null
        ? outingSpentMinor
        : spentToday;

    final code = activeOuting != null
        ? activeOuting.currencyCode
        : (effectiveLimit?.currencyCode ??
              (active.isEmpty ? 'KES' : active.first.currencyCode));
    String fmt(int minor) => Money(minor, code).format();

    final emoji = effectiveStatus.emoji;
    final left = effectiveLimit == null
        ? null
        : effectiveLimit.amountMinor - effectiveSpent;

    final String title;
    if (redacted) {
      title = '$emoji ${effectiveStatus.label}';
    } else if (activeOuting != null) {
      // "Mombasa trip" is the noun; "left" / "over" is the verb.
      final name = activeOuting.name;
      if (left == null || left >= 0) {
        title = '$emoji ${fmt(left ?? 0)} left for $name';
      } else {
        title = '$emoji Over by ${fmt(-left)} for $name';
      }
    } else {
      switch (headline) {
        case BannerHeadline.leftToday:
          if (left == null) {
            title = '$emoji Spent ${fmt(spentToday)} today';
          } else if (left < 0) {
            title = '$emoji Over by ${fmt(-left)}';
          } else if (left == 0) {
            title = '$emoji Nothing left today';
          } else {
            title = '$emoji ${fmt(left)} left today';
          }
        case BannerHeadline.spentToday:
          title = '$emoji Spent ${fmt(spentToday)} today';
        case BannerHeadline.totalIHave:
          final total = unitsForTotal
              .where((u) => u.currencyCode == code)
              .fold<int>(0, (sum, u) => sum + (balanceByUnit[u.id] ?? 0));
          title = '$emoji ${fmt(total)} in total';
      }
    }

    // Progress: use effective limit.
    double? progress;
    if (showProgress &&
        effectiveLimit != null &&
        effectiveLimit.amountMinor > 0) {
      progress = (effectiveSpent / effectiveLimit.amountMinor).clamp(0.0, 1.0);
    }

    return BannerContent(
      status: effectiveStatus,
      title: title,
      progress: progress,
      unitLines: redacted
          ? const []
          : [
        for (final u in linesFor)
          '${u.name} '
              '${Money(balanceByUnit[u.id] ?? 0, u.currencyCode).format()}',
      ],
      spentLine: redacted
          ? null
          : (activeOuting != null
          ? 'Spent ${fmt(outingSpentMinor)} of '
          '${fmt(activeOuting.amountMinor)}'
          : 'Spent today ${fmt(effectiveSpent)}'),
      showQuickAdd: showQuickAdd,
    );
  }
}
