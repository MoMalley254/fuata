<file path="lib/widgets/home/week_peek.dart">
import 'package:flutter/material.dart';
import 'package:intl/intl.dart';

import '../../domain/models/limit_rule.dart';
import '../../domain/models/money.dart';
import '../../ui/theme/app_colors.dart';
import '../../ui/theme/app_spacing.dart';
import '../../ui/theme/app_typography.dart';

/// Seven small bars for the last seven days, today last and highlighted
/// (ui-design-brief.md 7.2, issue #82, finding F6).
///
/// Always exactly [spentByDay].length bars. A day with no spending still
/// draws a short track — the emptiness is the information, and a strip
/// with gaps would read as data the widget failed to load rather than
/// days nothing happened on. A dashed line sits at the daily limit when
/// one is set, which is why the bars scale to include it: a limit the
/// person is well under still needs to be on the strip, or it can never
/// say "you're getting close".
///
/// Tapping opens Summary on the week view. Each bar carries its own
/// screen-reader label ("Spent 1,200 on Tuesday"), so a person reading
/// the card by ear hears the days rather than "graphic, graphic, graphic".
class WeekPeekCard extends StatelessWidget {
  const WeekPeekCard({
    super.key,
    required this.spentByDay,
    required this.currencyCode,
    required this.onTap,
    this.dailyLimit,
    this.now,
  });

  /// Oldest first, today last. Minor units. Its length is the number of
  /// bars; a seven-day week is the default, not an assumption.
  final List<int> spentByDay;
  final String currencyCode;

  /// Shown as a dashed line; null when no daily limit is set, in which
  /// case the bars scale to the busiest day alone.
  final LimitRule? dailyLimit;

  final VoidCallback onTap;

  /// Injectable for tests and previews; production callers leave it out
  /// and get the device clock. Only used for the day names under the bars.
  final DateTime? now;

  static const _stripHeight = 64.0;
  static const _minBarHeight = 4.0;

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final today = now ?? DateTime.now();
    final days = spentByDay.length;
    if (days == 0) return const SizedBox.shrink();

    // The tallest thing the strip has to fit: the busiest day, or the
    // limit if there is one.
    final limit = dailyLimit?.amountMinor ?? 0;
    var tallest = limit;
    for (final v in spentByDay) {
      if (v > tallest) tallest = v;
    }

    return Material(
      color: Colors.transparent,
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(AppSpacing.unitTileRadius),
        child: Ink(
          padding: const EdgeInsets.all(AppSpacing.md),
          decoration: BoxDecoration(
            color: c.surface,
            borderRadius: BorderRadius.circular(AppSpacing.unitTileRadius),
            border: Border.all(
              color: c.outlineVariant.withValues(alpha: 0.35),
            ),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    'Week peek',
                    style: AppTypography.labelLg.copyWith(
                      color: c.onSurface,
                    ),
                  ),
                  Icon(
                    Icons.chevron_right_rounded,
                    size: 20,
                    color: c.onSurfaceVariant,
                  ),
                ],
              ),
              const SizedBox(height: AppSpacing.md),
              SizedBox(
                height: _stripHeight,
                child: Stack(
                  children: [
                    if (limit > 0)
                      Positioned.fill(
                        child: CustomPaint(
                          painter: _DashedLinePainter(
                            color:
                            c.onSurfaceTertiary.withValues(alpha: 0.55),
                            fraction: limit / tallest,
                          ),
                        ),
                      ),
                    Positioned.fill(
                      child: Row(
                        crossAxisAlignment: CrossAxisAlignment.end,
                        children: [
                          for (var i = 0; i < days; i++) ...[
                            Expanded(
                              child: _DayBar(
                                spentMinor: spentByDay[i],
                                tallestMinor: tallest,
                                stripHeight: _stripHeight,
                                minBarHeight: _minBarHeight,
                                isToday: i == days - 1,
                                currencyCode: currencyCode,
                                day: today.subtract(
                                  Duration(days: days - 1 - i),
                                ),
                              ),
                            ),
                            if (i < days - 1)
                              const SizedBox(width: AppSpacing.xs),
                          ],
                        ],
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(height: AppSpacing.xs),
              Row(
                children: [
                  for (var i = 0; i < days; i++) ...[
                    Expanded(
                      child: Text(
                        // One letter per day, from the same date that
                        // fed the bar above — never a hardcoded "MTWTFSS",
                        // which would lie the moment the window slides.
                        DateFormat.E().format(
                          today.subtract(Duration(days: days - 1 - i)),
                        ).substring(0, 1),
                        textAlign: TextAlign.center,
                        style: AppTypography.labelSm.copyWith(
                          color: i == days - 1
                              ? c.onSurface
                              : c.onSurfaceTertiary,
                        ),
                      ),
                    ),
                    if (i < days - 1) const SizedBox(width: AppSpacing.xs),
                  ],
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _DayBar extends StatelessWidget {
  const _DayBar({
    required this.spentMinor,
    required this.tallestMinor,
    required this.stripHeight,
    required this.minBarHeight,
    required this.isToday,
    required this.currencyCode,
    required this.day,
  });

  final int spentMinor;
  final int tallestMinor;
  final double stripHeight;
  final double minBarHeight;
  final bool isToday;
  final String currencyCode;
  final DateTime day;

  @override
  Widget build(BuildContext context) {
    final c = context.colors;

    final available = stripHeight - minBarHeight;
    final fraction = tallestMinor <= 0
        ? 0.0
        : (spentMinor / tallestMinor).clamp(0.0, 1.0);
    final height = minBarHeight + fraction * available;

    // The issue asks for "Spent 1,200 on Tuesday". Trailing ".00" is
    // dropped so the phrasing matches a person's own reading of the
    // amount, and the currency code is included so "1,200" isn't
    // ambiguous to anyone holding more than one.
    var amount = Money(spentMinor, currencyCode).format();
    if (amount.endsWith('.00')) {
      amount = amount.substring(0, amount.length - 3);
    }
    final dayName = DateFormat.EEEE().format(day);
    final label = spentMinor == 0
        ? 'Nothing on $dayName'
        : 'Spent ${currencySymbol(currencyCode).trim()} $amount on $dayName';

    return Semantics(
      label: label,
      child: Container(
        height: height,
        decoration: BoxDecoration(
          color: spentMinor == 0
              ? c.surfaceContainerHigh
              : (isToday
              ? c.primary
              : c.primary.withValues(alpha: 0.4)),
          borderRadius: BorderRadius.circular(AppSpacing.xs),
        ),
      ),
    );
  }
}

/// A horizontal dashed line across the strip at [fraction] of its height
/// (0 = bottom, 1 = top). Used for the daily limit — a fixed line the
/// person is trying to stay under, versus the bars, which are what
/// actually happened.
class _DashedLinePainter extends CustomPainter {
  _DashedLinePainter({required this.color, required this.fraction});
  final Color color;
  final double fraction;

  @override
  void paint(Canvas canvas, Size size) {
    final y = size.height * (1 - fraction.clamp(0.0, 1.0));
    const dash = 4.0;
    const gap = 3.0;
    final paint = Paint()
      ..color = color
      ..strokeWidth = 1.5
      ..strokeCap = StrokeCap.round;
    for (var x = 0.0; x < size.width; x += dash + gap) {
      canvas.drawLine(
        Offset(x, y),
        Offset((x + dash).clamp(0.0, size.width), y),
        paint,
      );
    }
  }

  @override
  bool shouldRepaint(_DashedLinePainter old) =>
      old.fraction != fraction || old.color != color;
}
</file>

<file path="lib/widgets/limits/alert_levels_card.dart">
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/alert_engine.dart';
import '../../domain/logic/banner_content.dart';
import '../../domain/models/limit_alert.dart';
import '../../domain/models/limit_rule.dart';
import '../../domain/models/money.dart';
import '../../domain/models/settings.dart';
import '../../ui/providers/app_providers.dart';
import '../../ui/theme/app_colors.dart';
import '../../ui/theme/app_spacing.dart';
import '../../ui/theme/app_typography.dart';
import '../banner/banner_preview.dart';
import '../personalization/toggle_row.dart';

/// Alert levels and the live banner preview (ui-design-brief.md 7.8,
/// issue #63).
///
/// One pair of sliders sets the levels for *every* limit — the daily, the
/// weekly, and any per-unit ones — because "nudge me at 70%" is a habit,
/// not a per-limit setting. They are stored on each LimitRule (warnAt /
/// dangerAt), so nothing new is persisted for them.
///
/// Dragging only changes local state; the write happens when the finger
/// lifts. Writing on every tick would re-post the banner and re-run alert
/// evaluation dozens of times per drag — and could announce a level the
/// person was merely sliding past.
class AlertLevelsCard extends ConsumerStatefulWidget {
  final List<LimitRule> limits;
  const AlertLevelsCard({super.key, required this.limits});

  @override
  ConsumerState<AlertLevelsCard> createState() => _AlertLevelsCardState();
}

class _AlertLevelsCardState extends ConsumerState<AlertLevelsCard> {
  static const _min = 0.5;
  static const _max = 0.95;
  static const _minGapPercent = 5;

  RangeValues? _draft; // while dragging / until the write lands
  bool _dragging = false;
  double? _tryRatio; // the "if I've spent…" scrubber; null = today's real use

  @override
  void didUpdateWidget(covariant AlertLevelsCard old) {
    super.didUpdateWidget(old);
    // Drop the draft once the stored levels have caught up with it, so the
    // thumbs don't flicker back to the old values between write and stream.
    final d = _draft;
    if (d == null || _dragging) return;
    final (w, dg) = LimitRule.levelsFrom(widget.limits);
    if ((w - d.start).abs() < 0.001 && (dg - d.end).abs() < 0.001) {
      _draft = null;
    }
  }

  Future<void> _save(RangeValues v) async {
    final repo = ref.read(limitRepositoryProvider);
    final warn = (v.start * 100).round() / 100;
    final danger = (v.end * 100).round() / 100;
    try {
      for (final l in widget.limits) {
        if (l.warnAt == warn && l.dangerAt == danger) continue;
        await repo.setLimit(l.copyWith(warnAt: warn, dangerAt: danger));
      }
    } catch (_) {
      if (mounted) setState(() => _draft = null);
    }
  }

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final settings = ref.watch(currentSettingsProvider);
    final home = ref.watch(homeStateProvider).value;
    final hasLimits = widget.limits.isNotEmpty;

    final (storedWarn, storedDanger) = LimitRule.levelsFrom(widget.limits);
    // Clamped: a limit saved by older code could hold a level outside the
    // slider's range, and RangeSlider asserts on that.
    final values = _draft ??
        RangeValues(
          storedWarn.clamp(_min, _max).toDouble(),
          storedDanger.clamp(_min, _max).toDouble(),
        );
    String pct(double v) => '${(v * 100).round()}%';

    final daily = widget.limits
        .where((l) =>
    l.scope == LimitScope.overall &&
        l.period == LimitPeriod.day &&
        l.enabled)
        .firstOrNull;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        ToggleRow(
          title: 'Alerts',
          subtitle: 'Nudge me as I get close to a limit.',
          value: settings.alertsEnabled,
          onChanged: (on) => ref
              .read(settingsRepositoryProvider)
              .updateSettings(settings.copyWith(alertsEnabled: on)),
        ),
        const SizedBox(height: AppSpacing.md),
        Text(
          '${SpendStatus.warning.emoji} Nudge me at ${pct(values.start)}',
          style: AppTypography.bodyMd.copyWith(color: c.onSurface),
        ),
        Text(
          '${SpendStatus.danger.emoji} Warn me at ${pct(values.end)}',
          style: AppTypography.bodyMd.copyWith(color: c.onSurface),
        ),
        Text(
          "${SpendStatus.overdraft.emoji} And when I'm over",
          style: AppTypography.bodyMd.copyWith(color: c.onSurface),
        ),
        RangeSlider(
          values: values,
          min: _min,
          max: _max,
          divisions: ((_max - _min) * 100).round(),
          labels: RangeLabels(pct(values.start), pct(values.end)),
          // Nothing to set the levels *on* until a limit exists.
          onChangeStart: hasLimits ? (_) => _dragging = true : null,
          onChanged: hasLimits
              ? (v) {
            final s = (v.start * 100).round();
            final e = (v.end * 100).round();
            // Keep the two lines apart: "nudge" and "warn" at the same
            // number would make the middle level meaningless.
            if (e - s < _minGapPercent) return;
            setState(() => _draft = v);
          }
              : null,
          onChangeEnd: hasLimits
              ? (v) {
            _dragging = false;
            _save(v);
          }
              : null,
        ),
        if (!hasLimits)
          Text(
            'Set a limit above, then choose when to be nudged.',
            style: AppTypography.labelSm.copyWith(color: c.onSurfaceTertiary),
          ),
        if (daily != null) ...[
          const SizedBox(height: AppSpacing.md),
          _preview(context, daily, values, settings, home),
        ],
      ],
    );
  }

  Widget _preview(
      BuildContext context,
      LimitRule daily,
      RangeValues values,
      AppSettings settings,
      HomeState? home,
      ) {
    final c = context.colors;
    final limit = daily.copyWith(warnAt: values.start, dangerAt: values.end);

    final realRatio = limit.amountMinor <= 0
        ? 0.0
        : (home?.spentToday ?? 0) / limit.amountMinor;
    final ratio = (_tryRatio ?? realRatio).clamp(0.0, 1.2);
    final spent = (limit.amountMinor * ratio).round();

    final content = BannerContent.build(
      status: limit.statusFor(spent),
      spentToday: spent,
      dailyLimit: limit,
      units: home?.units ?? const [],
      balanceByUnit: home?.balanceByUnit ?? const {},
      headline: settings.bannerHeadline,
      unitsMode: settings.bannerUnitsMode,
      selectedUnitIds: settings.bannerUnitIds,
      showProgress: settings.bannerShowProgress,
      showQuickAdd: settings.bannerShowQuickAdd,
      redacted: settings.amountsHidden,
    );

    final level = AlertEngine.levelFor(limit, spent);
    final alertLine = !settings.alertsEnabled
        ? 'Alerts are off.'
        : level == null
        ? 'No alert at this point.'
        : () {
      final t = AlertText.build(LimitAlert(
        limit: limit,
        level: level,
        periodKey: '',
        spentMinor: spent,
      ));
      return "You'd get: ${t.title} — ${t.body}";
    }();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          "Try it: if I've spent "
              '${settings.amountsHidden ? kHiddenAmountMask : Money(spent, limit.currencyCode).format()} '
              'today',
          style: AppTypography.labelMd.copyWith(color: c.onSurfaceVariant),
        ),
        Slider(
          value: ratio.toDouble(),
          min: 0,
          max: 1.2,
          onChanged: (r) => setState(() => _tryRatio = r),
        ),
        BannerPreview(content: content),
        const SizedBox(height: AppSpacing.sm),
        Text(
          alertLine,
          style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
        ),
      ],
    );
  }
}
