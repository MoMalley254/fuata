<file path="lib/widgets/sheets/share_pack_sheet.dart">
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_smart_dialog/flutter_smart_dialog.dart';
import 'package:intl/intl.dart';
import 'package:qr_flutter/qr_flutter.dart';

import '../../domain/logic/template_pack_codec.dart';
import '../../domain/models/template.dart';
import '../../domain/models/template_pack.dart';
import '../../domain/models/unit.dart';
import '../../platform/backup_files.dart';
import '../../ui/providers/app_providers.dart';
import '../../ui/providers/backup_providers.dart';
import '../../ui/theme/app_colors.dart';
import '../../ui/theme/app_spacing.dart';
import '../../ui/theme/app_typography.dart';
import '../personalization/action_row.dart';

/// Share a unit's rules as a pack (issue #34). Two routes: a file the
/// receiver opens via Settings → Message reading packs → import, or a QR
/// they scan in the same place. The QR is bounded by its capacity — the
/// sheet says so rather than showing an unscannable code.
///
/// NOTE: this sheet is hosted by flutter_smart_dialog, so its `BuildContext`
/// has **no Navigator ancestor**. Never call `showDialog`/`Navigator.of`
/// with it — render any follow-up UI inline in this sheet instead.
Future<void> showSharePackSheet({
  required String unitId,
  required List<CaptureTemplate> templates,
}) {
  return SmartDialog.show(
    builder: (_) => _SharePackSheet(unitId: unitId, templates: templates),
  );
}

class _SharePackSheet extends ConsumerStatefulWidget {
  const _SharePackSheet({required this.unitId, required this.templates});
  final String unitId;
  final List<CaptureTemplate> templates;

  @override
  ConsumerState<_SharePackSheet> createState() => _SharePackSheetState();
}

class _SharePackSheetState extends ConsumerState<_SharePackSheet> {
  bool _busy = false;

  /// Set once the user asks for a QR: the compact payload to encode, or an
  /// explanation of why it can't be encoded. Rendered inline — pushing a
  /// route from this context would fail (no Navigator ancestor).
  String? _qrPayload;
  String? _qrError;
  String _qrTitle = '';

  TemplatePack _buildPack(String unitName) {
    final ts = DateTime.now().microsecondsSinceEpoch;
    return TemplatePack(
      id: 'exported_$ts',
      name: '$unitName rules',
      templates: [
        for (final t in widget.templates)
          PackTemplate(
            name: t.name,
            direction: t.direction,
            pattern: t.pattern,
            fieldMap: t.fieldMap,
            sampleText: t.sampleText,
            enabled: t.enabled,
            customFieldNames: t.customFieldNames,
          ),
      ],
    );
  }

  String _suggestedFileName(String unitName) {
    final safe = unitName
        .toLowerCase()
        .replaceAll(RegExp(r'[^a-z0-9]+'), '-')
        .replaceAll(RegExp(r'^-|-$'), '');
    final d = DateFormat('yyyyMMdd').format(DateTime.now());
    return 'fuata-pack-${safe.isEmpty ? 'rules' : safe}-$d.json';
  }

  Future<void> _saveToFile() async {
    // Capture the messenger *before* dismissing: once SmartDialog removes
    // this sheet the context is deactivated and lookups on it throw.
    final messenger = ScaffoldMessenger.of(context);
    setState(() => _busy = true);
    try {
      final unitName = _unitName();
      final pack = _buildPack(unitName);
      final content = TemplatePackCodec.encode(pack);
      final saved = await ref
          .read(backupFilesProvider)
          .saveText(
            suggestedName: _suggestedFileName(unitName),
            content: content,
          );
      SmartDialog.dismiss();
      if (saved) {
        messenger.showSnackBar(
          const SnackBar(
            content: Text(
              'Saved. The receiver imports it from Settings → Message reading packs.',
            ),
          ),
        );
      }
    } on BackupFileException catch (e) {
      messenger.showSnackBar(SnackBar(content: Text(e.message)));
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  void _showQr() {
    final unitName = _unitName();
    final pack = _buildPack(unitName);
    final payload = TemplatePackCodec.encodeCompact(pack);
    // 2500 bytes is comfortably under the L-error-correction ceiling
    // (2953) and leaves the code small enough to be readable on a
    // phone screen. Beyond that the person is better off sharing a file.
    const maxQrBytes = 2500;
    final utf8Len = payload.length;

    setState(() {
      _qrTitle = pack.name;
      if (utf8Len > maxQrBytes) {
        _qrPayload = null;
        _qrError =
            'This pack is $utf8Len bytes — more than a single QR can carry '
            'reliably. Share it as a file instead; the receiver imports it '
            'the same way.';
      } else {
        _qrError = null;
        _qrPayload = payload;
      }
    });
  }

  String _unitName() =>
      _resolveUnitName(ref.read(unitsProvider).value ?? const []);

  String _resolveUnitName(List<MoneyUnit> units) {
    for (final u in units) {
      if (u.id == widget.unitId) return u.name;
    }
    return 'rules';
  }

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    final n = widget.templates.length;

    // Watched to keep the units provider alive while the share sheet is
    // open — `_saveToFile` and `_showQr` read it to name the file after
    // the unit, and a cold-start race would otherwise fall back to
    // "rules" in the filename.
    final unitsAsync = ref.watch(unitsProvider);
    final unitName = _resolveUnitName(unitsAsync.value ?? const []);

    final showingQr = _qrPayload != null || _qrError != null;

    return SafeArea(
      child: Container(
        decoration: BoxDecoration(
          color: c.surface,
          borderRadius: const BorderRadius.vertical(
            top: Radius.circular(AppSpacing.cardRadiusHero),
          ),
        ),
        padding: const EdgeInsets.fromLTRB(
          AppSpacing.lg,
          AppSpacing.md,
          AppSpacing.lg,
          AppSpacing.lg,
        ),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Center(
              child: Container(
                width: 40,
                height: 4,
                margin: const EdgeInsets.only(bottom: AppSpacing.md),
                decoration: BoxDecoration(
                  color: c.outlineVariant,
                  borderRadius: BorderRadius.circular(AppSpacing.pill),
                ),
              ),
            ),
            if (showingQr)
              ..._buildQrView(c)
            else
              ..._buildChooser(c, unitName, n),
          ],
        ),
      ),
    );
  }

  List<Widget> _buildChooser(AppColors c, String unitName, int n) {
    return [
      Text(
        'Share these rules',
        style: AppTypography.headlineSm.copyWith(color: c.onSurface),
      ),
      const SizedBox(height: AppSpacing.xs),
      Text(
        n == 1
            ? 'One rule will be shared. The receiver adds it to a unit '
                  'of their own.'
            : '$n rules will be shared. The receiver adds them to a '
                  'unit of their own.',
        style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
      ),
      const SizedBox(height: AppSpacing.md),
      ActionRow(
        icon: Icons.save_outlined,
        title: 'Save as a file',
        subtitle: 'A .json pack the receiver opens in Fuata',
        // _busy guard, expressed the way ActionRow allows
        onTap: () {
          if (_busy) return;
          _saveToFile();
        },
      ),
      const SizedBox(height: AppSpacing.sm),
      ActionRow(
        icon: Icons.qr_code_rounded,
        title: 'Show as a QR',
        subtitle: 'The receiver scans it in Fuata',
        // _busy guard, expressed the way ActionRow allows
        onTap: () {
          if (_busy) return;
          _showQr();
        },
      ),
    ];
  }

  List<Widget> _buildQrView(AppColors c) {
    final error = _qrError;
    if (error != null) {
      return [
        Text(
          'Too big for a QR',
          style: AppTypography.headlineSm.copyWith(color: c.onSurface),
        ),
        const SizedBox(height: AppSpacing.xs),
        Text(
          error,
          style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
        ),
        const SizedBox(height: AppSpacing.md),
        Align(
          alignment: Alignment.centerRight,
          child: TextButton(
            onPressed: () => SmartDialog.dismiss(),
            child: const Text('OK'),
          ),
        ),
      ];
    }

    return [
      Text(
        'Scan this to get $_qrTitle',
        style: AppTypography.headlineSm.copyWith(color: c.onSurface),
      ),
      const SizedBox(height: AppSpacing.md),
      Center(
        child: Container(
          color: Colors.white,
          padding: const EdgeInsets.all(12),
          child: QrImageView(
            data: _qrPayload!,
            version: QrVersions.auto,
            size: 260,
            // Lowest error correction: the pack is at the edge of QR
            // capacity, and a screen-to-camera read at arm's length
            // doesn't need the redundancy of H. If a code doesn't
            // scan, "share as file" is the fallback.
            errorCorrectionLevel: QrErrorCorrectLevel.L,
          ),
        ),
      ),
      const SizedBox(height: AppSpacing.md),
      Text(
        'Open Fuata → Settings → Message reading packs → Scan a QR.',
        textAlign: TextAlign.center,
        style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
      ),
      const SizedBox(height: AppSpacing.sm),
      Align(
        alignment: Alignment.centerRight,
        child: TextButton(
          onPressed: () => SmartDialog.dismiss(),
          child: const Text('Close'),
        ),
      ),
    ];
  }
}
</file>

<file path="lib/widgets/sheets/template_pack_sheet.dart">
import 'dart:async';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/template_pack_import.dart';
import '../../domain/models/template.dart';
import '../../domain/models/template_pack.dart';
import '../../domain/models/unit.dart';
import '../../ui/providers/app_providers.dart';
import '../../ui/providers/capture_providers.dart';
import '../../ui/theme/app_colors.dart';
import '../../ui/theme/app_spacing.dart';
import '../../ui/theme/app_typography.dart';
import '../app_chips.dart';

/// Preview a pack, pick a unit, and import (issue #34). The bottom-sheet
/// shape is deliberately the same one the rule builder's palette uses —
/// "choose then act" in one gesture, not a full-screen wizard for what is
/// usually a one-tap decision.
class TemplatePackSheet extends ConsumerStatefulWidget {
  const TemplatePackSheet({super.key, required this.pack, required this.units});
  final TemplatePack pack;
  final List<MoneyUnit> units;

  @override
  ConsumerState<TemplatePackSheet> createState() => _TemplatePackSheetState();
}

class _TemplatePackSheetState extends ConsumerState<TemplatePackSheet> {
  late String _unitId = widget.units.first.id;
  bool _importing = false;
  String? _error;

  Future<void> _import() async {
    setState(() {
      _importing = true;
      _error = null;
    });

    try {
      // Safe to read `.value` here: `build` watches both providers, so by
      // the time the button can be tapped, both have emitted at least once.
      // `.value ?? const []` also means a provider that somehow arrived
      // empty is treated as "no existing rules", which is the correct
      // behaviour for a first import.
      final templates =
          ref.read(unitTemplatesProvider(_unitId)).value ?? const [];
      final sources = ref.read(captureSourcesProvider).value ?? const [];

      final plan = TemplatePackImporter.plan(
        pack: widget.pack,
        targetUnitId: _unitId,
        existing: templates,
      );

      if (plan.changesNothing) {
        setState(() {
          _importing = false;
          _error = plan.duplicateCount == 1
              ? 'That rule is already on this unit.'
              : 'All ${plan.duplicateCount} rules are already on this unit.';
        });
        return;
      }

      // Timeout so a stuck DB write surfaces as an error instead of an
      // endless spinner. Fifteen seconds is generous for 6 small inserts;
      // anything past it is a bug we want to see.
      final n = await TemplatePackImporter.apply(
        plan: plan,
        sources: sources,
        repo: ref.read(templateRepositoryProvider),
      ).timeout(const Duration(seconds: 15));

      if (!mounted) return;
      final unit = widget.units.firstWhere((u) => u.id == _unitId);

      // Grab the messenger before popping: `context` belongs to the sheet
      // and is no longer valid for showing a snackbar after the route
      // starts closing.
      final messenger = ScaffoldMessenger.of(context);
      Navigator.of(context).pop();
      messenger.showSnackBar(
        SnackBar(
          content: Text(
            n == 1
                ? 'Added 1 rule to ${unit.name}.'
                : 'Added $n rules to ${unit.name}.',
          ),
        ),
      );
    } on TimeoutException {
      if (!mounted) return;
      setState(() {
        _importing = false;
        _error = 'Saving took too long. Nothing was written — please try again.';
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _importing = false;
        _error = 'Could not save the rules, please try again.';
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    final c = context.colors;

    // Watched so the providers stay subscribed while the sheet is open.
    // Without this, `_import`'s ref.read is the only reference to the
    // family provider — and on the very first tap it can still be in
    // AsyncLoading, which is what the previous "can't read your rules"
    // bug was, and what the `.future` fix turned into a hang. Watching
    // here means the button is enabled only once the data is in hand.
    final templatesAsync = ref.watch(unitTemplatesProvider(_unitId));
    final sourcesAsync = ref.watch(captureSourcesProvider);
    final providersReady =
        !templatesAsync.isLoading && !sourcesAsync.isLoading;

    return SafeArea(
      child: Container(
        decoration: BoxDecoration(
          color: c.surface,
          borderRadius: const BorderRadius.vertical(
            top: Radius.circular(AppSpacing.cardRadiusHero),
          ),
        ),
        constraints: BoxConstraints(
          maxHeight: MediaQuery.of(context).size.height * 0.85,
        ),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(
                AppSpacing.lg,
                AppSpacing.md,
                AppSpacing.lg,
                0,
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Center(
                    child: Container(
                      width: 40,
                      height: 4,
                      margin: const EdgeInsets.only(bottom: AppSpacing.md),
                      decoration: BoxDecoration(
                        color: c.outlineVariant,
                        borderRadius: BorderRadius.circular(AppSpacing.pill),
                      ),
                    ),
                  ),
                  Text(
                    widget.pack.name,
                    style: AppTypography.headlineSm.copyWith(color: c.onSurface),
                  ),
                  if (widget.pack.description != null) ...[
                    const SizedBox(height: AppSpacing.xs),
                    Text(
                      widget.pack.description!,
                      style: AppTypography.bodySm
                          .copyWith(color: c.onSurfaceVariant),
                    ),
                  ],
                ],
              ),
            ),
            const SizedBox(height: AppSpacing.md),
            Flexible(
              child: ListView(
                padding: const EdgeInsets.symmetric(
                  horizontal: AppSpacing.lg,
                ),
                children: [
                  Text(
                    'These rules will be added',
                    style: AppTypography.labelLg.copyWith(color: c.onSurface),
                  ),
                  const SizedBox(height: AppSpacing.sm),
                  for (final t in widget.pack.templates)
                    Padding(
                      padding: const EdgeInsets.only(bottom: AppSpacing.sm),
                      child: _TemplateRow(template: t),
                    ),
                  const SizedBox(height: AppSpacing.lg),
                  Text(
                    'Add to which unit?',
                    style: AppTypography.labelLg.copyWith(color: c.onSurface),
                  ),
                  const SizedBox(height: AppSpacing.sm),
                  Wrap(
                    spacing: AppSpacing.sm,
                    runSpacing: AppSpacing.sm,
                    children: [
                      for (final u in widget.units)
                        AppChoiceChip(
                          label: '${u.iconEmoji} ${u.name}',
                          selected: _unitId == u.id,
                          onTap: () => setState(() => _unitId = u.id),
                        ),
                    ],
                  ),
                  if (_error != null) ...[
                    const SizedBox(height: AppSpacing.md),
                    Text(
                      _error!,
                      style: AppTypography.bodySm
                          .copyWith(color: c.statusDanger),
                    ),
                  ],
                  const SizedBox(height: AppSpacing.lg),
                  SizedBox(
                    width: double.infinity,
                    child: FilledButton(
                      // Disabled while either provider is still loading. The person can't
                      // tap import before there's something to compare against, so
                      // `_import` never has to reason about AsyncLoading.
                      onPressed: (_importing || !providersReady) ? null : _import,
                      child: _importing
                          ? const SizedBox(
                        height: 18,
                        width: 18,
                        child: CircularProgressIndicator(strokeWidth: 2),
                      )
                          : Text(
                        widget.pack.templates.length == 1
                            ? 'Add this rule'
                            : 'Add these ${widget.pack.templates.length} rules',
                      ),
                    ),
                  ),
                  const SizedBox(height: AppSpacing.md),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _TemplateRow extends StatelessWidget {
  const _TemplateRow({required this.template});
  final PackTemplate template;

  @override
  Widget build(BuildContext context) {
    final c = context.colors;
    return Container(
      padding: const EdgeInsets.all(AppSpacing.md),
      decoration: BoxDecoration(
        color: c.surfaceContainer,
        borderRadius: BorderRadius.circular(AppSpacing.unitTileRadius),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Expanded(
                child: Text(
                  template.name,
                  style: AppTypography.labelLg.copyWith(color: c.onSurface),
                ),
              ),
              Text(
                switch (template.direction) {
                  TemplateDirection.spent => 'out',
                  TemplateDirection.got => 'in',
                  TemplateDirection.either => 'auto',
                },
                style: AppTypography.labelSm
                    .copyWith(color: c.onSurfaceTertiary),
              ),
            ],
          ),
          const SizedBox(height: AppSpacing.xs),
          Text(
            template.sampleText,
            maxLines: 2,
            overflow: TextOverflow.ellipsis,
            style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
          ),
        ],
      ),
    );
  }
}
