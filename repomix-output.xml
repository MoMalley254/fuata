<file path="lib/platform/backup_passphrase_store.dart">
// ---------------------------------------------------------------------------
// The backup passphrase, cached behind Android Keystore (issue #35).
//
// A scheduled export runs unattended: it cannot prompt for a passphrase at
// 3am. Caching the passphrase (encrypted by the Keystore) is what makes
// the schedule work; it's the same trade the database key already makes
// (ADR-010's plan for SQLCipher). A backup restored onto a different phone
// cannot use the cached passphrase — Keystore is device-bound — so restore
// prompts, and this store is the cache, not the source of truth.
// ---------------------------------------------------------------------------
import 'package:flutter_secure_storage/flutter_secure_storage.dart';

class BackupPassphraseStore {
  BackupPassphraseStore._();

  static const _storage = FlutterSecureStorage(aOptions: AndroidOptions());
  static const _key = 'fuata.scheduled_export.passphrase.v1';

  static Future<String?> read() => _storage.read(key: _key);

  static Future<void> write(String passphrase) =>
      _storage.write(key: _key, value: passphrase);

  static Future<void> clear() => _storage.delete(key: _key);

  /// True when a passphrase is cached. Cheap; safe to call from a build
  /// method's provider init.
  static Future<bool> hasValue() async => (await read()) != null;
}
</file>

<file path="lib/platform/banner.dart">
// ---------------------------------------------------------------------------
// The ongoing status banner (issue #16, US-05, ADR-008).
//
// One notification, one fixed id: every change to the person's money
// updates the same notification rather than stacking a new one per
// event. ADR-008 chose a plain ongoing notification over a foreground
// service — Android starts the capture listener itself, and a foreground
// service just to display a number would be both overkill and
// increasingly restricted on newer Android.
//
// Android ties an app's notification colour to its icon, so status is
// shown with the emoji, a progress bar and the accent-tinted small icon
// — never colour alone (ui-design-brief.md 7.10, requirements.md a11y).
//
// US-06's alerts live on a *separate* Android channel (issue #16 lists
// "separate alert channel"), so muting the banner never silences a
// real nudge.
//
// Nothing in this file logs amounts.
// ---------------------------------------------------------------------------

import 'dart:async';
import 'dart:ui';

import 'package:flutter_local_notifications/flutter_local_notifications.dart';

import '../domain/logic/alert_engine.dart';
import '../domain/logic/banner_content.dart';
import '../domain/models/limit_alert.dart';
import '../domain/models/limit_rule.dart';

/// What the person did with the banner: opened it, or hit + Add (US-07).
enum BannerAction { open, quickAdd }

class BannerPlatform {
  BannerPlatform._();
  static final instance = BannerPlatform._();

  /// Fixed id: the banner is one ongoing notification, updated in place.
  static const bannerId = 1001;

  /// Ongoing status banner. Default importance, not low: MIUI hides a
  /// low-importance channel from the lock screen entirely (design.md
  /// 5.3), and Android locks a channel's importance after creation. The
  /// silence that `Importance.low` used to buy comes from
  /// `onlyAlertOnce` + `playSound: false` + `enableVibration: false` in
  /// `_androidDetails()` instead, which don't affect lock-screen display.
  static const bannerChannelId = 'fuata_banner';
  static const bannerChannelName = 'Status banner';
  static const bannerChannelDescription =
      'The ongoing banner showing how today is going.';

  /// Separate alert channel (issue #16, US-06). Created here so both are
  /// visible in Android's per-app notification settings before either
  /// has ever been posted to.
  static const alertChannelId = 'fuata_alerts';
  static const alertChannelName = 'Limit alerts';
  static const alertChannelDescription =
      'Nudges when you approach or pass a limit.';

  /// Same alerts, delivered during quiet hours (issue #63). Android fixes
  /// a channel's sound and importance when it is created and ignores
  /// per-notification overrides, so "arrive without a buzz" needs its own
  /// low-importance channel rather than a flag on the loud one.
  static const quietAlertChannelId = 'fuata_alerts_quiet';
  static const quietAlertChannelName = 'Limit alerts (quiet hours)';
  static const quietAlertChannelDescription =
      'Limit alerts that arrive during your quiet hours, without sound.';

  /// Issue #31: scheduled summary notifications. Default importance so
  /// they show on the lock screen (design.md 5.3 — MIUI hides LOW
  /// channels entirely), but the person only sees them if they turned the
  /// feature on.
  static const summaryChannelId = 'fuata_summary';
  static const summaryChannelName = 'Summary notifications';
  static const summaryChannelDescription =
      'Daily, weekly and monthly reminders of how your money went.';

  final _plugin = FlutterLocalNotificationsPlugin();
  final _actions = StreamController<BannerAction>.broadcast();
  bool _initialised = false;
  bool _permissionAsked = false;

  /// Taps and + Add presses on the banner. Broadcast — safe to listen
  /// late, safe to have no listener at all.
  Stream<BannerAction> get actions => _actions.stream;

  /// Idempotent. The UI isolate and the listener's background isolate
  /// each call this once on their own plugin instance; Android sees the
  /// same notification id either way.
  Future<void> init() async {
    if (_initialised) return;
    const initSettings = InitializationSettings(
      android: AndroidInitializationSettings('@mipmap/ic_launcher'),
    );
    await _plugin.initialize(
      settings: initSettings,
      onDidReceiveNotificationResponse: _onResponse,
    );
    await _createChannels();
    _initialised = true;
  }

  Future<void> _createChannels() async {
    final android = _plugin
        .resolvePlatformSpecificImplementation<
          AndroidFlutterLocalNotificationsPlugin
        >();
    if (android == null) return;
    await android.createNotificationChannel(
      const AndroidNotificationChannel(
        bannerChannelId,
        bannerChannelName,
        description: bannerChannelDescription,
        // Was Importance.low. MIUI (and some other OEMs) treat LOW as
        // "silent" and hide silent notifications from the lock screen
        // entirely, regardless of the notification's own visibility flag.
        // Default importance is the lowest MIUI accepts for lock screen.
        importance: Importance.defaultImportance,
      ),
    );
    await android.createNotificationChannel(
      const AndroidNotificationChannel(
        alertChannelId,
        alertChannelName,
        description: alertChannelDescription,
        importance: Importance.high,
      ),
    );
    await android.createNotificationChannel(
      const AndroidNotificationChannel(
        quietAlertChannelId,
        quietAlertChannelName,
        description: quietAlertChannelDescription,
        importance: Importance.low,
        playSound: false,
        enableVibration: false,
      ),
    );

    await android.createNotificationChannel(
      const AndroidNotificationChannel(
        summaryChannelId,
        summaryChannelName,
        description: summaryChannelDescription,
        importance: Importance.defaultImportance,
      ),
    );
  }

  BannerAction? _pending;

  void _onResponse(NotificationResponse response) {
    final action = response.actionId == 'quick_add'
        ? BannerAction.quickAdd
        : BannerAction.open;
    // Cold start from a banner tap: nobody is listening yet, and a
    // broadcast stream drops un-listened events. Stash it for main.dart
    // to drain after the first frame.
    if (_actions.hasListener) {
      _actions.add(action);
    } else {
      _pending = action;
    }
  }

  /// One-shot read for a cold start: the banner action that launched the
  /// app, if any. Cleared on read.
  BannerAction? consumePendingAction() {
    final a = _pending;
    _pending = null;
    return a;
  }

  /// Post or update the banner. [content] is exactly what the setup
  /// screen's live preview built (BannerContent.build is shared), so the
  /// two can never disagree. [redactOnLockScreen] comes from the
  /// person's `redactedLockScreenBanner` setting.
  Future<void> show(
    BannerContent content, {
    required bool redactOnLockScreen,
  }) async {
    await init();
    await _requestPermissionOnce();
    await _plugin.show(
      id: bannerId,
      title: content.title,
      body: _body(content),
      notificationDetails: NotificationDetails(
        android: _androidDetails(content, redactOnLockScreen),
      ),
    );
  }

  /// Show one limit alert (US-06). Its notification id is derived from the
  /// limit, so a later "almost at your limit" *replaces* the earlier "easy
  /// now" for the same limit instead of stacking beside it. [quiet] posts
  /// it on the silent channel (quiet hours).
  Future<void> showAlert(
    LimitAlert alert, {
    required bool quiet,
    required bool redactOnLockScreen,
  }) async {
    await init();
    await _requestPermissionOnce();
    final text = AlertText.build(alert);
    await _plugin.show(
      id: alertIdFor(alert.limit.id),
      title: text.title,
      body: text.body,
      notificationDetails: NotificationDetails(
        android: AndroidNotificationDetails(
          quiet ? quietAlertChannelId : alertChannelId,
          quiet ? quietAlertChannelName : alertChannelName,
          channelDescription: quiet
              ? quietAlertChannelDescription
              : alertChannelDescription,
          importance: quiet ? Importance.low : Importance.high,
          priority: quiet ? Priority.low : Priority.high,
          autoCancel: true,
          visibility: redactOnLockScreen
              ? NotificationVisibility.private
              : NotificationVisibility.public,
          icon: '@mipmap/ic_launcher',
          color: _statusColor(alert.level.status),
          styleInformation: BigTextStyleInformation(text.body),
        ),
      ),
    );
  }

  /// Stable across runs and isolates (String.hashCode is not guaranteed
  /// to be), and clear of [bannerId]. FNV-1a, folded into a positive
  /// 31-bit range above 2000.
  static int alertIdFor(String limitId) {
    var h = 0x811c9dc5;
    for (final unit in limitId.codeUnits) {
      h = ((h ^ unit) * 0x01000193) & 0x7fffffff;
    }
    return 2000 + (h % 1000000);
  }

  Future<void> cancel() async {
    await init();
    await _plugin.cancel(id: bannerId);
  }

  /// Ask once per process (Android 13+). No-op on older Androids and
  /// after the first decision, so it never re-prompts.
  Future<void> _requestPermissionOnce() async {
    if (_permissionAsked) return;
    _permissionAsked = true;
    final android = _plugin
        .resolvePlatformSpecificImplementation<
          AndroidFlutterLocalNotificationsPlugin
        >();
    await android?.requestNotificationsPermission();
  }

  AndroidNotificationDetails _androidDetails(
    BannerContent content,
    bool redactOnLockScreen,
  ) {
    final progress = content.progress;
    final body = _body(content);

    return AndroidNotificationDetails(
      bannerChannelId,
      bannerChannelName,
      channelDescription: bannerChannelDescription,
      importance: Importance.defaultImportance,
      priority: Priority.defaultPriority,
      // ongoing + autoCancel:false so Android treats it as a status
      // indicator and a tap doesn't silently remove it. On Android 14+
      // a person *can* still dismiss it; the data-driven re-post is what
      // brings it back (design.md ADR-008).
      ongoing: true,
      autoCancel: false,
      playSound: false,
      enableVibration: false,
      onlyAlertOnce: true,
      showWhen: false,
      category: AndroidNotificationCategory.status,
      // private redacts content on a secure lock screen; public shows
      // everything. The banner is always built unredacted — Android
      // does the redaction, not us, so the shade and the lock screen
      // can differ without keeping two BannerContents.
      visibility: redactOnLockScreen
          ? NotificationVisibility.private
          : NotificationVisibility.public,
      // `icon` is the small-icon resource name in
      // flutter_local_notifications (there is no `smallIcon` parameter).
      icon: '@mipmap/ic_launcher',
      color: _statusColor(content.status),
      showProgress: progress != null,
      maxProgress: 100,
      progress: progress == null ? 0 : (progress * 100).round(),
      actions: [
        if (content.showQuickAdd)
          const AndroidNotificationAction(
            'quick_add',
            '+ Add',
            showsUserInterface: true,
            cancelNotification: false,
          ),
        const AndroidNotificationAction(
          'open',
          'Open',
          showsUserInterface: true,
          cancelNotification: false,
        ),
      ],
      styleInformation: body.isEmpty ? null : BigTextStyleInformation(body),
    );
  }

  /// Expanded body: the unit split, then the spent-today line. Empty
  /// when the content is redacted — the title alone carries the status.
  String _body(BannerContent content) => [
    if (content.unitLines.isNotEmpty) content.unitLines.join(' · '),
    if (content.spentLine != null) content.spentLine!,
  ].join('\n');

  /// Android takes a single ARGB colour, and this isolate has no access
  /// to AppColors — the theme extension isn't available on the platform
  /// side. These are the same hex values AppColors.light ships (see
  /// lib/ui/theme/app_colors.dart); kept explicit here because the
  /// banner is a platform concern, not a themed widget.
  Color _statusColor(SpendStatus status) => switch (status) {
    SpendStatus.safe => const Color(0xFF2E9E6B),
    SpendStatus.warning => const Color(0xFFE8A317),
    SpendStatus.danger => const Color(0xFFE5533D),
    SpendStatus.overdraft => const Color(0xFFB3123F),
  };

  /// Reads the action that *launched a terminated app* — a banner tap or its
  /// + Add pressed while Fuata was not running. The in-process `_onResponse`
  /// callback cannot fire in that case; the plugin records the action in the
  /// launch details instead. Returns null when the app was launched normally.
  Future<BannerAction?> initialActionFromLaunch() async {
    await init();
    final details = await _plugin.getNotificationAppLaunchDetails();
    if (details?.didNotificationLaunchApp != true) return null;
    final response = details!.notificationResponse;
    if (response == null) return null;
    return response.actionId == 'quick_add'
        ? BannerAction.quickAdd
        : BannerAction.open;
  }

  /// Ask for notification permission (Android 13+), waiting for the
  /// answer. Unlike [_requestPermissionOnce], this always asks — used from
  /// onboarding's banner step (F15), where the person just said yes and is
  /// looking at the explanation. Returns true when notifications are on
  /// (either just granted, or the OS has no prompt to show).
  Future<bool> requestNotificationPermission() async {
    await init();
    final android = _plugin
        .resolvePlatformSpecificImplementation<
          AndroidFlutterLocalNotificationsPlugin
        >();
    if (android == null) return true;
    final granted = await android.requestNotificationsPermission();
    _permissionAsked = true;
    return granted ?? true;
  }

  /// Whether Android will actually deliver Fuata's notifications. False
  /// when the person denied the permission (Android 13+) or turned the
  /// app's notifications off in system settings.
  Future<bool> areNotificationsEnabled() async {
    await init();
    final android = _plugin
        .resolvePlatformSpecificImplementation<
          AndroidFlutterLocalNotificationsPlugin
        >();
    return await android?.areNotificationsEnabled() ?? true;
  }
}
</file>

<file path="lib/platform/summary_notifications.dart">
// ---------------------------------------------------------------------------
// Scheduling the daily / weekly / monthly summary notifications (issue #31).
//
// Uses flutter_local_notifications' zonedSchedule with matchDateTimeComponents
// so Android re-fires the notification every period without Fuata needing to
// be running. The text is baked in at schedule time; the sync provider
// (summary_notification_providers.dart) reschedules whenever the data or the
// settings change, so the body is always "as of the last time Fuata noticed
// something moved".
//
// Three fixed ids, one per period, so a reschedule *replaces* the pending
// notification rather than stacking a second one beside it — same trick the
// banner uses for its own single id.
//
// The timing helpers (nextDaily / nextWeekly / nextMonthly) are top-level
// pure functions on purpose: they're the whole of "when does the next one
// fire?" and they take an explicit `now` so a test can pin the clock.
// Everything the class below does with them is one line of wiring into
// zonedSchedule.
//
// Nothing here logs amounts or the notification body.
// ---------------------------------------------------------------------------

import 'package:flutter_local_notifications/flutter_local_notifications.dart';
import 'package:flutter_timezone/flutter_timezone.dart';
import 'package:timezone/data/latest_all.dart' as tzdata;
import 'package:timezone/timezone.dart' as tz;

import '../domain/models/settings.dart';
import 'banner.dart';

/// The three bodies the scheduler puts into the three notifications. Each
/// is computed once by the caller (which has the repositories) and handed
/// here; the scheduler never touches the database.
class SummaryNotificationTexts {
  final String daily;
  final String weekly;
  final String monthly;
  const SummaryNotificationTexts({
    required this.daily,
    required this.weekly,
    required this.monthly,
  });
}

// ---------------------------------------------------------------------------
// Timing helpers. Pure functions: no I/O, no clock reads (the caller passes
// `now`), no dependency on the plugin. Testable in test/domain/.
// ---------------------------------------------------------------------------

/// The next local occurrence of [minute] minutes past midnight, strictly
/// after [now].
///
/// Strictly-after is deliberate: when the settings change *at* the exact
/// minute the summary is due, rescheduling it for "now" would fire it a
/// second time the moment the write landed. Rolling to tomorrow instead
/// means a person who turns the daily summary on at exactly 20:00 gets
/// their first one tomorrow, not a duplicate of the one that just fired.
tz.TZDateTime nextDaily(tz.TZDateTime now, int minute) {
  final today = tz.TZDateTime(
    now.location, now.year, now.month, now.day,
    minute ~/ 60, minute % 60,
  );
  if (today.isAfter(now)) return today;
  // `day + 1` over a month end or a year end is normalised by the
  // constructor — 31 Oct + 1 day is 1 Nov, no special case needed here.
  return tz.TZDateTime(
    now.location, now.year, now.month, now.day + 1,
    minute ~/ 60, minute % 60,
  );
}

/// The next local occurrence of [weekday] (1 = Mon … 7 = Sun, matching
/// Dart's `DateTime.weekday`) at [minute], strictly after [now].
///
/// Any weekday occurs at least once in any 8 consecutive days (today plus
/// the seven after it), so the loop is guaranteed to return; the throw at
/// the end is defensive, not reachable.
tz.TZDateTime nextWeekly(tz.TZDateTime now, int weekday, int minute) {
  for (var i = 0; i < 8; i++) {
    final when = tz.TZDateTime(
      now.location, now.year, now.month, now.day + i,
      minute ~/ 60, minute % 60,
    );
    if (when.weekday == weekday && when.isAfter(now)) return when;
  }
  throw StateError('nextWeekly: no weekday $weekday in 8 days from $now');
}

/// The next local occurrence of day-of-month [day] at [minute], strictly
/// after [now].
///
/// [day] is bounded to 1..28 by the settings model, so every month has it
/// — a monthly summary can never silently skip February.
tz.TZDateTime nextMonthly(tz.TZDateTime now, int day, int minute) {
  final thisMonth = tz.TZDateTime(
    now.location, now.year, now.month, day,
    minute ~/ 60, minute % 60,
  );
  if (thisMonth.isAfter(now)) return thisMonth;
  // `month + 1` on December is 13, which the constructor normalises to
  // January of the next year — again, no special case.
  return tz.TZDateTime(
    now.location, now.year, now.month + 1, day,
    minute ~/ 60, minute % 60,
  );
}

class SummaryNotificationScheduler {
  SummaryNotificationScheduler._();
  static final instance = SummaryNotificationScheduler._();

  static const dailyId = 3001;
  static const weeklyId = 3002;
  static const monthlyId = 3003;

  final _plugin = FlutterLocalNotificationsPlugin();
  bool _initialised = false;

  /// Loads the timezone database and pins the local zone to whatever the
  /// device reports. Idempotent; safe to call from every app start.
  ///
  /// If the device's zone can't be read (rare — the platform channel is
  /// missing on widget tests, or an OEM reports a name the tz database
  /// doesn't know), we fall back to UTC rather than throwing. That's a
  /// worse schedule but not a broken app; the next app start tries again.
  Future<void> init() async {
    if (_initialised) return;
    tzdata.initializeTimeZones();
    try {
      final info = await FlutterTimezone.getLocalTimezone();
      // flutter_timezone 4.x returns a TimezoneInfo, not a bare String.
      // .identifier is the IANA name ("Africa/Nairobi") that
      // tz.getLocation expects.
      tz.setLocalLocation(tz.getLocation(info.identifier));
    } catch (_) {
      // Leave tz.local at its default (UTC). A future start will retry.
    }
    await _plugin.initialize(
      settings: const InitializationSettings(
        android: AndroidInitializationSettings('@mipmap/ic_launcher'),
      ),
    );
    _initialised = true;
  }

  /// (Re)schedules each enabled period, cancels each disabled one. Called
  /// on every data or settings change, and on app resume — see
  /// summary_notification_providers.dart.
  Future<void> scheduleAll({
    required AppSettings settings,
    required SummaryNotificationTexts texts,
    required bool redactOnLockScreen,
  }) async {
    await init();

    if (!settings.summaryNotificationsEnabled) {
      await cancelAll();
      return;
    }

    // One "now" for all three: if the three helpers each read the clock
    // themselves, a slow first call could land the second in a different
    // minute — a real, if tiny, inconsistency. One snapshot avoids it.
    final now = tz.TZDateTime.now(tz.local);

    await _apply(
      id: dailyId,
      enabled: settings.summaryDailyEnabled,
      when: nextDaily(now, settings.summaryDailyMinute),
      title: '📊 Today',
      body: texts.daily,
      match: DateTimeComponents.time,
      redact: redactOnLockScreen,
    );
    await _apply(
      id: weeklyId,
      enabled: settings.summaryWeeklyEnabled,
      when: nextWeekly(
        now,
        settings.summaryWeeklyWeekday,
        settings.summaryWeeklyMinute,
      ),
      title: '📊 This week',
      body: texts.weekly,
      match: DateTimeComponents.dayOfWeekAndTime,
      redact: redactOnLockScreen,
    );
    await _apply(
      id: monthlyId,
      enabled: settings.summaryMonthlyEnabled,
      when: nextMonthly(
        now,
        settings.summaryMonthlyDay,
        settings.summaryMonthlyMinute,
      ),
      title: '📊 This month',
      body: texts.monthly,
      match: DateTimeComponents.dayOfMonthAndTime,
      redact: redactOnLockScreen,
    );
  }

  Future<void> cancelAll() async {
    await init();
    await _plugin.cancel(id: dailyId);
    await _plugin.cancel(id: weeklyId);
    await _plugin.cancel(id: monthlyId);
  }

  Future<void> _apply({
    required int id,
    required bool enabled,
    required tz.TZDateTime when,
    required String title,
    required String body,
    required DateTimeComponents match,
    required bool redact,
  }) async {
    if (!enabled) {
      await _plugin.cancel(id: id);
      return;
    }
    await _plugin.zonedSchedule(
      id: id,
      title: title,
      body: body,
      scheduledDate: when,
      notificationDetails: NotificationDetails(
        android: AndroidNotificationDetails(
          BannerPlatform.summaryChannelId,
          BannerPlatform.summaryChannelName,
          channelDescription: BannerPlatform.summaryChannelDescription,
          importance: Importance.defaultImportance,
          priority: Priority.defaultPriority,
          autoCancel: true,
          visibility: redact
              ? NotificationVisibility.private
              : NotificationVisibility.public,
          icon: '@mipmap/ic_launcher',
        ),
      ),
      // Inexact: no SCHEDULE_EXACT_ALARM permission, no user prompt, and a
      // summary doesn't need to land on the exact second. The OS batches
      // it with other alarms while the phone is idle.
      androidScheduleMode: AndroidScheduleMode.inexactAllowWhileIdle,
      matchDateTimeComponents: match,
    );
  }
}
</file>

<file path="lib/ui/providers/banner_providers.dart">
// ---------------------------------------------------------------------------
// The ongoing banner's data-driven re-post (issue #16, US-05).
//
// HomeState already recomputes on every units/transactions/limits change
// (app_providers.dart), and settings change on every write — so watching
// both is enough to re-post whenever the numbers or the options move.
// What this deliberately does *not* handle: a capture written by the
// notification listener's background isolate. That path re-posts from
// its own isolate (platform/notification_capture.dart), because the UI
// isolate isn't running to notice.
// ---------------------------------------------------------------------------

import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/banner_content.dart';
import '../../platform/banner.dart';
import 'app_providers.dart';

/// Start once, from Fuata's initState. Never read the value — the side
/// effect *is* the provider.
final bannerSyncProvider = Provider<void>((ref) {
  final home = ref.watch(homeStateProvider).value;
  final settings = ref.watch(currentSettingsProvider);

  // Still loading: don't cancel a banner the background isolate just
  // posted, and don't post a stale one. Wait for the first real value.
  if (home == null) return;

  if (!settings.bannerEnabled) {
    BannerPlatform.instance.cancel();
    return;
  }

  // #30: the outing drives the banner only when its own `bannerEnabled`
  // is true. `bannerEnabled` on the outing is a *per-outing* toggle,
  // distinct from the app-wide `AppSettings.bannerEnabled` above — the
  // app-wide switch is a hard gate, the outing switch is a soft one.
  final outing = home.activeOuting;
  final useOuting = outing != null && outing.bannerEnabled;

  final content = BannerContent.build(
    status: home.status,
    spentToday: home.spentToday,
    dailyLimit: home.dailyLimit,
    units: home.units,
    balanceByUnit: home.balanceByUnit,
    headline: settings.bannerHeadline,
    unitsMode: settings.bannerUnitsMode,
    selectedUnitIds: settings.bannerUnitIds,
    showProgress: settings.bannerShowProgress,
    showQuickAdd: settings.bannerShowQuickAdd,
    redacted: false,
    activeOuting: useOuting ? outing : null,
    outingSpentMinor: useOuting ? home.outingSpent : 0,
    outingStatus: useOuting ? home.outingStatus : null,
  );

  BannerPlatform.instance.show(
    content,
    redactOnLockScreen: settings.redactedLockScreenBanner,
  );
});
</file>

<file path="lib/ui/providers/scheduled_export_providers.dart">
// ---------------------------------------------------------------------------
// Keeps the OS alarm in step with the person's schedule (issue #35).
//
// Same shape as bannerSyncProvider / alertSyncProvider: watch the
// settings, act whenever they move. Deliberately not scheduled unless
// folder + passphrase are both in place — arming an alarm that will
// always fail is noise; the settings screen shows why.
// ---------------------------------------------------------------------------
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/scheduled_export.dart';
import '../../platform/scheduled_export.dart';
import 'app_providers.dart';

/// Last run's status (issue #35). Read once; invalidated by "Run now" and
/// by returning to the settings screen. Deliberately not a stream: a
/// scheduled background run won't notify the UI, and polling for a status
/// that changes twice a day is more machinery than the feature deserves.
final scheduledExportStatusProvider =
FutureProvider<ScheduledExportStatus>((ref) {
  return readScheduledExportStatus();
});

/// Watched once, from Fuata's build. The side effect *is* the provider.
final scheduledExportSyncProvider = Provider<void>((ref) {
  final settings = ref.watch(currentSettingsProvider);

  // Wait for the first real settings value: defaulting to "off" while
  // loading would cancel an alarm the background isolate just armed.
  if (ref.watch(settingsProvider).isLoading) return;

  final folder = settings.scheduledExportFolderUri;
  final ready = settings.scheduledExportEnabled &&
      folder != null &&
      folder.isNotEmpty &&
      settings.scheduledExportPassphraseSet;

  if (!ready) {
    cancelScheduledExport();
    return;
  }

  final firstTrigger = nextScheduledExportTrigger(
    frequency: settings.scheduledExportFrequency,
    minuteOfDay: settings.scheduledExportMinute,
    weekday: settings.scheduledExportWeekday,
    now: DateTime.now(),
  );
  scheduleScheduledExport(
    firstTriggerAt: firstTrigger,
    intervalMs: scheduledExportIntervalMs(settings.scheduledExportFrequency),
  );
});
</file>

<file path="lib/ui/providers/summary_notifications_providers.dart">
// ---------------------------------------------------------------------------
// Keeping the scheduled summary notifications in step with the data (#31).
//
// Same shape as bannerSyncProvider and alertSyncProvider: watch everything
// the schedule depends on, act when it moves. Called from main.dart's build,
// so the reschedule happens on cold start and on every setting / data change.
// ---------------------------------------------------------------------------

import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/summary.dart';
import '../../domain/models/transaction.dart';
import '../../platform/summary_notifications.dart';
import 'app_providers.dart';

/// Watched once, from `Fuata`'s build. Never read the value — the
/// side-effect *is* the provider.
final summaryNotificationSyncProvider = Provider<void>((ref) {
  // Midnight rolls "today", "this week" and "this month" over, so the
  // bodies all need rebuilding. Same ticker the rest of the app uses.
  ref.watch(midnightTickProvider);
  final units = ref.watch(unitsProvider);
  final transactions = ref.watch(transactionsProvider);
  final settings = ref.watch(currentSettingsProvider);

  if (!settings.summaryNotificationsEnabled) {
    SummaryNotificationScheduler.instance.cancelAll();
    return;
  }

  final u = units.value;
  final t = transactions.value;
  // Still loading: don't cancel a pending notification the background
  // isolate just rescheduled, and don't rebuild one from half the data.
  if (u == null || t == null) return;

  final currency = u.isNotEmpty ? u.first.currencyCode : 'KES';
  // Same multi-currency rule the Summary screen uses: transactions on a
  // unit in another currency are excluded, not added in as if they were
  // the same money (testing.md T-13).
  final currencyByUnit = {for (final unit in u) unit.id: unit.currencyCode};
  bool include(MoneyTransaction tx) {
    final c = currencyByUnit[tx.unitId];
    return c == null || c == currency;
  }

  final now = DateTime.now();
  String body(SummaryPeriod p) => PeriodSummary.build(
    t,
    p,
    now,
    include: include,
  ).story(currency);

  SummaryNotificationScheduler.instance.scheduleAll(
    settings: settings,
    // Amounts are never masked here: the person explicitly asked for
    // these notifications, and the whole point is to see the numbers.
    // Lock-screen redaction is still honoured, via visibility below.
    texts: SummaryNotificationTexts(
      daily: body(SummaryPeriod.day),
      weekly: body(SummaryPeriod.week),
      monthly: body(SummaryPeriod.month),
    ),
    redactOnLockScreen: settings.redactedLockScreenBanner,
  );
});
</file>

<file path="lib/ui/providers/summary_providers.dart">
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/summary.dart';
import 'app_providers.dart';

/// Issue #23: the summary for one period, recomputed whenever units or
/// transactions change.
///
/// The summary currency is the first unit's, the same rule Home uses for
/// its hero card; transactions on a unit in another currency are left out
/// instead of being added to it as if it were the same money (testing.md
/// T-13).
class SummaryData {
  final PeriodSummary summary;
  final String currencyCode;
  const SummaryData({required this.summary, required this.currencyCode});
}

final summaryProvider =
Provider.family<AsyncValue<SummaryData>, SummaryPeriod>((ref, period) {
  // "Today" and "this week" change at midnight even when no transaction
  // does (issue #107).
  ref.watch(midnightTickProvider);
  final unitsAsync = ref.watch(unitsProvider);
  final txAsync = ref.watch(transactionsProvider);

  if (unitsAsync.isLoading || txAsync.isLoading) {
    return const AsyncValue.loading();
  }
  final error = unitsAsync.error ?? txAsync.error;
  if (error != null) return AsyncValue.error(error, StackTrace.current);

  final units = unitsAsync.value ?? [];
  final currency = units.isNotEmpty ? units.first.currencyCode : 'KES';
  final currencyByUnit = {for (final u in units) u.id: u.currencyCode};

  final summary = PeriodSummary.build(
    txAsync.value ?? [],
    period,
    DateTime.now(),
    // A transaction on an archived unit has no entry here; it is still the
    // person's money, so only a *known* different currency is excluded.
    include: (t) {
      final unitCurrency = currencyByUnit[t.unitId];
      return unitCurrency == null || unitCurrency == currency;
    },
  );
  return AsyncValue.data(SummaryData(summary: summary, currencyCode: currency));
});
</file>

<file path="lib/ui/providers/widget_providers.dart">
// ---------------------------------------------------------------------------
// Pushing the home-screen widget's snapshot on every data change (issue
// #29). Same shape as bannerSyncProvider: watch the data, act when it
// moves. The widget has no other automatic source of truth besides the
// launcher's 30-minute fallback, so this provider is what makes the
// widget *feel* live.
//
// Deliberately NOT gated on bannerEnabled: the widget and the banner
// have independent lifecycles. Someone who turned the banner off can
// still want a home-screen glance.
// ---------------------------------------------------------------------------

import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/logic/ledger.dart';
import '../../domain/logic/widget_content.dart';
import '../../domain/models/limit_rule.dart';
import '../../platform/widget_bridge.dart';
import 'app_providers.dart';

final homeWidgetBridgeProvider = Provider<HomeWidgetBridge>((ref) {
  return AndroidHomeWidgetBridge();
});

/// Watched from Fuata's build, like bannerSyncProvider and
/// alertSyncProvider — the side effect is the point.
///
/// Deliberately NOT gated on bannerEnabled: the widget and the banner
/// have independent lifecycles. Someone who turned the banner off can
/// still want a home-screen glance.
final widgetSyncProvider = Provider<void>((ref) {
  final units = ref.watch(unitsProvider);
  final transactions = ref.watch(transactionsProvider);
  final limits = ref.watch(limitsProvider);
  final settings = ref.watch(settingsProvider);
  final bridge = ref.watch(homeWidgetBridgeProvider);

  // Wait for every stream: building from half-loaded data would push a
  // widget that disagrees with what the person sees in the app.
  if (units.value == null ||
      transactions.value == null ||
      limits.value == null ||
      settings.value == null) {
    return;
  }

  final s = settings.value!;
  final unitList = units.value!;
  final txList = transactions.value!;

  // A synchronous build rather than the async loader: every input is
  // already in hand, and the async version would open a second DB read
  // just to re-derive what the providers already hold.
  final now = DateTime.now();
  final (start, end) = Ledger.todayRange(now);
  final spentToday = Ledger.spentInPeriod(txList, start, end);

  LimitRule? daily;
  for (final l in limits.value!) {
    if (l.enabled &&
        l.scope == LimitScope.overall &&
        l.period == LimitPeriod.day) {
      daily = l;
      break;
    }
  }

  final currency = unitList.isNotEmpty
      ? unitList.first.currencyCode
      : 'KES';
  final balanceByUnit = {
    for (final u in unitList) u.id: Ledger.balanceOf(u, txList),
  };

  bridge.push(
    WidgetSnapshot.build(
      status: Ledger.statusFor(daily, spentToday),
      spentToday: spentToday,
      dailyLimit: daily,
      currencyCode: currency,
      headline: s.widgetHeadline,
      unitsMode: s.widgetUnitsMode,
      selectedUnitIds: s.widgetUnitIds,
      showProgress: s.widgetShowProgress,
      showSplit: s.widgetShowSplit,
      variant: s.widgetVariant,
      units: unitList,
      balanceByUnit: balanceByUnit,
    ),
  );
});
</file>

<file path="lib/ui/screens/settings/appearance_screen.dart">
import 'package:currency_picker/currency_picker.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../../domain/models/settings.dart';
import '../../../widgets/app_chips.dart';
import '../../../widgets/personalization/action_row.dart';
import '../../../widgets/personalization/section_card.dart';
import '../../providers/app_providers.dart';
import '../../theme/app_colors.dart';
import '../../theme/app_spacing.dart';
import '../../theme/app_typography.dart';


/// Appearance (issue #79, finding F3): light / dark / follow system.
///
/// The accent colour is on the Profile screen, next to the name and
/// avatar — both are "how the app is mine". This screen is only the
/// theme, which is a choice about the phone, not about the person.
class AppearanceScreen extends ConsumerWidget {
  const AppearanceScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final c = context.colors;
    final settings = ref.watch(currentSettingsProvider);
    final repo = ref.read(settingsRepositoryProvider);

    void update(AppSettings Function(AppSettings) fn) {
      repo.updateSettings(fn(settings));
    }

    return Scaffold(
      appBar: AppBar(title: const Text('Appearance')),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.fromLTRB(
            AppSpacing.margin,
            AppSpacing.sm,
            AppSpacing.margin,
            AppSpacing.xl,
          ),
          children: [
            SectionCard(
              title: 'Theme',
              children: [
                Wrap(
                  spacing: AppSpacing.sm,
                  runSpacing: AppSpacing.sm,
                  children: AppThemeMode.values.map((mode) {
                    return AppChoiceChip(
                      label: mode.label,
                      leading: Icon(
                        mode.icon,
                        size: 16,
                        color: settings.themeMode == mode
                            ? c.primary
                            : c.onSurfaceVariant,
                      ),
                      selected: settings.themeMode == mode,
                      onTap: () => update((s) => s.copyWith(themeMode: mode)),
                    );
                  }).toList(),
                ),
              ],
            ),
            const SizedBox(height: AppSpacing.lg),
            SectionCard(
              title: 'Currency',
              children: [
                Text(
                  'Fuata uses one currency everywhere. Changing it changes how every '
                      'amount is shown, including units you already have.',
                  style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
                ),
                const SizedBox(height: AppSpacing.md),
                ActionRow(
                  icon: Icons.attach_money_rounded,
                  title: 'Currency',
                  subtitle: (() {
                    // CurrencyService.findByCode returns Currency? — null when the
                    // stored code isn't in the package's list (an older backup, a
                    // hand-edited file). Fall back to the code itself.
                    final info = CurrencyService().findByCode(settings.currencyCode);
                    return info == null
                        ? settings.currencyCode
                        : '${info.name} (${info.code})';
                  })(),
                  onTap: () {
                    showCurrencyPicker(
                      context: context,
                      showFlag: false,
                      showCurrencyName: true,
                      showCurrencyCode: true,
                      onSelect: (Currency currency) async {
                        final current = ref.read(currentSettingsProvider);
                        if (current.currencyCode == currency.code) return;
                        await ref.read(settingsRepositoryProvider).updateSettings(
                          current.copyWith(currencyCode: currency.code),
                        );
                        // Settings stream emits first (every screen rebuilds with the
                        // new symbol); units follow a beat later. Amounts never change
                        // — only the code and the symbol.
                        await ref
                            .read(unitRepositoryProvider)
                            .updateAllCurrencies(currency.code);
                      },
                    );
                  },
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}
</file>

