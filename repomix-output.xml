<file path="lib/platform/banner.dart">
// ---------------------------------------------------------------------------
// The ongoing status banner (issue #16, US-05, ADR-008).
//
// One notification, one fixed id: every change to the person's money
// updates the same notification rather than stacking a new one per
// event. ADR-008 chose a plain ongoing notification over a foreground
// service — Android starts the capture listener itself, and a foreground
// service just to display a number would be both overkill and
// increasingly restricted on newer Android.
//
// Android ties an app's notification colour to its icon, so status is
// shown with the emoji, a progress bar and the accent-tinted small icon
// — never colour alone (ui-design-brief.md 7.10, requirements.md a11y).
//
// US-06's alerts live on a *separate* Android channel (issue #16 lists
// "separate alert channel"), so muting the banner never silences a
// real nudge.
//
// Nothing in this file logs amounts.
// ---------------------------------------------------------------------------

import 'dart:async';
import 'dart:ui';

import 'package:flutter_local_notifications/flutter_local_notifications.dart';

import '../domain/logic/alert_engine.dart';
import '../domain/logic/banner_content.dart';
import '../domain/models/limit_alert.dart';
import '../domain/models/limit_rule.dart';

/// What the person did with the banner: opened it, or hit + Add (US-07).
enum BannerAction { open, quickAdd }

class BannerPlatform {
  BannerPlatform._();
  static final instance = BannerPlatform._();

  /// Fixed id: the banner is one ongoing notification, updated in place.
  static const bannerId = 1001;

  /// Ongoing status banner. Default importance, not low: MIUI hides a
  /// low-importance channel from the lock screen entirely (design.md
  /// 5.3), and Android locks a channel's importance after creation. The
  /// silence that `Importance.low` used to buy comes from
  /// `onlyAlertOnce` + `playSound: false` + `enableVibration: false` in
  /// `_androidDetails()` instead, which don't affect lock-screen display.
  static const bannerChannelId = 'fuata_banner';
  static const bannerChannelName = 'Status banner';
  static const bannerChannelDescription =
      'The ongoing banner showing how today is going.';

  /// Separate alert channel (issue #16, US-06). Created here so both are
  /// visible in Android's per-app notification settings before either
  /// has ever been posted to.
  static const alertChannelId = 'fuata_alerts';
  static const alertChannelName = 'Limit alerts';
  static const alertChannelDescription =
      'Nudges when you approach or pass a limit.';

  /// Same alerts, delivered during quiet hours (issue #63). Android fixes
  /// a channel's sound and importance when it is created and ignores
  /// per-notification overrides, so "arrive without a buzz" needs its own
  /// low-importance channel rather than a flag on the loud one.
  static const quietAlertChannelId = 'fuata_alerts_quiet';
  static const quietAlertChannelName = 'Limit alerts (quiet hours)';
  static const quietAlertChannelDescription =
      'Limit alerts that arrive during your quiet hours, without sound.';

  final _plugin = FlutterLocalNotificationsPlugin();
  final _actions = StreamController<BannerAction>.broadcast();
  bool _initialised = false;
  bool _permissionAsked = false;

  /// Taps and + Add presses on the banner. Broadcast — safe to listen
  /// late, safe to have no listener at all.
  Stream<BannerAction> get actions => _actions.stream;

  /// Idempotent. The UI isolate and the listener's background isolate
  /// each call this once on their own plugin instance; Android sees the
  /// same notification id either way.
  Future<void> init() async {
    if (_initialised) return;
    const initSettings = InitializationSettings(
      android: AndroidInitializationSettings('@mipmap/ic_launcher'),
    );
    await _plugin.initialize(
      settings: initSettings,
      onDidReceiveNotificationResponse: _onResponse,
    );
    await _createChannels();
    _initialised = true;
  }

  Future<void> _createChannels() async {
    final android = _plugin.resolvePlatformSpecificImplementation<
        AndroidFlutterLocalNotificationsPlugin>();
    if (android == null) return;
    await android.createNotificationChannel(
      const AndroidNotificationChannel(
        bannerChannelId,
        bannerChannelName,
        description: bannerChannelDescription,
        // Was Importance.low. MIUI (and some other OEMs) treat LOW as
        // "silent" and hide silent notifications from the lock screen
        // entirely, regardless of the notification's own visibility flag.
        // Default importance is the lowest MIUI accepts for lock screen.
        importance: Importance.defaultImportance,
      ),
    );
    await android.createNotificationChannel(
      const AndroidNotificationChannel(
        alertChannelId,
        alertChannelName,
        description: alertChannelDescription,
        importance: Importance.high,
      ),
    );
    await android.createNotificationChannel(
      const AndroidNotificationChannel(
        quietAlertChannelId,
        quietAlertChannelName,
        description: quietAlertChannelDescription,
        importance: Importance.low,
        playSound: false,
        enableVibration: false,
      ),
    );
  }

  BannerAction? _pending;

  void _onResponse(NotificationResponse response) {
    final action = response.actionId == 'quick_add'
        ? BannerAction.quickAdd
        : BannerAction.open;
    // Cold start from a banner tap: nobody is listening yet, and a
    // broadcast stream drops un-listened events. Stash it for main.dart
    // to drain after the first frame.
    if (_actions.hasListener) {
      _actions.add(action);
    } else {
      _pending = action;
    }
  }

  /// One-shot read for a cold start: the banner action that launched the
  /// app, if any. Cleared on read.
  BannerAction? consumePendingAction() {
    final a = _pending;
    _pending = null;
    return a;
  }

  /// Post or update the banner. [content] is exactly what the setup
  /// screen's live preview built (BannerContent.build is shared), so the
  /// two can never disagree. [redactOnLockScreen] comes from the
  /// person's `redactedLockScreenBanner` setting.
  Future<void> show(
      BannerContent content, {
        required bool redactOnLockScreen,
      }) async {
    await init();
    await _requestPermissionOnce();
    await _plugin.show(
      id: bannerId,
      title: content.title,
      body: _body(content),
      notificationDetails: NotificationDetails(
        android: _androidDetails(content, redactOnLockScreen),
      ),
    );
  }

  /// Show one limit alert (US-06). Its notification id is derived from the
  /// limit, so a later "almost at your limit" *replaces* the earlier "easy
  /// now" for the same limit instead of stacking beside it. [quiet] posts
  /// it on the silent channel (quiet hours).
  Future<void> showAlert(
      LimitAlert alert, {
        required bool quiet,
        required bool redactOnLockScreen,
      }) async {
    await init();
    await _requestPermissionOnce();
    final text = AlertText.build(alert);
    await _plugin.show(
      id: alertIdFor(alert.limit.id),
      title: text.title,
      body: text.body,
      notificationDetails: NotificationDetails(
        android: AndroidNotificationDetails(
          quiet ? quietAlertChannelId : alertChannelId,
          quiet ? quietAlertChannelName : alertChannelName,
          channelDescription:
          quiet ? quietAlertChannelDescription : alertChannelDescription,
          importance: quiet ? Importance.low : Importance.high,
          priority: quiet ? Priority.low : Priority.high,
          autoCancel: true,
          visibility: redactOnLockScreen
              ? NotificationVisibility.private
              : NotificationVisibility.public,
          icon: '@mipmap/ic_launcher',
          color: _statusColor(alert.level.status),
          styleInformation: BigTextStyleInformation(text.body),
        ),
      ),
    );
  }

  /// Stable across runs and isolates (String.hashCode is not guaranteed
  /// to be), and clear of [bannerId]. FNV-1a, folded into a positive
  /// 31-bit range above 2000.
  static int alertIdFor(String limitId) {
    var h = 0x811c9dc5;
    for (final unit in limitId.codeUnits) {
      h = ((h ^ unit) * 0x01000193) & 0x7fffffff;
    }
    return 2000 + (h % 1000000);
  }

  Future<void> cancel() async {
    await init();
    await _plugin.cancel(id: bannerId);
  }

  /// Ask once per process (Android 13+). No-op on older Androids and
  /// after the first decision, so it never re-prompts.
  Future<void> _requestPermissionOnce() async {
    if (_permissionAsked) return;
    _permissionAsked = true;
    final android = _plugin.resolvePlatformSpecificImplementation<
        AndroidFlutterLocalNotificationsPlugin>();
    await android?.requestNotificationsPermission();
  }

  AndroidNotificationDetails _androidDetails(
      BannerContent content,
      bool redactOnLockScreen,
      ) {
    final progress = content.progress;
    final body = _body(content);

    return AndroidNotificationDetails(
      bannerChannelId,
      bannerChannelName,
      channelDescription: bannerChannelDescription,
      importance: Importance.defaultImportance,
      priority: Priority.defaultPriority,
      // ongoing + autoCancel:false so Android treats it as a status
      // indicator and a tap doesn't silently remove it. On Android 14+
      // a person *can* still dismiss it; the data-driven re-post is what
      // brings it back (design.md ADR-008).
      ongoing: true,
      autoCancel: false,
      playSound: false,
      enableVibration: false,
      onlyAlertOnce: true,
      showWhen: false,
      category: AndroidNotificationCategory.status,
      // private redacts content on a secure lock screen; public shows
      // everything. The banner is always built unredacted — Android
      // does the redaction, not us, so the shade and the lock screen
      // can differ without keeping two BannerContents.
      visibility: redactOnLockScreen
          ? NotificationVisibility.private
          : NotificationVisibility.public,
      // `icon` is the small-icon resource name in
      // flutter_local_notifications (there is no `smallIcon` parameter).
      icon: '@mipmap/ic_launcher',
      color: _statusColor(content.status),
      showProgress: progress != null,
      maxProgress: 100,
      progress: progress == null ? 0 : (progress * 100).round(),
      actions: [
        if (content.showQuickAdd)
          const AndroidNotificationAction(
            'quick_add',
            '+ Add',
            showsUserInterface: true,
            cancelNotification: false,
          ),
        const AndroidNotificationAction(
          'open',
          'Open',
          showsUserInterface: true,
          cancelNotification: false,
        ),
      ],
      styleInformation:
      body.isEmpty ? null : BigTextStyleInformation(body),
    );
  }

  /// Expanded body: the unit split, then the spent-today line. Empty
  /// when the content is redacted — the title alone carries the status.
  String _body(BannerContent content) => [
    if (content.unitLines.isNotEmpty) content.unitLines.join(' · '),
    if (content.spentLine != null) content.spentLine!,
  ].join('\n');

  /// Android takes a single ARGB colour, and this isolate has no access
  /// to AppColors — the theme extension isn't available on the platform
  /// side. These are the same hex values AppColors.light ships (see
  /// lib/ui/theme/app_colors.dart); kept explicit here because the
  /// banner is a platform concern, not a themed widget.
  Color _statusColor(SpendStatus status) => switch (status) {
    SpendStatus.safe => const Color(0xFF2E9E6B),
    SpendStatus.warning => const Color(0xFFE8A317),
    SpendStatus.danger => const Color(0xFFE5533D),
    SpendStatus.overdraft => const Color(0xFFB3123F),
  };
}
</file>

<file path="lib/ui/providers/capture_providers.dart">
// ---------------------------------------------------------------------------
// Capture providers (issues #21, #22): the review inbox's data, the
// CaptureService that turns a shared/pasted message into either a
// pending transaction or an unparsed-capture row, and the notification
// allow-list (#22). The capture logic itself lives in
// domain/logic/capture_pipeline.dart so the notification listener's
// background isolate can run the very same code without Riverpod.
// ---------------------------------------------------------------------------

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_riverpod/legacy.dart';

import '../../data/db/drift_repositories.dart';
import '../../domain/logic/capture_pipeline.dart';
import '../../domain/models/capture_source.dart';
import '../../domain/models/transaction.dart';
import '../../domain/models/unparsed_capture.dart';
import '../../domain/repositories/repositories.dart';
import '../../main.dart';
import '../../platform/notification_capture.dart';
import '../../platform/share_intake.dart';
import '../screens/review_inbox_screen.dart';
import 'app_providers.dart';

// The outcome types moved to the domain layer with the pipeline; re-exported
// so every existing `import capture_providers.dart` keeps compiling.
export '../../domain/logic/capture_pipeline.dart'
    show
    CaptureOutcome,
    Captured,
    CaptureDuplicate,
    CaptureUnparsed,
    CaptureIgnored;

final captureRepositoryProvider = Provider<CaptureRepository>((ref) {
  return DriftCaptureRepository(ref.watch(appDatabaseProvider));
});

/// Everything sitting in the review inbox right now (US-11) — confirmed
/// rows are excluded by definition. Derived from transactionsProvider so
/// Home, Activity and the inbox can never disagree about what exists.
final pendingTransactionsProvider = Provider<List<MoneyTransaction>>((ref) {
  final txs = ref.watch(transactionsProvider).value ?? [];
  return txs.where((t) => !t.isConfirmed).toList()
    ..sort((a, b) => b.occurredAt.compareTo(a.occurredAt));
});

final unparsedCapturesProvider = StreamProvider<List<UnparsedCapture>>((ref) {
  return ref.watch(captureRepositoryProvider).watchUnparsed();
});

// --- Notification allow-list (#22, US-10) -----------------------------

final captureSourceRepositoryProvider = Provider<CaptureSourceRepository>((ref) {
  return DriftCaptureSourceRepository(ref.watch(appDatabaseProvider));
});

/// Every app the person has ever toggled, on or off.
final captureSourcesProvider = StreamProvider<List<CaptureSource>>((ref) {
  return ref.watch(captureSourceRepositoryProvider).watchSources();
});

/// Package names of the *enabled* sources — the allow-list itself.
final allowedPackagesProvider = Provider<Set<String>>((ref) {
  final sources = ref.watch(captureSourcesProvider).value ?? const [];
  return {
    for (final s in sources)
      if (s.enabled) s.packageName,
  };
});

/// Keeps the native listener's copy of the allow-list in step with the
/// database: once when the first value loads (so it is re-sent on every
/// app start) and again on every change. Started once from `Fuata`.
final allowListSyncProvider = Provider<void>((ref) {
  ref.listen<AsyncValue<List<CaptureSource>>>(captureSourcesProvider, (
      _,
      next,
      ) {
    final sources = next.value;
    // Not loaded yet: don't push an empty list that would briefly make
    // the listener discard everything.
    if (sources == null) return;
    setAllowedPackages([
      for (final s in sources)
        if (s.enabled) s.packageName,
    ]);
  }, fireImmediately: true);
});

/// The background isolate writes through its own database connection, so
/// this isolate's drift streams would never hear about a captured
/// notification. Native pings us after each write; we tell drift the
/// affected tables changed so Home, Activity and the inbox refresh.
final captureRefreshProvider = Provider<void>((ref) {
  final db = ref.watch(appDatabaseProvider);
  listenForCaptureChanges(
        () => db.markTablesUpdated([db.transactions, db.unparsedCaptures]),
  );
  ref.onDispose(() => listenForCaptureChanges(null));
});

/// Everything sitting in the review inbox right now: pending captures
/// waiting for a check, plus messages nothing could read yet. One number
/// for the "N caught" nudges on Home and Activity, so those agree with
/// the inbox about how many things are actually in there — an unreadable
/// message is still something the person needs to look at.
final reviewInboxCountProvider = Provider<int>((ref) {
  final pending = ref.watch(pendingTransactionsProvider).length;
  final unparsed = ref.watch(unparsedCapturesProvider).value?.length ?? 0;
  return pending + unparsed;
});

/// Parses a shared/pasted message via the shared [CaptureProcessor]. The
/// processor is built once and kept, so its serial queue also orders a
/// paste and a share that arrive together.
class CaptureService {
  CaptureService(this._ref);
  final Ref _ref;

  late final CaptureProcessor _processor = CaptureProcessor(
    units: _ref.read(unitRepositoryProvider),
    templates: _ref.read(templateRepositoryProvider),
    transactions: _ref.read(transactionRepositoryProvider),
    captures: _ref.read(captureRepositoryProvider),
    sources: _ref.read(captureSourceRepositoryProvider),
    settings: _ref.read(settingsRepositoryProvider),
  );

  Future<CaptureOutcome> capture(
      String text, {
        required TxSource source,
        String sourcePackage = 'shared',
      }) {
    return _processor.capture(
      text,
      source: source,
      sourcePackage: sourcePackage,
    );
  }
}

final captureServiceProvider = Provider<CaptureService>((ref) {
  return CaptureService(ref);
});

// Owns the share-intake subscription for the app's lifetime. RootShell
// used to do this in initState, but its subscription could end up
// orphaned across rebuilds; a keepAlive provider can't be.
final shareIntakeListenerProvider = Provider<void>((ref) {
  final sub = sharedTextStream.listen((text) async {
    final capture = ref.read(captureServiceProvider);
    final outcome = await capture.capture(text, source: TxSource.shared);

    ref.read(reviewInboxNudgeProvider.notifier).state++; // see below
    rootNavigatorKey.currentState?.push(
      MaterialPageRoute(builder: (_) => const ReviewInboxScreen()),
    );
    // Snackbar via a global messenger key so we don't need a BuildContext.
    final msg = rootScaffoldMessengerKey.currentState;
    msg?.showSnackBar(SnackBar(content: Text(_outcomeMessage(outcome))));
  });
  ref.onDispose(sub.cancel);

  // Cold-start stash drain: if a share launched the app before this
  // provider existed, consume it now.
  final pending = consumePendingSharedText();
  if (pending != null) {
    WidgetsBinding.instance.addPostFrameCallback((_) async {
      final capture = ref.read(captureServiceProvider);
      final outcome = await capture.capture(pending, source: TxSource.shared);
      rootNavigatorKey.currentState?.push(
        MaterialPageRoute(builder: (_) => const ReviewInboxScreen()),
      );
      rootScaffoldMessengerKey.currentState?.showSnackBar(
        SnackBar(content: Text(_outcomeMessage(outcome))),
      );
    });
  }
});

String _outcomeMessage(CaptureOutcome outcome) => switch (outcome) {
  Captured(:final autoAccepted) =>
  autoAccepted
      ? 'Caught it — already added to your money.'
      : 'Caught it — waiting for your check.',
  CaptureDuplicate() => 'Already caught that one.',
  CaptureUnparsed() => "Couldn't read that one yet — tap Teach me.",
  CaptureIgnored() => '',
};

// Bumps whenever a capture lands, so Home's "N waiting" nudge refreshes
// even without the transactions stream having to fire.
final reviewInboxNudgeProvider = StateProvider<int>((ref) => 0);
</file>

<file path="lib/ui/screens/limits_screen.dart">
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../domain/models/limit_rule.dart';
import '../../widgets/limits/alert_levels_card.dart';
import '../../widgets/limits/limit_card.dart';
import '../../widgets/limits/quiet_hours_card.dart';
import '../../widgets/limits/unit_limits_section.dart';
import '../../widgets/personalization/section_card.dart';
import '../../widgets/sheets/edit_limit_sheet.dart';
import '../providers/app_providers.dart';
import '../theme/app_colors.dart';
import '../theme/app_spacing.dart';
import '../theme/app_typography.dart';

/// Limits & alerts (issue #15's UI half, ui-design-brief.md 7.8).
///
/// One overall limit per period, each with an on/off switch (#15). Issue
/// #63 completes the rest of 7.8: alert-level sliders, quiet hours, a live
/// banner preview, and per-unit limits under "More".
class LimitsScreen extends ConsumerWidget {
  const LimitsScreen({super.key});

  // Overall limits only — per-unit ones are managed under "More".
  LimitRule? _limitFor(List<LimitRule> limits, LimitPeriod period) => limits
      .where((l) => l.scope == LimitScope.overall && l.period == period)
      .firstOrNull;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final c = context.colors;
    final limits = ref.watch(limitsProvider).value ?? const <LimitRule>[];
    final units = ref.watch(unitsProvider).value ?? const [];

    if (units.isEmpty) {
      return Scaffold(
        appBar: AppBar(title: const Text('Limits & alerts')),
        body: SafeArea(
          child: Center(
            child: Padding(
              padding: const EdgeInsets.all(AppSpacing.xl),
              child: Text(
                'Add some money first — a limit needs something to '
                    'count against.',
                textAlign: TextAlign.center,
                style: AppTypography.bodyMd.copyWith(
                  color: c.onSurfaceVariant,
                ),
              ),
            ),
          ),
        ),
      );
    }

    // v0.1 is effectively single-currency (ADR: overall limits cover
    // units in the limit's currency only). Take it from the first unit.
    final currencyCode = units.first.currencyCode;
    return Scaffold(
      appBar: AppBar(
        title: const Text('Limits & Alerts'),
      ),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.fromLTRB(
            AppSpacing.margin,
            AppSpacing.sm,
            AppSpacing.margin,
            AppSpacing.xl,
          ),
          children: [
            Text(
              "Set how much you'd like to keep to. The banner and Home's "
                  'status ring are built from your daily limit.',
              style: AppTypography.bodySm.copyWith(color: c.onSurfaceVariant),
            ),
            const SizedBox(height: AppSpacing.lg),
            for (final period in LimitPeriod.values) ...[
              LimitCard(
                period: period,
                limit: _limitFor(limits, period),
                currencyCode: currencyCode,
                onTap: () => showEditLimitSheet(
                  period: period,
                  currencyCode: currencyCode,
                  existing: _limitFor(limits, period),
                ),
                onToggle: (on) async {
                  final current = _limitFor(limits, period);
                  if (current == null) {
                    // Turning on a limit that doesn't exist yet: open the
                    // sheet so an amount gets set. You can't enable a
                    // number that isn't there.
                    if (on) {
                      await showEditLimitSheet(
                        period: period,
                        currencyCode: currencyCode,
                      );
                    }
                    return;
                  }
                  await ref
                      .read(limitRepositoryProvider)
                      .setLimit(current.copyWith(enabled: on));
                },
              ),
              const SizedBox(height: AppSpacing.sm),
            ],
            UnitLimitsSection(units: units, limits: limits),
            const SizedBox(height: AppSpacing.md),
            SectionCard(
              title: 'Alerts',
              children: [
                AlertLevelsCard(limits: limits),
                const SizedBox(height: AppSpacing.md),
                const QuietHoursCard(),
              ],
            ),
          ],
        ),
      ),
    );
  }
}
