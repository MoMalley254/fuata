<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/fuata/CaptureChannel.kt">
package com.kinyuanexus.fuata.fuata

import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.os.Handler
import android.os.Looper
import android.util.Log
import android.provider.Settings
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.MethodChannel
import java.util.concurrent.ExecutorService
import java.util.concurrent.Executors

/**
 * `fuata/capture` channel: the UI isolate's line to the capture side
 * (issue #22; replaces the spike's `fuata/listener_spike`).
 *
 * Dart -> native: setCallbackHandle, setAllowedPackages,
 * openNotificationAccessSettings, isNotificationAccessEnabled,
 * listLaunchableApps.
 * Native -> Dart: onCapturesChanged (the background isolate just wrote).
 */
class CaptureChannel(
    private val context: Context,
    messenger: BinaryMessenger,
) {
    private val channel = MethodChannel(messenger, CHANNEL)
    private val io: ExecutorService = Executors.newSingleThreadExecutor()
    private val main = Handler(Looper.getMainLooper())

    private val notifyUi: () -> Unit = {
        Log.d("fuata_capture", "onCapturesChanged → pinging UI")
        channel.invokeMethod("onCapturesChanged", null)
    }

    init {
        channel.setMethodCallHandler { call, result ->
            when (call.method) {
                "setCallbackHandle" -> {
                    CaptureStore.writeCallbackHandle(context, (call.arguments as Number).toLong())
                    result.success(null)
                }

                "setAllowedPackages" -> {
                    val list = (call.arguments as? List<*>)?.filterIsInstance<String>() ?: emptyList()
                    CaptureStore.writeAllowedPackages(context, list)
                    result.success(null)
                }

                "openNotificationAccessSettings" -> {
                    val intent = Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS)
                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                    context.startActivity(intent)
                    result.success(null)
                }

                "isNotificationAccessEnabled" -> result.success(isAccessEnabled())

                "listLaunchableApps" -> {
                    // Loading labels for a hundred-odd apps is slow enough
                    // to jank the UI thread; do it elsewhere and reply on main.
                    io.execute {
                        val apps = launchableApps()
                        main.post { result.success(apps) }
                    }
                }

                else -> result.notImplemented()
            }
        }
        CaptureEngine.onCapturesChanged = notifyUi
    }

    fun dispose() {
        // Only detach if it is still ours: a newer activity may already
        // have installed its own notifier.
        if (CaptureEngine.onCapturesChanged === notifyUi) {
            CaptureEngine.onCapturesChanged = null
        }
        channel.setMethodCallHandler(null)
        io.shutdown()
    }

    /**
     * True when the person has granted Fuata notification access. This is
     * the GRANT — design.md 5.1 documents a device where it was granted
     * but the service never bound. Detecting that is #36.
     */
    private fun isAccessEnabled(): Boolean {
        val flat = Settings.Secure.getString(
            context.contentResolver,
            "enabled_notification_listeners",
        ) ?: return false
        return flat.split(":").any {
            ComponentName.unflattenFromString(it)?.packageName == context.packageName
        }
    }

    /**
     * Launchable apps only (needs the launcher-intent `<queries>` entry in
     * the manifest on Android 11+) — deliberately not QUERY_ALL_PACKAGES,
     * which Play policy restricts and Fuata doesn't need.
     */
    @Suppress("DEPRECATION")
    private fun launchableApps(): List<Map<String, String>> {
        val pm = context.packageManager
        val intent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
        return pm.queryIntentActivities(intent, 0)
            .asSequence()
            .map { it.activityInfo.packageName to it.loadLabel(pm).toString() }
            .filter { (pkg, _) -> pkg != context.packageName }
            .distinctBy { it.first }
            .map { (pkg, label) -> mapOf("packageName" to pkg, "label" to label) }
            .toList()
    }

    companion object {
        const val CHANNEL = "fuata/capture"
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/fuata/CaptureEngine.kt">
package com.kinyuanexus.fuata.fuata

import android.content.Context
import android.os.Handler
import android.os.Looper
import android.util.Log
import io.flutter.FlutterInjector
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.embedding.engine.dart.DartExecutor
import io.flutter.plugin.common.MethodChannel
import io.flutter.view.FlutterCallbackInformation

/**
 * Runs the headless Flutter engine that turns a notification into a
 * transaction (issue #22; replaces the spike's engine-per-notification).
 *
 * One engine, kept alive while notifications keep arriving and torn down
 * after a short idle period:
 *  - notifications that arrive together (an SMS and its push twin) go to
 *    the SAME Dart isolate, which handles them one at a time, so dedupe
 *    can't race itself;
 *  - a burst doesn't pay engine start-up per message;
 *  - nothing is left running when there is nothing to do.
 *
 * Every field below is touched only on the main thread: [submit] hops to
 * it, and MethodChannel callbacks arrive on it.
 *
 * Nothing here logs notification text.
 */

object CaptureEngine {
    private const val TAG = "fuata_capture"
    private const val BG_CHANNEL = "fuata/capture_bg"
    private const val IDLE_TEARDOWN_MS = 20_000L
    private const val WATCHDOG_MS = 90_000L

    private val main = Handler(Looper.getMainLooper())

    private var engine: FlutterEngine? = null
    private var channel: MethodChannel? = null
    private var starting = false
    private var ready = false
    private var inFlight = 0
    private val queue = ArrayDeque<Map<String, String>>()

    /**
     * Set by [CaptureChannel] while a UI engine exists. The background
     * isolate writes through its own database connection, so a running UI
     * never hears about the write on its own — this tells it to re-query.
     */
    @Volatile
    var onCapturesChanged: (() -> Unit)? = null

    /** Idle timeout after the last capture, or a watchdog while one is in flight. */
    private val teardown = Runnable { destroy("idle or watchdog timeout") }

    fun submit(context: Context, packageName: String, text: String) {
        val app = context.applicationContext
        main.post {
            queue.addLast(mapOf("packageName" to packageName, "text" to text))
            when {
                // flush() re-arms the watchdog, replacing any idle timer.
                ready -> flush()
                !starting -> start(app)
                // else: still starting. Leave the start watchdog alone;
                // flush() runs when Dart says it's ready.
            }
        }
    }

    private fun start(context: Context) {
        val handle = CaptureStore.readCallbackHandle(context)
        if (handle == null) {
            // Never registered: the app hasn't been opened since install /
            // update. Dropping is the only option; say so without content.
            Log.w(TAG, "No callback handle registered — open the app once first. Dropped ${queue.size}.")
            queue.clear()
            return
        }

        starting = true
        armTeardown(WATCHDOG_MS) // a start that never completes must not wedge us

        val loader = FlutterInjector.instance().flutterLoader()
        loader.startInitialization(context)
        loader.ensureInitializationCompleteAsync(context, null, main) {
            val callbackInfo = FlutterCallbackInformation.lookupCallbackInformation(handle)
            if (callbackInfo == null) {
                // Stale handle (app updated, not yet reopened).
                Log.e(TAG, "Callback lookup failed for handle $handle — open the app once.")
                destroy("callback lookup failed")
                return@ensureInitializationCompleteAsync
            }

            val eng = FlutterEngine(context)
            val ch = MethodChannel(eng.dartExecutor.binaryMessenger, BG_CHANNEL)
            ch.setMethodCallHandler { call, result ->
                if (call.method == "backgroundIsolateReady" && engine === eng) {
                    starting = false
                    ready = true
                    result.success(null)
                    flush()
                } else {
                    result.notImplemented()
                }
            }
            engine = eng
            channel = ch
            eng.dartExecutor.executeDartCallback(
                DartExecutor.DartCallback(
                    context.assets,
                    loader.findAppBundlePath(),
                    callbackInfo,
                ),
            )
        }
    }

    private fun flush() {
        val ch = channel ?: return
        while (queue.isNotEmpty()) {
            val payload = queue.removeFirst()
            inFlight++
            armTeardown(WATCHDOG_MS)
            ch.invokeMethod(
                "onNotification",
                payload,
                object : MethodChannel.Result {
                    // Dart answers true when it wrote something.
                    override fun success(result: Any?) = finish(result == true)

                    override fun error(code: String, message: String?, details: Any?) {
                        // Code only — a message could echo notification text.
                        Log.e(TAG, "capture failed: $code")
                        finish(false)
                    }

                    override fun notImplemented() = finish(false)
                },
            )
        }
    }

    private fun finish(wrote: Boolean) {
        inFlight = (inFlight - 1).coerceAtLeast(0)
        if (wrote) onCapturesChanged?.invoke()
        if (inFlight == 0 && queue.isEmpty()) armTeardown(IDLE_TEARDOWN_MS)
    }

    private fun armTeardown(delayMs: Long) {
        main.removeCallbacks(teardown)
        main.postDelayed(teardown, delayMs)
    }

    private fun destroy(reason: String) {
        Log.i(TAG, "tearing down capture engine ($reason); dropping ${queue.size} queued")
        main.removeCallbacks(teardown)
        channel?.setMethodCallHandler(null)
        engine?.destroy()
        engine = null
        channel = null
        starting = false
        ready = false
        inFlight = 0
        queue.clear()
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/fuata/CaptureStore.kt">
package com.kinyuanexus.fuata.fuata

import android.content.Context
import android.content.SharedPreferences

/**
 * Small native-side store for the two things the listener service needs
 * when the Dart side is not running (issue #22):
 *
 *  - the Dart callback handle for the background entry point, and
 *  - a mirror of the notification allow-list.
 *
 * The database (capture_sources) stays the source of truth; Dart pushes
 * its enabled rows here via [writeAllowedPackages] on every app start and
 * every change. It exists so a notification from an app the person has
 * NOT allowed can be dropped natively — before a Flutter engine is
 * started and before its text is read into Dart (US-10).
 */
object CaptureStore {
    private const val PREFS = "fuata_capture"
    private const val KEY_HANDLE = "callback_handle"
    private const val KEY_ALLOWED = "allowed_packages"

    fun writeCallbackHandle(context: Context, handle: Long) {
        prefs(context).edit().putLong(KEY_HANDLE, handle).apply()
    }

    fun readCallbackHandle(context: Context): Long? {
        val v = prefs(context).getLong(KEY_HANDLE, -1L)
        return if (v == -1L) null else v
    }

    fun writeAllowedPackages(context: Context, packages: Collection<String>) {
        prefs(context).edit().putStringSet(KEY_ALLOWED, HashSet(packages)).apply()
    }

    /** False for everything until Dart has pushed a list: default is discard. */
    fun isAllowed(context: Context, packageName: String): Boolean {
        val allowed = prefs(context).getStringSet(KEY_ALLOWED, null) ?: return false
        return allowed.contains(packageName)
    }

    private fun prefs(context: Context): SharedPreferences =
        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/fuata/NotificationText.kt">
package com.kinyuanexus.fuata.fuata

import android.app.Notification

/**
 * Pulls the message text out of a notification (issue #22).
 *
 * Fixes the known gap from the #18 spike (design.md 5.1): the spike's
 * text ended up as `sbn.tag` on one device. This walks the notification's
 * own extras in a fixed, documented order and never touches `sbn.tag` or
 * `sbn.key` — those identify the notification, they are not its content.
 *
 * Order (first non-blank wins):
 *  1. EXTRA_BIG_TEXT    — the expanded body; the full message when the
 *                         app supplies one (usually the least truncated)
 *  2. EXTRA_TEXT        — the collapsed body
 *  3. EXTRA_TEXT_LINES  — inbox-style lines, joined with newlines
 *  4. EXTRA_SUB_TEXT    — secondary line
 *  5. tickerText        — legacy one-liner
 *  6. EXTRA_TITLE       — last resort: some apps put the whole message in
 *                         the title. It is NOT prepended to the body, so
 *                         the parser sees the same text a pasted SMS gives.
 *
 * The result is handed to Dart in memory only. It is never logged.
 */
object NotificationText {

    fun extract(notification: Notification): String? {
        val extras = notification.extras
        val candidates = sequenceOf(
            extras?.getCharSequence(Notification.EXTRA_BIG_TEXT),
            extras?.getCharSequence(Notification.EXTRA_TEXT),
            joinLines(extras?.getCharSequenceArray(Notification.EXTRA_TEXT_LINES)),
            extras?.getCharSequence(Notification.EXTRA_SUB_TEXT),
            notification.tickerText,
            extras?.getCharSequence(Notification.EXTRA_TITLE),
        )
        return candidates
            .mapNotNull { it?.toString()?.trim() }
            .firstOrNull { it.isNotEmpty() }
    }

    private fun joinLines(lines: Array<CharSequence>?): CharSequence? {
        if (lines == null || lines.isEmpty()) return null
        return lines.joinToString("\n") { it.toString() }
    }
}
</file>

<file path="android/app/src/main/kotlin/com/kinyuanexus/fuata/fuata/ShareIntake.kt">
package com.kinyuanexus.fuata.fuata

import android.content.Intent
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.MethodChannel

/**
 * `fuata/share_intake` channel: issue #21. Android delivers ACTION_SEND
 * text/plain here (see the manifest's intent-filter); the text is
 * forwarded to Dart, with a small stash so a cold start from another
 * app's share sheet can't lose it before the Dart handler is up.
 */
class ShareIntakeChannel(messenger: BinaryMessenger) {
    private val channel = MethodChannel(messenger, CHANNEL)
    private var pendingSharedText: String? = null

    init {
        channel.setMethodCallHandler { call, result ->
            when (call.method) {
                "getSharedText" -> {
                    result.success(pendingSharedText)
                    pendingSharedText = null
                }
                else -> result.notImplemented()
            }
        }
    }

    /** Route an ACTION_SEND text/plain intent to Dart (stashing if needed). */
    fun handleShareIntent(intent: Intent?) {
        if (intent?.action != Intent.ACTION_SEND) return
        val text = intent.getStringExtra(Intent.EXTRA_TEXT) ?: return

        // Stash first: if the Dart handler isn't registered yet the
        // invoke fails silently, and getSharedText covers that case.
        pendingSharedText = text
        channel.invokeMethod(
            "onSharedText",
            text,
            object : MethodChannel.Result {
                // The Dart handler consumed it — drop the stash so a
                // later getSharedText can't deliver it a second time.
                override fun success(result: Any?) {
                    pendingSharedText = null
                }

                override fun error(
                    errorCode: String,
                    errorMessage: String?,
                    errorDetails: Any?,
                ) {
                }

                override fun notImplemented() {
                }
            },
        )
    }

    companion object {
        const val CHANNEL = "fuata/share_intake"
    }
}
</file>

