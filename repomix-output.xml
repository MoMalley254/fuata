import '../theme/app_colors.dart';
import '../theme/app_spacing.dart';
import '../theme/app_typography.dart';

/// Issue #23 / US-12, ui-design-brief.md 7.11: Day / Week / Month as
/// story-style cards. Simple by default; the numbers sit behind
/// "Show me more".
class SummaryScreen extends ConsumerStatefulWidget {
  final SummaryPeriod initialPeriod;
  const SummaryScreen({super.key, this.initialPeriod = SummaryPeriod.day});

  @override
  ConsumerState<SummaryScreen> createState() => _SummaryScreenState();
}

class _SummaryScreenState extends ConsumerState<SummaryScreen> {
  late SummaryPeriod _period = widget.initialPeriod;

  @override
  Widget build(BuildContext context) {
    final summaryAsync = ref.watch(summaryProvider(_period));
    final units = ref.watch(unitsProvider).value ?? const <MoneyUnit>[];
    final unitById = {for (final u in units) u.id: u};
    final hidden = ref.watch(currentSettingsProvider).amountsHidden;

    return Scaffold(
      appBar: AppBar(title: const Text('Summary')),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.fromLTRB(
            AppSpacing.margin,
            AppSpacing.sm,
            AppSpacing.margin,
            AppSpacing.xl,
          ),
          children: [
            Row(
              children: [
                for (final p in SummaryPeriod.values)
                  Padding(
                    padding: const EdgeInsets.only(right: AppSpacing.sm),
                    child: AppChoiceChip(
                      label: p.label,
                      selected: p == _period,
                      onTap: () => setState(() => _period = p),
                    ),
                  ),
              ],
            ),
            const SizedBox(height: AppSpacing.md),
            ...summaryAsync.when(
              loading: () => const [
                Padding(
                  padding: EdgeInsets.all(AppSpacing.xl),
                  child: Center(child: CircularProgressIndicator.adaptive()),
                ),
              ],
              error: (e, st) => [
                ProviderErrorCard(
                  headline: "Couldn't build this summary",
                  error: e,
                  onRetry: () {
                    ref.invalidate(unitsProvider);
                    ref.invalidate(transactionsProvider);
                  },
                ),
              ],
              data: (data) => _cards(context, data, unitById, hidden),
            ),
          ],
        ),
      ),
    );
  }

  List<Widget> _cards(
    BuildContext context,
    SummaryData data,
    Map<String, MoneyUnit> unitById,
    bool hidden,
  ) {
    final c = context.colors;
    final s = data.summary;
    final cc = data.currencyCode;
    const gap = SizedBox(height: AppSpacing.md);

    return [
      SummaryCard(
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              s.hasActivity ? '🧾' : '🌤️',
              style: const TextStyle(fontSize: 28),
            ),
            const SizedBox(width: AppSpacing.md),
            Expanded(
              child: Text(
                s.story(cc, masked: hidden),
                style: AppTypography.bodyLg.copyWith(color: c.onSurface),
              ),
            ),
          ],
        ),
      ),
      if (s.hasActivity) ...[
        gap,
        SpentGotCard(
          spentMinor: s.spentMinor,
          gotMinor: s.gotMinor,
          currencyCode: cc,
        ),
        gap,
        RankedListCard(
          title: 'Where it went',
          items: s.spentTo,
          currencyCode: cc,
          emptyText: 'Nothing you spent has a name on it yet.',
        ),
        gap,
        RankedListCard(
          title: 'Where it came from',
          items: s.gotFrom,
          currencyCode: cc,
          emptyText: 'Nothing came in ${s.period.thisWord} with a name on it.',
        ),
        if (s.spentByUnit.length > 1) ...[
          gap,
          UnitSplitCard(
            shares: s.spentByUnit,
            unitById: unitById,
            totalMinor: s.spentMinor,
            currencyCode: cc,
          ),
        ],
        if (s.spentByCategory.isNotEmpty) ...[
          gap,
          CategorySplitCard(
            shares: s.spentByCategory,
            allCategories: ref.watch(allCategoriesProvider).value ?? const [],
            currencyCode: cc,
          ),
        ],
        const SizedBox(height: AppSpacing.sm),
        MoreNumbers(summary: s, currencyCode: cc),
      ],
    ];
  }
}
